diff --git a/CMake/Protobuf/Protobuf.cmake b/CMake/Protobuf/Protobuf.cmake
index a475e2c..5eb1887 100644
--- a/CMake/Protobuf/Protobuf.cmake
+++ b/CMake/Protobuf/Protobuf.cmake
@@ -24,8 +24,13 @@ set(propeller_protobuf_version 33.4)
 
 # Declare and configure the external protobuf package.
 include(FetchContent)
+set(propeller_protobuf_url "https://github.com/protocolbuffers/protobuf/releases/download/v${propeller_protobuf_version}/protobuf-${propeller_protobuf_version}.tar.gz")
+if (DEFINED PROPELLER_DEPS_DIR)  # elide-toolchain: offline, sha256-pinned cache
+  set(propeller_protobuf_url "file://${PROPELLER_DEPS_DIR}/protobuf-${propeller_protobuf_version}.tar.gz")
+endif()
 FetchContent_Declare(protobuf
-  URL                         "https://github.com/protocolbuffers/protobuf/releases/download/v${propeller_protobuf_version}/protobuf-${propeller_protobuf_version}.tar.gz"
+  URL                         "${propeller_protobuf_url}"
+  DOWNLOAD_EXTRACT_TIMESTAMP  TRUE
 )
 
 set(protobuf_ABSL_PROVIDER "package" CACHE STRING "" FORCE)
