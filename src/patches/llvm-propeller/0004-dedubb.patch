+// The suffix array by sorting the suffixes themselves.
+std::vector<int32_t> BruteSuffixArray(const std::vector<int32_t>& text) {
+  std::vector<int32_t> sa(text.size());
+  for (size_t i = 0; i < sa.size(); ++i) sa[i] = static_cast<int32_t>(i);
+  std::sort(sa.begin(), sa.end(), [&](int32_t a, int32_t b) {
+    return std::lexicographical_compare(text.begin() + a, text.end(),
+                                        text.begin() + b, text.end());
+  });
+  return sa;
+}
+
+TEST(SuffixArrayTest, MatchesBruteForce) {
+  uint32_t seed = 12345;
+  const auto next = [&seed] {
+    seed = seed * 1103515245u + 12345u;
+    return seed >> 16;
+  };
+  for (int round = 0; round < 200; ++round) {
+    const int32_t alphabet = 1 + static_cast<int32_t>(next() % 5);
+    const size_t length = next() % 40;
+    std::vector<int32_t> text(length);
+    for (int32_t& c : text) c = static_cast<int32_t>(next() % alphabet);
+    const std::vector<int32_t> sa = BuildSuffixArray(text, alphabet);
+    ASSERT_EQ(sa, BruteSuffixArray(text)) << "round " << round;
+    const std::vector<int32_t> lcp = BuildLcpArray(text, sa);
+    for (size_t i = 1; i < sa.size(); ++i) {
+      int32_t h = 0;
+      while (sa[i - 1] + h < static_cast<int32_t>(length) &&
+             sa[i] + h < static_cast<int32_t>(length) &&
+             text[sa[i - 1] + h] == text[sa[i] + h])
+        ++h;
+      ASSERT_EQ(lcp[i], h) << "round " << round << ", rank " << i;
+    }
+  }
+}
+
+TEST(SuffixArrayTest, Banana) {
+  // b a n a n a -> 1 0 2 0 2 0
+  const std::vector<int32_t> text = {1, 0, 2, 0, 2, 0};
+  EXPECT_EQ(BuildSuffixArray(text, 3), (std::vector<int32_t>{5, 3, 1, 0, 4, 2}));
+  EXPECT_EQ(BuildLcpArray(text, BuildSuffixArray(text, 3)),
+            (std::vector<int32_t>{0, 1, 3, 0, 0, 2}));
+}
