+bool IsAliased(const FunctionBbAddrMapPb& function) {
+  return function.function_names_size() > 1;
+}
+
+absl::string_view DirectiveFunctionName(absl::string_view symbol_name) {
+  return symbol_name.substr(0, symbol_name.find(".llvm."));
+}
+
+void SymbolNameIndex::Add(absl::string_view name, uint64_t address,
+                          bool is_function) {
+  if (name.empty()) return;
+  const auto record = [address](absl::flat_hash_map<std::string, uint64_t>& at,
+                                absl::string_view key) {
+    const auto [it, inserted] = at.try_emplace(key, address);
+    if (!inserted && it->second != address) it->second = kSeveral;
+  };
+  record(symbol_at_, name);
+  if (is_function) record(function_at_, DirectiveFunctionName(name));
+}
+
+void SymbolNameIndex::AddSymbols(const llvm::object::ObjectFile& object_file) {
+  const auto* elf =
+      llvm::dyn_cast<llvm::object::ELFObjectFileBase>(&object_file);
+  if (elf == nullptr) return;
+  for (const llvm::object::ELFSymbolRef symbol : elf->symbols()) {
+    const uint8_t type = symbol.getELFType();
+    if (type == llvm::ELF::STT_SECTION || type == llvm::ELF::STT_FILE) continue;
+    llvm::Expected<uint32_t> flags = symbol.getFlags();
+    if (!flags) {
+      llvm::consumeError(flags.takeError());
+      continue;
+    }
+    if (*flags & llvm::object::SymbolRef::SF_Undefined) continue;
+    llvm::Expected<llvm::StringRef> name = symbol.getName();
+    if (!name) {
+      llvm::consumeError(name.takeError());
+      continue;
+    }
+    llvm::Expected<uint64_t> address = symbol.getAddress();
+    if (!address) {
+      llvm::consumeError(address.takeError());
+      continue;
+    }
+    Add(absl::string_view(name->data(), name->size()), *address,
+        type == llvm::ELF::STT_FUNC || type == llvm::ELF::STT_GNU_IFUNC);
+  }
+}
+
+bool SymbolNameIndex::SharesDirectiveName(absl::string_view name,
+                                          uint64_t address) const {
+  const auto it = function_at_.find(DirectiveFunctionName(name));
+  return it == function_at_.end() || it->second != address;
+}
+
+bool SymbolNameIndex::IsShared(absl::string_view name,
+                               uint64_t address) const {
+  const auto it = symbol_at_.find(name);
+  return it != symbol_at_.end() && it->second != address;
+}
+
+int64_t RemoveAmbiguousFunctions(const SymbolNameIndex& names,
+                                 BbAddrMapPb& bb_addr_map) {
+  int64_t removed = 0;
+  for (ModuleBbAddrMapPb& module :
+       *bb_addr_map.mutable_module_bb_addr_maps()) {
+    auto& functions = *module.mutable_function_bb_addr_maps();
+    const auto kept_end = std::remove_if(
+        functions.begin(), functions.end(),
+        [&names](const FunctionBbAddrMapPb& function) {
+          return function.function_names().empty() ||
+                 names.SharesDirectiveName(function.function_names(0),
+                                           function.function_address());
+        });
+    removed += functions.end() - kept_end;
+    functions.erase(kept_end, functions.end());
+  }
+  return removed;
+}
+
+int64_t AddProfileFrequencies(const ProgramCfg& program_cfg,
+                              BbAddrMapPb& bb_addr_map) {
+  absl::flat_hash_map<uint64_t, FunctionBbAddrMapPb*> functions;
+  for (ModuleBbAddrMapPb& module : *bb_addr_map.mutable_module_bb_addr_maps())
+    for (FunctionBbAddrMapPb& function :
+         *module.mutable_function_bb_addr_maps())
+      functions.emplace(function.function_address(), &function);
+
+  int64_t ran = 0;
+  for (const ControlFlowGraph* cfg : program_cfg.GetCfgs()) {
+    if (cfg->nodes().empty()) continue;
+    const auto function_it = functions.find(cfg->GetEntryNode()->addr());
+    if (function_it == functions.end()) continue;
+    absl::flat_hash_map<uint32_t, BbEntryPb*> blocks;
+    for (BbRangePb& range : *function_it->second->mutable_bb_ranges())
+      for (BbEntryPb& block : *range.mutable_bb_entries())
+        blocks.emplace(block.id(), &block);
+    cfg->ForEachNodeRef([&](const CFGNode& node) {
+      const int64_t frequency = node.CalculateFrequency();
+      const auto block_it = blocks.find(node.bb_id());
+      if (frequency <= 0 || block_it == blocks.end()) return;
+      BbEntryPb& block = *block_it->second;
+      block.set_post_link_frequency(
+          std::max(block.post_link_frequency(), frequency));
+      ++ran;
+    });
+  }
+  return ran;
+}
