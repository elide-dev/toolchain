+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "propeller/tail_call_profile_writer.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "gmock/gmock.h"
+#include "gtest/gtest.h"
+#include "propeller/bb_addr_map.pb.h"
+#include "propeller/cfg_edge_kind.h"
+#include "propeller/cfg_testutil.h"
+#include "propeller/program_cfg.h"
+
+namespace propeller {
+namespace {
+
+using ::testing::ElementsAre;
+
+TEST(DirectiveFunctionNameTest, DropsThinLtoSuffix) {
+  EXPECT_EQ(DirectiveFunctionName("foo"), "foo");
+  EXPECT_EQ(DirectiveFunctionName("_ZL3fooi.llvm.1234"), "_ZL3fooi");
+  EXPECT_EQ(DirectiveFunctionName("foo.__uniq.99.llvm.7"), "foo.__uniq.99");
+  EXPECT_EQ(DirectiveFunctionName("foo.cold"), "foo.cold");
+  EXPECT_EQ(DirectiveFunctionName(""), "");
+}
+
+TEST(SymbolNameIndexTest, FunctionNames) {
+  SymbolNameIndex names;
+  names.Add("unique", 0x10, /*is_function=*/true);
+  // Local functions of the same name in two modules, one promoted by ThinLTO.
+  names.Add("_ZL6helperv", 0x20, /*is_function=*/true);
+  names.Add("_ZL6helperv.llvm.42", 0x30, /*is_function=*/true);
+  // Two names at one address (aliases), and a variable of the same name.
+  names.Add("_ZN1AC2Ev", 0x40, /*is_function=*/true);
+  names.Add("_ZN1AC1Ev", 0x40, /*is_function=*/true);
+  names.Add("unique", 0x50, /*is_function=*/false);
+
+  EXPECT_FALSE(names.SharesDirectiveName("unique", 0x10));
+  EXPECT_TRUE(names.SharesDirectiveName("_ZL6helperv", 0x20));
+  EXPECT_TRUE(names.SharesDirectiveName("_ZL6helperv.llvm.42", 0x30));
+  EXPECT_FALSE(names.SharesDirectiveName("_ZN1AC2Ev", 0x40));
+  EXPECT_FALSE(names.SharesDirectiveName("_ZN1AC1Ev", 0x40));
+  // A name no function symbol has, or has elsewhere, cannot be relied on.
+  EXPECT_TRUE(names.SharesDirectiveName("missing", 0x60));
+  EXPECT_TRUE(names.SharesDirectiveName("unique", 0x70));
+}
+
+TEST(SymbolNameIndexTest, CalleeNames) {
+  SymbolNameIndex names;
+  names.Add("callee", 0x10, /*is_function=*/true);
+  names.Add("alias", 0x10, /*is_function=*/true);
+  names.Add("_ZL5localv", 0x20, /*is_function=*/true);
+  names.Add("_ZL5localv", 0x30, /*is_function=*/true);
+  names.Add("table", 0x40, /*is_function=*/false);
+  names.Add("callee2", 0x50, /*is_function=*/true);
+  names.Add("callee2", 0x60, /*is_function=*/false);
+
+  EXPECT_FALSE(names.IsShared("callee", 0x10));
+  EXPECT_FALSE(names.IsShared("alias", 0x10));
+  EXPECT_TRUE(names.IsShared("_ZL5localv", 0x20));
+  EXPECT_TRUE(names.IsShared("_ZL5localv", 0x30));
+  // Any other symbol of the name counts, a variable too.
+  EXPECT_TRUE(names.IsShared("table", 0x70));
+  EXPECT_TRUE(names.IsShared("callee2", 0x50));
+  // Only undefined in the binary (a function another library defines): a
+  // call by name reaches it through the PLT.
+  EXPECT_FALSE(names.IsShared("malloc", 0x80));
+  // Exact names: a ThinLTO suffix makes a name of its own.
+  EXPECT_FALSE(names.IsShared("callee.llvm.1", 0x10));
+}
+
+FunctionBbAddrMapPb* AddFunction(ModuleBbAddrMapPb& module, uint64_t address,
+                                 const std::vector<std::string>& names) {
+  FunctionBbAddrMapPb* function = module.add_function_bb_addr_maps();
+  function->set_function_address(address);
+  for (const std::string& name : names) function->add_function_names(name);
+  return function;
+}
+
+std::vector<std::string> FirstNames(const BbAddrMapPb& bb_addr_map) {
+  std::vector<std::string> out;
+  for (const ModuleBbAddrMapPb& module : bb_addr_map.module_bb_addr_maps())
+    for (const FunctionBbAddrMapPb& function : module.function_bb_addr_maps())
+      out.push_back(function.function_names().empty()
+                        ? std::string("<unnamed>")
+                        : std::string(function.function_names(0)));
+  return out;
+}
+
+TEST(RemoveAmbiguousFunctionsTest, KeepsOnlyFunctionsWithNamesOfTheirOwn) {
+  SymbolNameIndex names;
+  BbAddrMapPb bb_addr_map;
+  ModuleBbAddrMapPb& a = *bb_addr_map.add_module_bb_addr_maps();
+  ModuleBbAddrMapPb& b = *bb_addr_map.add_module_bb_addr_maps();
+  const auto add = [&](ModuleBbAddrMapPb& module, uint64_t address,
+                       const std::vector<std::string>& function_names) {
+    AddFunction(module, address, function_names);
+    for (const std::string& name : function_names)
+      names.Add(name, address, /*is_function=*/true);
+  };
+  add(a, 0x10, {"_ZL6helperv"});
+  add(a, 0x20, {"kept_a"});
+  add(a, 0x30, {"ctor_c2", "ctor_c1"});
+  add(b, 0x40, {"_ZL6helperv"});
+  add(b, 0x50, {"__cxx_global_var_init.llvm.1"});
+  add(b, 0x60, {"__cxx_global_var_init"});
+  add(b, 0x70, {});
+  add(b, 0x80, {"kept_b"});
+
+  EXPECT_EQ(RemoveAmbiguousFunctions(names, bb_addr_map), 5);
+  EXPECT_THAT(FirstNames(bb_addr_map),
+              ElementsAre("kept_a", "ctor_c2", "kept_b"));
+  EXPECT_EQ(bb_addr_map.module_bb_addr_maps(0).function_bb_addr_maps(1)
+                .function_names_size(),
+            2);
+  EXPECT_EQ(bb_addr_map.module_bb_addr_maps(1).function_bb_addr_maps(0)
+                .function_address(),
+            uint64_t{0x80});
+}
+
+std::vector<int64_t> PostLinkFrequencies(const FunctionBbAddrMapPb& function) {
+  std::vector<int64_t> out;
+  for (const BbRangePb& range : function.bb_ranges())
+    for (const BbEntryPb& block : range.bb_entries())
+      out.push_back(block.post_link_frequency());
+  return out;
+}
+
+TEST(AddProfileFrequenciesTest, RaisesTheFrequenciesOfBlocksThatRan) {
+  // In the profile, foo ran from block 0 to block 2 and bar did not run; baz
+  // is not in the map, and qux is not in the profile.
+  ProgramCfg program_cfg(
+      TestCfgBuilder(
+          {.cfg_args = {{".text",
+                         0,
+                         "foo",
+                         {{0x1000, 0, 0x10}, {0x1010, 1, 0x7}, {0x1020, 2, 0xa}},
+                         {{0, 2, 5, CFGEdgeKind::kBranchOrFallthough}}},
+                        {".text", 1, "bar", {{0x2000, 0, 0x20}}, {}},
+                        {".text",
+                         2,
+                         "baz",
+                         {{0x3000, 0, 0x10}, {0x3010, 1, 0x10}},
+                         {{0, 1, 4, CFGEdgeKind::kBranchOrFallthough}}}}})
+          .Build());
+  BbAddrMapPb bb_addr_map;
+  ModuleBbAddrMapPb& module = *bb_addr_map.add_module_bb_addr_maps();
+  FunctionBbAddrMapPb& foo = *AddFunction(module, 0x1000, {"foo"});
+  FunctionBbAddrMapPb& bar = *AddFunction(module, 0x2000, {"bar"});
+  FunctionBbAddrMapPb& qux = *AddFunction(module, 0x4000, {"qux"});
+  for (FunctionBbAddrMapPb* function : {&foo, &bar, &qux}) {
+    BbRangePb& range = *function->add_bb_ranges();
+    for (uint32_t id : {0, 1, 2}) range.add_bb_entries()->set_id(id);
+  }
+  // A higher frequency the binary carries itself is kept.
+  foo.mutable_bb_ranges(0)->mutable_bb_entries(2)->set_post_link_frequency(9);
+
+  EXPECT_EQ(AddProfileFrequencies(program_cfg, bb_addr_map), 2);
+  EXPECT_THAT(PostLinkFrequencies(foo), ElementsAre(5, 0, 9));
+  EXPECT_THAT(PostLinkFrequencies(bar), ElementsAre(0, 0, 0));
+  EXPECT_THAT(PostLinkFrequencies(qux), ElementsAre(0, 0, 0));
+}
+
+}  // namespace
+}  // namespace propeller
