+TEST(FindRepeatedRunsTest, FoldsARunRepeatedAcrossBlocks) {
+  SubsequenceInput input;
+  for (int b = 0; b < 2; ++b) {
+    input.AddBlock("m.cpp", "f" + std::to_string(b), 1, 0x1000 * (b + 1), 0);
+    AddBarrier(input);  // Something before the run...
+    for (uint8_t k : {0x11, 0x22, 0x33, 0x44}) Add(input, k, 4);
+    AddBarrier(input);  // ...and after it.
+  }
+  const SubsequenceResult result = FindRepeatedRuns(input);
+  ASSERT_EQ(result.groups.size(), 1u);
+  const SubsequenceResult::Group& group = result.groups[0];
+  EXPECT_EQ(group.length, 4u);
+  EXPECT_EQ(group.bytes, 16u);
+  EXPECT_FALSE(group.with_calls);
+  // 2 * (16 - 5) - (16 + 1)
+  EXPECT_EQ(group.benefit, 5);
+  EXPECT_EQ(group.starts, (std::vector<uint32_t>{1, 7}));
+  EXPECT_EQ(result.bytes_saved, 5);
+  EXPECT_EQ(result.copies, 2u);
+}
