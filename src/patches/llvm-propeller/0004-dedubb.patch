+TEST(FindRepeatedRunsTest, SaveAndJumpRunsPayForTheirStubAndReturn) {
+  // Only Save-and-Jump may hold the run (it reads a stack slot, say).
+  const SubsequenceResult result = FindRepeatedRuns(
+      SixInstructionRuns(3, [](int) { return kRunSaveAndJump; }));
+  ASSERT_EQ(result.groups.size(), 1u);
+  EXPECT_EQ(result.groups[0].kind, kRunSaveAndJump);
+  // 3 * (24 - 12) - (24 + 3)
+  EXPECT_EQ(result.groups[0].benefit, 9);
+  EXPECT_EQ(result.sj_groups, 1u);
+  EXPECT_EQ(result.sj_copies, 3u);
+  EXPECT_EQ(result.sj_bytes_saved, 9);
+  // Two copies do not pay for it: 2 * (24 - 12) - (24 + 3) < 0.
+  EXPECT_TRUE(FindRepeatedRuns(SixInstructionRuns(2, [](int) {
+                return kRunSaveAndJump;
+              })).groups.empty());
+}
