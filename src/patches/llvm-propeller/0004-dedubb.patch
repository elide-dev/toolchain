+#ifndef PROPELLER_SUBSEQUENCE_DEDUPPER_H_
+#define PROPELLER_SUBSEQUENCE_DEDUPPER_H_
+
+// DeduBB subsequence deduplication core: folds of instruction runs.
+//
+// The block-level folds (tail_call_dedupper.h, save_and_jump_dedupper.h,
+// call_return_dedupper.h) share whole blocks or block bodies. These share any
+// run of consecutive instructions that repeats in the program, and leave the
+// rest of each block where it is.
+//
+// Ranges. Every copy of a run inside a block becomes a stub that runs one
+// master holding the run and comes back right after the stub:
+//
+//   Call-Return    call DeduBB.master.cr.K                  (no call in the run)
+//                  push %rax; call DeduBB.master.cr.K; lea 8(%rsp),%rsp
+//                  master: <run>; ret
+//   Save-and-Jump  lea 1f(%rip),%r11; jmp DeduBB.master.sj.K; 1:
+//                  master: <run>; jmp *%r11
+//
+// A Call-Return master runs with %rsp 8 or 16 bytes lower and may call; a
+// Save-and-Jump master runs in the block's own frame and may not (a call
+// clobbers %r11), so it can read and write the block's stack slots.
+//
+// The program is one string of tokens, one per instruction. Two instructions
+// get the same token if they have the same key (see `SubsequenceInput`), which
+// means that they do the same thing wherever they are. An instruction that no
+// master can run, an instruction whose key occurs once, and the end of every
+// block are barriers: symbols that occur once, so that no repeated substring
+// contains one. The repeated substrings are the intervals of the string's
+// suffix and LCP arrays. Each is costed in bytes for the kinds every copy
+// allows,
+//
+//   copies * (run bytes - stub) - (run bytes + the master's return),
+//
+// and they are taken greedily, largest saving first, without the copies that
+// overlap a run taken before (a lazy greedy: a candidate is costed again when
+// it comes up, and put back if it no longer comes first).
+//
+// Tail-call suffixes. Blocks that end in a return or a tail call can share
+// their last instructions in place: a block that ends like a master block
+// replaces that ending with `jmp DeduBB.master.K`, a label in the master block
+// where the shared ending starts. The jump keeps the block's frame, so the
+// ending may restore registers and pop the frame, which no range may. See
+// `FindTailCallSuffixes`.
+//
+// This header depends only on the C++ standard library, so that it can be
+// unit-tested alone. Which instructions a fold can hold is decided with a
+// disassembler, in tail_call_profile_writer.cc.
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "propeller/tail_call_dedupper.h"
+
+namespace propeller {
+
+// Which kinds of range may hold an instruction (`SubsequenceInput`).
+enum RunKind : uint8_t {
+  kRunCallReturn = 1,
+  kRunSaveAndJump = 2,
+};
+
+// The program's instructions, block after block.
+class SubsequenceInput {
+ public:
+  struct Block {
+    std::string module_name;    // Source module ("" if unknown).
+    std::string function_name;  // Function symbol the block belongs to.
+    uint32_t bb_id = 0;         // BB id within the function (BBAddrMap).
+    uint64_t address = 0;       // Binary address of the block.
+    uint64_t frequency = 0;     // Execution frequency (master selection).
+    uint32_t first_inst = 0;    // Index of its first instruction.
+    uint32_t num_insts = 0;     // Its instructions, branches included.
+  };
+
+  // Starts a block; the instructions added next are its instructions.
+  void AddBlock(const std::string& module_name,
+                const std::string& function_name, uint32_t bb_id,
+                uint64_t address, uint64_t frequency);
+
+  // Appends an instruction of `size` bytes to the last block. `kinds` says
+  // which folds may hold it (`RunKind` bits); it is 0, and `key` empty, for an
+  // instruction that none may. Otherwise `key` is the instruction's bytes,
+  // except that a direct call's or jump's rel32 is replaced by the absolute
+  // target (`direct_call`, see AppendDirectCallToKey), so that equal keys do
+  // the same thing wherever they are. `callee` names a call's or tail jump's
+  // target ('|' between the names of one address, "*" for an indirect call)
+  // and is empty for anything else.
+  void AddInstruction(const std::vector<uint8_t>& key, uint8_t size,
+                      bool direct_call, const std::string& callee,
+                      uint8_t kinds = kRunCallReturn);
+
+  size_t num_instructions() const { return size_.size(); }
+  const std::vector<Block>& blocks() const { return blocks_; }
+
+  // The key of instruction `i`, as added.
+  const uint8_t* key(size_t i) const { return key_bytes_.data() + key_begin_[i]; }
+  size_t key_size(size_t i) const { return key_begin_[i + 1] - key_begin_[i]; }
+  uint8_t size(size_t i) const { return size_[i]; }
+  bool direct_call(size_t i) const { return direct_call_[i] != 0; }
+  uint8_t kinds(size_t i) const { return kinds_[i]; }
+  // The callee of instruction `i` if it is a call, or nullptr.
+  const std::string* callee(size_t i) const {
+    return callee_[i] < 0 ? nullptr : &callee_names_[callee_[i]];
+  }
+
+ private:
+  std::vector<Block> blocks_;
+  std::vector<uint64_t> key_begin_{0};
+  std::vector<uint8_t> key_bytes_;
+  std::vector<uint8_t> size_;
+  std::vector<uint8_t> direct_call_;
+  std::vector<uint8_t> kinds_;
+  std::vector<int32_t> callee_;
+  std::vector<std::string> callee_names_;
+  std::unordered_map<std::string, int32_t> callee_ids_;
+};
+
+struct SubsequenceOptions {
+  // Bytes of a Call-Return stub for a run without calls: `call rel32`.
+  int stub_size = 5;
+  // Bytes of a Call-Return stub for a run with calls: `push %rax` (1) +
+  // `call rel32` (5) + `lea 8(%rsp),%rsp` (5).
+  int stub_size_with_calls = 11;
+  // Bytes a Call-Return master adds besides the run: its `ret`.
+  int master_overhead = 1;
+  // Bytes of a Save-and-Jump stub: `lea 1f(%rip),%r11` (7) + `jmp rel32` (5).
+  int sj_stub_size = 12;
+  // Bytes a Save-and-Jump master adds besides the run: its `jmp *%r11`.
+  int sj_master_overhead = 3;
+  // Minimum number of copies of a run before folding is considered.
+  int min_occurrences = 2;
+  // Fold a run only with copies in the same module (`Block::module_name`).
+  bool intra_module_only = false;
+};
+
+struct SubsequenceResult {
+  // A run folded into one master.
+  struct Group {
+    uint32_t length = 0;      // Instructions in the run.
+    uint32_t bytes = 0;       // The run's size in bytes.
+    bool with_calls = false;  // The run makes calls.
+    RunKind kind = kRunCallReturn;
+    int64_t benefit = 0;      // Bytes saved.
+    // The index of each copy's first instruction, ascending.
+    std::vector<uint32_t> starts;
+  };
+  std::vector<Group> groups;
+
+  uint64_t instructions = 0;       // Instructions in the input.
+  uint64_t runnable = 0;           // Of those, instructions a master can run.
+  uint64_t distinct = 0;           // Distinct keys among them.
+  uint64_t repeated = 0;           // Runnable instructions whose key repeats.
+  uint64_t text_length = 0;        // Tokens and barriers sorted.
+  uint64_t candidates = 0;         // Repeated runs that could save bytes.
+  uint64_t copies = 0;             // Copies folded, over all groups.
+  uint64_t copies_with_calls = 0;  // Of those, copies of runs with calls.
+  uint64_t sj_groups = 0;          // Groups folded with Save-and-Jump.
+  uint64_t sj_copies = 0;          // Copies of those.
+  int64_t bytes_saved = 0;         // Estimated `.text` reduction in bytes.
+  int64_t sj_bytes_saved = 0;      // Of that, by Save-and-Jump groups.
+};
+
+// Finds the runs to fold in `input` (see the comment at the top).
+SubsequenceResult FindRepeatedRuns(const SubsequenceInput& input,
+                                   const SubsequenceOptions& options = {});
+
+// Turns `result` into range directives: Call-Return (`bbmcr`/`bbfcr`) or
+// Save-and-Jump (`bbmsj`/`bbfsj`) ones, by the group's kind, one per copy,
+// with `at=` (the copy's first instruction in its block) and `block_insts=`.
+// Each group's master is its first copy in the order used for the other kinds
+// (hottest, then a function without a ThinLTO `.llvm.` suffix, then the lowest
+// address); its line carries the run's bytes. Masters are numbered from
+// `first_master_id` in that order. The directives come sorted by module,
+// function, block and `at=`. `stub_addresses` receives the sorted, distinct
+// addresses of the blocks holding a copy, and `num_master_modules` the number
+// of modules holding a master.
+std::vector<Directive> MakeSubsequenceDirectives(
+    const SubsequenceInput& input, const SubsequenceResult& result,
+    uint64_t first_master_id, std::vector<uint64_t>& stub_addresses,
+    int& num_master_modules);
+
+// Returns the run of `length` instructions from `start` as written after
+// `body=`: its bytes in hex, with a '.' in place of each direct call.
+std::string FormatSubsequenceBody(const SubsequenceInput& input,
+                                  uint32_t start, uint32_t length);
+
+struct TailCallSuffixOptions {
+  // Bytes of the jump that replaces a folded ending: x86-64 `jmp rel32`.
+  int patch_size = 5;
+  // Fold an ending only with masters in the same module.
+  bool intra_module_only = false;
+};
+
+struct TailCallSuffixResult {
+  // Blocks that share the ending of one master block: the last `length`
+  // instructions of every block in `folds` become a jump to the label at that
+  // many instructions before the end of `master`, which keeps its code.
+  struct Group {
+    uint32_t master = 0;  // Index into `SubsequenceInput::blocks()`.
+    uint32_t length = 0;  // Instructions in the shared ending.
+    uint32_t bytes = 0;   // Its size in bytes.
+    std::vector<uint32_t> folds;  // Indices into `blocks()`.
+    int64_t benefit = 0;          // Bytes saved.
+  };
+  std::vector<Group> groups;
+
+  uint64_t blocks = 0;          // Blocks with an ending that could be shared.
+  uint64_t masters = 0;         // Blocks that keep their code for others.
+  uint64_t folds = 0;           // Endings replaced by a jump.
+  uint64_t whole_blocks = 0;    // Of those, ones that are the whole block.
+  int64_t bytes_saved = 0;      // Estimated `.text` reduction in bytes.
+};
+
+// Finds the tail-call endings to share. `input` holds the blocks that end in a
+// return or a tail call, with every instruction that may be shared in place
+// (kinds != 0); an ending stops at the last instruction that may not. The
+// endings form a trie, read from the end. Deepest shared nodes first, every
+// node that two blocks reach gets a master: the best of its blocks (in the
+// order of the other kinds), unless one below it has one already, which then
+// serves it too. Every other block folds its longest ending that a master
+// also has, if that saves bytes. A master keeps its code and may serve several
+// endings, one label each; a block is never both a master and a fold.
+TailCallSuffixResult FindTailCallSuffixes(
+    const SubsequenceInput& input, const TailCallSuffixOptions& options = {});
+
+// Turns `result` into tail-call directives (`bbm`/`bbf`) with `at=` (the first
+// instruction of the ending in its block) and `block_insts=`: one `bbm` per
+// group for its master's label and one `bbf` per fold, all with the group's
+// `callees=`. Groups are numbered from `first_master_id` in the order of their
+// masters, then by length, longest first. The directives come sorted by
+// module, function, block and `at=`.
+std::vector<Directive> MakeTailCallSuffixDirectives(
+    const SubsequenceInput& input, const TailCallSuffixResult& result,
+    uint64_t first_master_id);
+
+// Exposed for testing. The suffix array of `text`, whose values lie in
+// [0, alphabet): the start of every suffix, in lexicographic order.
+std::vector<int32_t> BuildSuffixArray(const std::vector<int32_t>& text,
+                                      int32_t alphabet);
+
+// Exposed for testing. The LCP array of `text` and its suffix array `sa`:
+// lcp[i] is the length of the common prefix of the suffixes at sa[i - 1] and
+// sa[i], and lcp[0] is 0.
+std::vector<int32_t> BuildLcpArray(const std::vector<int32_t>& text,
+                                   const std::vector<int32_t>& sa);
+
+}  // namespace propeller
