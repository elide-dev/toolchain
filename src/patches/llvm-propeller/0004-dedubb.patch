+// An instruction whose key is `size` copies of `byte`, that the ranges of
+// `kinds` may hold.
+void AddKinds(SubsequenceInput& input, uint8_t byte, uint8_t size,
+              uint8_t kinds) {
+  input.AddInstruction(std::vector<uint8_t>(size, byte), size, false, "",
+                       kinds);
+}
+
+// `copies` blocks holding the same run of six 4-byte instructions between
+// barriers; `kinds_of(b)` gives the kinds of block `b`'s copy.
+template <typename KindsOf>
+SubsequenceInput SixInstructionRuns(int copies, KindsOf kinds_of) {
+  SubsequenceInput input;
+  for (int b = 0; b < copies; ++b) {
+    input.AddBlock("m.cpp", "f" + std::to_string(b), 1, 0x1000 * (b + 1), 0);
+    AddBarrier(input);
+    for (uint8_t k = 0x31; k < 0x37; ++k) AddKinds(input, k, 4, kinds_of(b));
+    AddBarrier(input);
+  }
+  return input;
+}
