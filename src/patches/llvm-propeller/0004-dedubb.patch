+// An instruction whose key is `size` copies of `byte`.
+void Add(SubsequenceInput& input, uint8_t byte, uint8_t size) {
+  input.AddInstruction(std::vector<uint8_t>(size, byte), size, false, "");
+}
+// An instruction no run may hold.
+void AddBarrier(SubsequenceInput& input, uint8_t size = 2) {
+  input.AddInstruction({}, size, false, "");
+}
+// A direct call to `callee`, keyed by its target.
+void AddCall(SubsequenceInput& input, uint64_t target,
+             const std::string& callee) {
+  std::vector<uint8_t> key = {0xe8, 0, 0, 0, 0};
+  std::vector<uint8_t> call_key;
+  AppendDirectCallToKey(call_key, key.data(), key.size(), target);
+  input.AddInstruction(call_key, 5, true, callee);
+}
