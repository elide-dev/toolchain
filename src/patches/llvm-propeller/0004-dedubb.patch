+SaveAndJumpBlock MakeTwoExitBlock(std::string function, uint32_t id,
+                                  uint64_t address, std::vector<uint8_t> body,
+                                  uint32_t jump_size, int condition) {
+  return SaveAndJumpBlock{/*module_name=*/"", std::move(function), id, address,
+                          /*frequency=*/0, std::move(body), jump_size,
+                          condition};
+}
