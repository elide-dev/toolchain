+// A text position that holds a barrier rather than an instruction.
+constexpr uint32_t kBarrier = std::numeric_limits<uint32_t>::max();
+
+// A repeated run: the suffix-array interval [lb, rb] of the suffixes that
+// start with it.
+struct Candidate {
+  int32_t lb = 0;
+  int32_t rb = 0;
+  uint32_t length = 0;  // Instructions.
+  uint32_t bytes = 0;
+  bool with_calls = false;
+};
+
+struct KeyHash {
+  size_t operator()(std::string_view key) const {
+    return static_cast<size_t>(
+        Fnv1aHash(reinterpret_cast<const uint8_t*>(key.data()), key.size()));
+  }
+};
+
+// The order blocks are preferred in as masters, as for the other kinds: the
+// hottest first, then a function without a ThinLTO ".llvm." suffix, then the
+// lowest address.
+bool BlockLess(const SubsequenceInput::Block& x,
+               const SubsequenceInput::Block& y) {
+  if (x.frequency != y.frequency) return x.frequency > y.frequency;
+  const bool x_llvm = x.function_name.find(".llvm.") != std::string::npos;
+  const bool y_llvm = y.function_name.find(".llvm.") != std::string::npos;
+  if (x_llvm != y_llvm) return !x_llvm;
+  return std::tie(x.address, x.module_name, x.function_name, x.bb_id) <
+         std::tie(y.address, y.module_name, y.function_name, y.bb_id);
+}
