+// The blocks of the tail-call suffix tests: each starts with an instruction of
+// its own, `tail` before its ending.
+SubsequenceInput EndingsInput() {
+  SubsequenceInput input;
+  const std::vector<uint8_t> jmp_g = {0xe9, 0, 0, 0, 0, 0, 0x90, 0, 0, 0, 0, 0};
+  const auto add_block = [&](const std::string& f, uint64_t address,
+                             uint8_t own, bool with_p, bool barrier) {
+    input.AddBlock("m.cpp", f, 2, address, 0);
+    AddKinds(input, own, 4, kRunCallReturn);
+    if (barrier) AddBarrier(input);
+    if (with_p) AddKinds(input, 0x50, 4, kRunCallReturn);  // P
+    AddKinds(input, 0x51, 4, kRunCallReturn);              // Q
+    input.AddInstruction(jmp_g, 5, true, "g", kRunCallReturn);  // jmp g
+  };
+  add_block("a", 0x1000, 0xa0, /*with_p=*/true, /*barrier=*/false);
+  add_block("b", 0x2000, 0xb0, /*with_p=*/true, /*barrier=*/false);
+  add_block("c", 0x3000, 0xc0, /*with_p=*/false, /*barrier=*/false);
+  add_block("d", 0x4000, 0xd0, /*with_p=*/false, /*barrier=*/true);
+  return input;
+}
+
+TEST(FindTailCallSuffixesTest, LongestEndingSharedWithAMaster) {
+  const SubsequenceInput input = EndingsInput();
+  const TailCallSuffixResult result = FindTailCallSuffixes(input);
+  // a and b share "P Q jmp g" (13 bytes); c and d share "Q jmp g" (9 bytes)
+  // with them. a, the first by address, keeps its code for both: b folds 13
+  // bytes into it, c and d 9 bytes each.
+  EXPECT_EQ(result.blocks, 4u);
+  EXPECT_EQ(result.masters, 1u);
+  EXPECT_EQ(result.folds, 3u);
+  EXPECT_EQ(result.whole_blocks, 0u);
+  // (13 - 5) + 2 * (9 - 5)
+  EXPECT_EQ(result.bytes_saved, 16);
+  ASSERT_EQ(result.groups.size(), 2u);
+
+  TailCallDedupResult formatted;
+  formatted.directives = MakeTailCallSuffixDirectives(input, result, 3);
+  EXPECT_EQ(FormatDirectives(formatted),
+            "m m.cpp\n"
+            "f a\n"
+            "bbm 2 (DeduBB.master.3) callees=g at=1 block_insts=4\n"
+            "bbm 2 (DeduBB.master.4) callees=g at=2 block_insts=4\n"
+            "f b\n"
+            "bbf 2 (DeduBB.master.3) callees=g at=1 block_insts=4\n"
+            "f c\n"
+            "bbf 2 (DeduBB.master.4) callees=g at=1 block_insts=3\n"
+            "f d\n"
+            "bbf 2 (DeduBB.master.4) callees=g at=2 block_insts=4\n");
+}
+
+TEST(FindTailCallSuffixesTest, WholeBlocksAndTheJumpTheyCost) {
+  SubsequenceInput input;
+  for (int b = 0; b < 3; ++b) {
+    input.AddBlock("m.cpp", "f" + std::to_string(b), 1, 0x1000 * (b + 1), 0);
+    AddKinds(input, 0x61, 3, kRunCallReturn);
+    AddKinds(input, 0x62, 3, kRunCallReturn);
+    AddKinds(input, 0xc3, 3, kRunCallReturn);
+  }
+  // A 4-byte ending would not pay for the 5-byte jump.
+  input.AddBlock("m.cpp", "g0", 1, 0x8000, 0);
+  AddKinds(input, 0x71, 2, kRunCallReturn);
+  AddKinds(input, 0x72, 2, kRunCallReturn);
+  input.AddBlock("m.cpp", "g1", 1, 0x9000, 0);
+  AddKinds(input, 0x71, 2, kRunCallReturn);
+  AddKinds(input, 0x72, 2, kRunCallReturn);
+  const TailCallSuffixResult result = FindTailCallSuffixes(input);
+  ASSERT_EQ(result.groups.size(), 1u);
+  EXPECT_EQ(result.groups[0].master, 0u);
+  EXPECT_EQ(result.groups[0].length, 3u);
+  EXPECT_EQ(result.groups[0].folds, (std::vector<uint32_t>{1, 2}));
+  EXPECT_EQ(result.whole_blocks, 2u);
+  // 2 * (9 - 5)
+  EXPECT_EQ(result.bytes_saved, 8);
+}
+
+TEST(FindTailCallSuffixesTest, HotterBlocksAreMasters) {
+  SubsequenceInput input;
+  for (int b = 0; b < 3; ++b) {
+    input.AddBlock("m.cpp", "f" + std::to_string(b), 1, 0x1000 * (b + 1),
+                   b == 2 ? 100 : 0);
+    AddKinds(input, 0x61, 4, kRunCallReturn);
+    AddKinds(input, 0xc3, 4, kRunCallReturn);
+  }
+  const TailCallSuffixResult result = FindTailCallSuffixes(input);
+  ASSERT_EQ(result.groups.size(), 1u);
+  EXPECT_EQ(result.groups[0].master, 2u);
+  EXPECT_EQ(result.groups[0].folds, (std::vector<uint32_t>{0, 1}));
+}
+
+}  // namespace
+}  // namespace propeller
