+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#ifndef PROPELLER_TAIL_CALL_PROFILE_WRITER_H_
+#define PROPELLER_TAIL_CALL_PROFILE_WRITER_H_
+
+// Binary-facing glue for DeduBB basic-block deduplication ("Step 1").
+//
+// `WriteTailCallDedupProfile` reads the basic blocks of `opts.binary_name()`
+// from its `SHT_LLVM_BB_ADDR_MAP` section, extracts the raw machine bytes of
+// the candidate blocks, runs the FNV-1a + byte-by-byte deduplication (see
+// `tail_call_dedupper.h`, `save_and_jump_dedupper.h` and
+// `call_return_dedupper.h`), and writes the resulting
+// `m`/`f`/`bbm`/`bbf`/`bbmsj`/`bbfsj`/`bbmsj2`/`bbfsj2` directives, and with
+// `opts.dedubb_call_return()` also `bbmcr`/`bbfcr` (for ranges with
+// `opts.dedubb_subsequence()`, see `subsequence_dedupper.h`), to
+// `opts.dedubb_profile_out_name()`.
+//
+// This is a static analysis of the binary: it does not require a perf profile.
+// Block frequencies, from a perf profile (`--profile`) or embedded in the
+// binary (`-pgo-analysis-map`), pick the hottest copy of a duplicate as its
+// master, and with `opts.dedubb_cold_only()` leave the blocks that ran alone.
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "absl/container/flat_hash_map.h"
+#include "absl/status/status.h"
+#include "absl/strings/string_view.h"
+#include "llvm/Object/ObjectFile.h"
+#include "propeller/bb_addr_map.pb.h"
+#include "propeller/binary_content.h"
+#include "propeller/program_cfg.h"
+#include "propeller/propeller_options.pb.h"
+#include "propeller/tail_call_dedupper.h"
+
+namespace propeller {
+
+// The name the compiler looks a function's directives up by: its symbol name
+// up to a ThinLTO ".llvm." suffix (DeduBBDirectives::lookup).
+absl::string_view DirectiveFunctionName(absl::string_view symbol_name);
+
+// The defined symbols of a binary by name, to tell whether a name can mean
+// only one function. The compiler knows functions by name alone: it applies
+// the directives of an `f` line to every function with that directive name,
+// checking only what it can see of each block, and a Call-Return master calls
+// each of its callees by one of the callee's names.
+class SymbolNameIndex {
+ public:
+  // Records a defined symbol; `is_function` for a function (STT_FUNC or
+  // STT_GNU_IFUNC).
+  void Add(absl::string_view name, uint64_t address, bool is_function);
+  // Records every defined symbol of `object_file` but section and file ones.
+  void AddSymbols(const llvm::object::ObjectFile& object_file);
+
+  // True unless the function symbols with `name`'s directive name are all at
+  // `address` (and there is one): a directive for the function there could
+  // also be applied to another function.
+  bool SharesDirectiveName(absl::string_view name, uint64_t address) const;
+  // True if a symbol at an address other than `address` is called `name`: a
+  // call by that name could reach it.
+  bool IsShared(absl::string_view name, uint64_t address) const;
+
+ private:
+  // The address of the symbols with a name, or kSeveral.
+  static constexpr uint64_t kSeveral = ~uint64_t{0};
+  absl::flat_hash_map<std::string, uint64_t> function_at_;  // Directive names.
+  absl::flat_hash_map<std::string, uint64_t> symbol_at_;    // Exact names.
+};
+
+// Removes from `bb_addr_map` the functions that directives could not name
+// unambiguously: those without a name, and those whose first name, which
+// directives use, another function shares
+// (SymbolNameIndex::SharesDirectiveName). Returns how many it removed.
+int64_t RemoveAmbiguousFunctions(const SymbolNameIndex& names,
+                                 BbAddrMapPb& bb_addr_map);
+
+// Raises the `post_link_frequency` of each block in `bb_addr_map` to the
+// frequency `program_cfg`, the CFGs built from a perf profile, gives it.
+// Functions are matched by address, blocks by ID. Returns the number of blocks
+// the profile shows to have run.
+int64_t AddProfileFrequencies(const ProgramCfg& program_cfg,
+                              BbAddrMapPb& bb_addr_map);
+
+// Why x86-64 tail-call candidates were left out, and how many were kept with
+// calls or jumps in their key.
+struct TailCallScanStats {
+  int64_t scanned = 0;
+  int64_t falls_through = 0;     // Conditional tail calls.
+  int64_t rip_relative = 0;      // A %rip-relative operand.
+  int64_t unnamed_target = 0;    // A call or jump to an unnamed address.
+  int64_t caller_sensitive = 0;  // A call that returns twice or that
+                                 // identifies its caller.
+  int64_t decode_error = 0;
+  int64_t with_targets = 0;      // Kept, with calls or jumps to named
+                                 // functions.
+};
+
+// Builds the deduplication candidate blocks (those ending in a tail call or
+// return) from a decoded `BbAddrMapPb`, slicing their raw bytes out of
+// `binary_content`. Exposed for testing. If `cold_only` is true, blocks with a
+// non-zero post-link frequency are skipped. On x86-64 each block is decoded
+// and keyed by the targets it reaches (see `TailCallBlock::key`); blocks
+// that cannot be folded safely are left out and counted in `stats`.
+std::vector<TailCallBlock> BuildTailCallBlocks(
+    const BbAddrMapPb& bb_addr_map, const BinaryContent& binary_content,
+    bool cold_only, bool skip_aliased_functions,
+    TailCallScanStats* stats = nullptr);
+
+// Returns true if more than one symbol name points at `function`: an alias, or
+// functions merged by identical code folding. DeduBB leaves such functions
+// alone by default (`dedubb_skip_aliased_functions`): changing one of the
+// merged copies would stop the linker from merging them again.
+bool IsAliased(const FunctionBbAddrMapPb& function);
+
+// Returns the size in bytes of the jump used to patch a folded block on the
+// binary's architecture (x86: 5, AArch64/ARM: 4).
+int TailCallPatchSize(const BinaryContent& binary_content);
+
+// Runs DeduBB deduplication on `opts.binary_name()` and writes the directive
+// file to `opts.dedubb_profile_out_name()`. A no-op (returns OK) if
+// `dedubb_profile_out_name` is empty. Functions whose name another function
+// shares are left alone (RemoveAmbiguousFunctions), and if a function has no
+// symbol at all (the binary's local symbols were discarded), the file is
+// written with no directives, since any of them could name that function too.
+// `program_cfg`, if not null, holds the CFGs of the perf profile the binary
+// was profiled with (AddProfileFrequencies).
+absl::Status WriteTailCallDedupProfile(const PropellerOptions& opts,
+                                       const ProgramCfg* program_cfg = nullptr);
+
+}  // namespace propeller
+
+#endif  // PROPELLER_TAIL_CALL_PROFILE_WRITER_H_
