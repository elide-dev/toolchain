+// Why a block is not a Save-and-Jump (DeduBB Case III) candidate. These mirror
+// the checks in llvm/lib/CodeGen/DeduBB.cpp that can be decided from machine
+// bytes, so the groups written here are groups the backend actually applies.
+// (The BbAddrMap `edges` come from the PGO analysis map and are empty without
+// one, so they cannot tell a `jcc` block from a single-successor block.)
+enum class SaveAndJumpReject {
+  kNone,
+  kBranch,        // Indirect branch, a second conditional branch, or a branch
+                  // before the end of the block.
+  kCall,          // The callee may clobber %r11 and %r10.
+  kR11,           // Reads or writes %r11, which carries the return address.
+  kR10,           // A two-exit block that reads or writes %r10, which carries
+                  // its second return address.
+  kRipRelative,   // Equal PC-relative bytes at different addresses name
+                  // different targets.
+  kStackPointer,  // Changes %rsp; the master's CFI describes another frame.
+  kSystem,        // syscall, int, ud, hlt.
+  kNoSuccessor,   // An exit is not another block of the same function.
+  kJumpOnly,      // Nothing but branches: no body to share.
+  kDecodeError,
+  kNumReasons,
+};
+
+constexpr std::array<const char*,
+                     static_cast<int>(SaveAndJumpReject::kNumReasons)>
+    kSaveAndJumpRejectNames = {"eligible",     "branch",       "call",
+                               "r11",          "r10",          "rip-relative",
+                               "rsp",          "system",       "no-successor",
+                               "jump-only",    "decode-error"};
+
+struct SaveAndJumpScanStats {
+  int64_t scanned = 0;
+  std::array<int64_t, static_cast<int>(SaveAndJumpReject::kNumReasons)>
+      by_reason{};
+};
+
+struct SaveAndJumpShape {
+  SaveAndJumpReject reject = SaveAndJumpReject::kNone;
+  bool two_exit = false;   // Ends in a conditional branch.
+  int condition = -1;      // That branch's condition code.
+  uint32_t jump_size = 0;  // Bytes of the branches at the end of the block.
+};
+
+// Decodes a block and decides whether it can be folded with Save-and-Jump:
+// straight-line code followed by one of
+//   (no branch)       one exit: the fall-through
+//   jmp T             one exit: T
+//   j<cc> T           two exits: T, or the fall-through
+//   j<cc> T ; jmp F   two exits: T or F
+// where every exit is another block of the same function.
+class SaveAndJumpAnalyzer {
+ public:
+  explicit SaveAndJumpAnalyzer(MiniDisassembler& disassembler)
+      : disassembler_(disassembler),
+        mii_(disassembler.instr_info()),
+        mri_(disassembler.register_info()),
+        r10_(FindRegister("R10")),
+        r11_(FindRegister("R11")),
+        rip_(FindRegister("RIP")),
+        rsp_(FindRegister("RSP")) {}
+
+  bool IsValid() const {
+    return r10_.isValid() && r11_.isValid() && rip_.isValid() &&
+           rsp_.isValid();
+  }
+
+  // Classifies the block `bytes` at `address`. `block_at` maps the start
+  // address of every block of the function to its entry.
+  SaveAndJumpShape Analyze(
+      llvm::ArrayRef<uint8_t> bytes, uint64_t address, bool can_fall_through,
+      const std::unordered_map<uint64_t, const BbEntryPb*>& block_at) const {
+    SaveAndJumpShape shape;
+    std::optional<uint64_t> taken;   // Target of the conditional branch.
+    std::optional<uint64_t> jumped;  // Target of the final `jmp`.
+    bool touches_r10 = false;
+    for (uint64_t offset = 0; offset < bytes.size();) {
+      uint64_t size = 0;
+      absl::StatusOr<llvm::MCInst> inst = disassembler_.DisassembleOne(
+          bytes.drop_front(offset), address + offset, size);
+      if (!inst.ok() || size == 0 || offset + size > bytes.size())
+        return {SaveAndJumpReject::kDecodeError};
+      const llvm::MCInstrDesc& desc = mii_.get(inst->getOpcode());
+      const llvm::StringRef name = mii_.getName(inst->getOpcode());
+      if (desc.isCall()) return {SaveAndJumpReject::kCall};
+      if (desc.mayAffectControlFlow(*inst, mri_)) {
+        // The master replaces the branches with its returns, and every copy
+        // returns to its own targets.
+        uint64_t target = 0;
+        if (!disassembler_.instr_analysis().evaluateBranch(
+                *inst, address + offset, size, target))
+          return {SaveAndJumpReject::kBranch};
+        if (name.starts_with("JCC_") && !shape.two_exit && !jumped &&
+            inst->getNumOperands() == 2 && inst->getOperand(1).isImm()) {
+          shape.two_exit = true;
+          shape.condition = static_cast<int>(inst->getOperand(1).getImm());
+          taken = target;
+        } else if (desc.isUnconditionalBranch() &&
+                   offset + size == bytes.size()) {
+          jumped = target;
+        } else {
+          return {SaveAndJumpReject::kBranch};
+        }
+        shape.jump_size += static_cast<uint32_t>(size);
+      } else {
+        // Straight-line code must come before the branches.
+        if (shape.jump_size > 0) return {SaveAndJumpReject::kBranch};
+        if (desc.isTrap() || name.starts_with("SYSCALL") ||
+            name.starts_with("SYSENTER") || name.starts_with("INT") ||
+            name.starts_with("UD") || name == "HLT")
+          return {SaveAndJumpReject::kSystem};
+        if (Touches(*inst, desc, r11_)) return {SaveAndJumpReject::kR11};
+        if (OperandsOverlap(*inst, 0, inst->getNumOperands(), rip_))
+          return {SaveAndJumpReject::kRipRelative};
+        if (Defines(*inst, desc, rsp_)) return {SaveAndJumpReject::kStackPointer};
+        touches_r10 = touches_r10 || Touches(*inst, desc, r10_);
+      }
+      offset += size;
+    }
+    if (shape.jump_size == bytes.size()) return {SaveAndJumpReject::kJumpOnly};
+    // A two-exit fold passes its second exit in %r10.
+    if (shape.two_exit && touches_r10) return {SaveAndJumpReject::kR10};
+    std::optional<uint64_t> next = jumped;  // The unconditional exit.
+    if (!next.has_value()) {
+      if (!can_fall_through) return {SaveAndJumpReject::kNoSuccessor};
+      next = address + bytes.size();
+    }
+    // Every exit must be another, non-EH-pad block of the same function; a
+    // `jmp` out of the function is a tail call.
+    const auto is_block = [&](uint64_t exit) {
+      const auto it = block_at.find(exit);
+      return exit != address && it != block_at.end() &&
+             !it->second->is_eh_pad();
+    };
+    if (!is_block(*next) ||
+        (shape.two_exit && (!is_block(*taken) || *taken == *next)))
+      return {SaveAndJumpReject::kNoSuccessor};
+    return shape;
+  }
+
+ private:
+  llvm::MCRegister FindRegister(llvm::StringRef name) const {
+    for (unsigned reg = 1, e = mri_.getNumRegs(); reg < e; ++reg)
+      if (name == mri_.getName(reg)) return llvm::MCRegister(reg);
+    return llvm::MCRegister();
+  }
+
+  // True if a register operand in [begin, end) is or overlaps `reg`.
+  bool OperandsOverlap(const llvm::MCInst& inst, unsigned begin, unsigned end,
+                       llvm::MCRegister reg) const {
+    for (unsigned i = begin; i < end && i < inst.getNumOperands(); ++i) {
+      const llvm::MCOperand& op = inst.getOperand(i);
+      if (op.isReg() && op.getReg().isValid() &&
+          mri_.regsOverlap(op.getReg(), reg))
+        return true;
+    }
+    return false;
+  }
+
+  bool ImplicitOverlap(llvm::ArrayRef<llvm::MCPhysReg> regs,
+                       llvm::MCRegister reg) const {
+    for (llvm::MCPhysReg r : regs)
+      if (mri_.regsOverlap(r, reg)) return true;
+    return false;
+  }
+
+  // Reads or writes `reg`, explicitly or implicitly.
+  bool Touches(const llvm::MCInst& inst, const llvm::MCInstrDesc& desc,
+               llvm::MCRegister reg) const {
+    return OperandsOverlap(inst, 0, inst.getNumOperands(), reg) ||
+           ImplicitOverlap(desc.implicit_uses(), reg) ||
+           ImplicitOverlap(desc.implicit_defs(), reg);
+  }
+
+  // Writes `reg`, explicitly or implicitly.
+  bool Defines(const llvm::MCInst& inst, const llvm::MCInstrDesc& desc,
+               llvm::MCRegister reg) const {
+    return OperandsOverlap(inst, 0, desc.getNumDefs(), reg) ||
+           ImplicitOverlap(desc.implicit_defs(), reg);
+  }
+
+  MiniDisassembler& disassembler_;
+  const llvm::MCInstrInfo& mii_;
+  const llvm::MCRegisterInfo& mri_;
+  const llvm::MCRegister r10_;
+  const llvm::MCRegister r11_;
+  const llvm::MCRegister rip_;
+  const llvm::MCRegister rsp_;
+};
+
+// True if the binary is marked for indirect branch tracking: its
+// `.note.gnu.property` sets GNU_PROPERTY_X86_FEATURE_1_IBT, which the linker
+// does only if every input has it. An indirect jump must then land on an
+// `endbr`, which Save-and-Jump's return points do not have.
+bool HasIndirectBranchTracking(const llvm::object::ObjectFile& object_file) {
+  using llvm::support::endian::read32le;
+  const auto align8 = [](size_t n) { return (n + 7) & ~size_t{7}; };
+  for (const llvm::object::SectionRef& section : object_file.sections()) {
+    llvm::Expected<llvm::StringRef> name = section.getName();
+    if (!name) {
+      llvm::consumeError(name.takeError());
+      continue;
+    }
+    if (*name != ".note.gnu.property") continue;
+    llvm::Expected<llvm::StringRef> contents = section.getContents();
+    if (!contents) {
+      llvm::consumeError(contents.takeError());
+      return false;
+    }
+    // Notes of 64-bit ELF: n_namesz, n_descsz, n_type, then the name and the
+    // descriptor, each padded to 8 bytes; the descriptor holds properties,
+    // pr_type and pr_datasz, then pr_data, padded to 8 bytes.
+    const llvm::StringRef data = *contents;
+    for (size_t at = 0; at + 12 <= data.size();) {
+      const uint32_t namesz = read32le(data.data() + at);
+      const uint32_t descsz = read32le(data.data() + at + 4);
+      const uint32_t type = read32le(data.data() + at + 8);
+      const size_t desc = at + 12 + align8(namesz);
+      const size_t next = desc + align8(descsz);
+      if (next > data.size()) break;
+      if (type == llvm::ELF::NT_GNU_PROPERTY_TYPE_0 && namesz == 4 &&
+          data.substr(at + 12, 4) == llvm::StringRef("GNU\0", 4)) {
+        for (size_t p = desc; p + 8 <= desc + descsz;) {
+          const uint32_t pr_type = read32le(data.data() + p);
+          const uint32_t pr_datasz = read32le(data.data() + p + 4);
+          if (pr_type == llvm::ELF::GNU_PROPERTY_X86_FEATURE_1_AND &&
+              pr_datasz >= 4 && p + 12 <= desc + descsz)
+            return read32le(data.data() + p + 8) &
+                   llvm::ELF::GNU_PROPERTY_X86_FEATURE_1_IBT;
+          p += 8 + align8(pr_datasz);
+        }
+      }
+      at = next;
+    }
+  }
+  return false;
+}
+
+// The addresses an operand may hold as an absolute address, which the
+// compiler holds as a symbol and the linker fills in: those of the loaded
+// segments of an executable that is not position independent. None for a
+// position-independent executable or a shared object, whose code holds no
+// absolute address. [begin, end).
+std::pair<uint64_t, uint64_t> AbsoluteAddressRange(
+    const llvm::object::ObjectFile& object_file) {
+  const auto* elf =
+      llvm::dyn_cast<llvm::object::ELF64LEObjectFile>(&object_file);
+  if (elf == nullptr ||
+      elf->getELFFile().getHeader().e_type != llvm::ELF::ET_EXEC)
+    return {0, 0};
+  constexpr std::pair<uint64_t, uint64_t> kAll = {
+      0, std::numeric_limits<uint64_t>::max()};
+  auto headers = elf->getELFFile().program_headers();
+  if (!headers) {
+    llvm::consumeError(headers.takeError());
+    return kAll;
+  }
+  uint64_t begin = std::numeric_limits<uint64_t>::max(), end = 0;
+  for (const auto& header : *headers) {
+    if (header.p_type != llvm::ELF::PT_LOAD) continue;
+    begin = std::min<uint64_t>(begin, header.p_vaddr);
+    end = std::max<uint64_t>(end, header.p_vaddr + header.p_memsz);
+  }
+  return begin < end ? std::make_pair(begin, end) : kAll;
+}
+
+// Size of a Save-and-Jump fold site, or 0 if the backend cannot apply
+// Save-and-Jump on the target. Only x86-64 has link register hooks (%r11,
+// %r10): `leaq Succ(%rip),%r11` (7) + `jmp DeduBB.master.sj.K` (5).
+int SaveAndJumpPatchSize(const BinaryContent& binary_content) {
+  return binary_content.object_file->getArch() == llvm::Triple::x86_64 ? 12
+                                                                         : 0;
+}
+
+// Two-exit Save-and-Jump on x86-64. A fold is `leaq T(%rip),%r11;
+// leaq F(%rip),%r10; jmp DeduBB.master.sj2.K` (7 + 7 + 5). The master grows by
+// the two `leaq` placed in front of it (14) plus `j<cc> 1f; jmp *%r10;
+// 1: jmp *%r11` (2 + 3 + 3), minus its own branches.
+constexpr int kSaveAndJump2PatchSize = 19;
+constexpr int kSaveAndJump2MasterOverhead = 22;
+
+// Save-and-Jump candidates, split by the number of exits.
+struct SaveAndJumpCandidates {
+  std::vector<SaveAndJumpBlock> single_exit;
+  std::vector<SaveAndJumpBlock> two_exit;
+};
+
+// Builds the Save-and-Jump candidates. Each candidate's `bytes` exclude its
+// branches: the master returns through %r11 (and %r10) to whatever blocks the
+// fold names, so only the body, and the branch condition, have to match.
+SaveAndJumpCandidates BuildSaveAndJumpBlocks(
+    const BbAddrMapPb& bb_addr_map, const BinaryContent& binary_content,
+    bool cold_only, bool skip_aliased_functions, SaveAndJumpScanStats& stats) {
+  SaveAndJumpCandidates candidates;
+  absl::StatusOr<std::unique_ptr<MiniDisassembler>> disassembler =
+      MiniDisassembler::Create(binary_content.object_file.get());
+  if (!disassembler.ok()) {
+    LOG(WARNING) << "DeduBB save-and-jump skipped: "
+                 << disassembler.status().message();
+    return candidates;
+  }
+  const SaveAndJumpAnalyzer analyzer(**disassembler);
+  if (!analyzer.IsValid()) {
+    LOG(WARNING) << "DeduBB save-and-jump skipped: R10/R11/RIP/RSP not found";
+    return candidates;
+  }
+  for (const ModuleBbAddrMapPb& module : bb_addr_map.module_bb_addr_maps()) {
+    for (const FunctionBbAddrMapPb& function :
+         module.function_bb_addr_maps()) {
+      if (skip_aliased_functions && IsAliased(function)) continue;
+      const std::string function_name =
+          function.function_names().empty()
+              ? std::string(absl::StrFormat("0x%lx", function.function_address()))
+              : std::string(function.function_names(0));
+      std::unordered_map<uint64_t, const BbEntryPb*> block_at;
+      for (const BbRangePb& bb_range : function.bb_ranges()) {
+        for (const BbEntryPb& bb_entry : bb_range.bb_entries()) {
+          block_at.emplace(bb_range.base_address() + bb_entry.offset(),
+                           &bb_entry);
+        }
+      }
+      for (const BbRangePb& bb_range : function.bb_ranges()) {
+        for (const BbEntryPb& bb_entry : bb_range.bb_entries()) {
+          const uint64_t address = bb_range.base_address() + bb_entry.offset();
+          // Tail-call and return blocks are Case I. The entry block holds the
+          // prologue and cannot host an in-place master.
+          if (bb_entry.has_return() || bb_entry.has_tail_call()) continue;
+          if (address == function.function_address()) continue;
+          if (bb_entry.size() == 0) continue;
+          if (bb_entry.is_eh_pad()) continue;
+          if (cold_only && (bb_entry.post_link_frequency() > 0 || bb_entry.frequency() > 0)) continue;
+
+          ++stats.scanned;
+          SaveAndJumpShape shape;
+          std::vector<uint8_t> bytes;
+          if (bb_entry.has_indirect_branch()) {
+            shape.reject = SaveAndJumpReject::kBranch;
+          } else if (bb_entry.callsites_size() > 0) {
+            shape.reject = SaveAndJumpReject::kCall;
+          } else {
+            absl::StatusOr<std::vector<uint8_t>> block_bytes = GetBlockBytes(
+                *binary_content.object_file, address, bb_entry.size());
+            if (block_bytes.ok()) {
+              bytes = *std::move(block_bytes);
+              shape = analyzer.Analyze(bytes, address,
+                                       bb_entry.can_fall_through(), block_at);
+            } else {
+              LOG(WARNING) << "Skipping block " << function_name << "#"
+                           << bb_entry.id() << ": "
+                           << block_bytes.status().message();
+              shape.reject = SaveAndJumpReject::kDecodeError;
+            }
+          }
+          ++stats.by_reason[static_cast<int>(shape.reject)];
+          if (shape.reject != SaveAndJumpReject::kNone) continue;
+          bytes.resize(bytes.size() - shape.jump_size);
+
+          std::string mod_name = std::string(module.module_name());
+          if (mod_name.empty()) {
+            size_t uniq_pos = function_name.find(".__uniq.");
+            if (uniq_pos != std::string::npos) {
+              mod_name = function_name.substr(uniq_pos + 8);
+            }
+          }
+          (shape.two_exit ? candidates.two_exit : candidates.single_exit)
+              .push_back(SaveAndJumpBlock{mod_name, function_name,
+                                         bb_entry.id(), address,
+                                         std::max(static_cast<uint64_t>(bb_entry.post_link_frequency()), static_cast<uint64_t>(bb_entry.frequency())),
+                                         std::move(bytes), shape.jump_size,
+                                         shape.condition});
+        }
+      }
+    }
+  }
+  return candidates;
+}
+
+std::string FormatRejects(const SaveAndJumpScanStats& stats) {
+  std::string out;
+  for (int i = 1; i < static_cast<int>(SaveAndJumpReject::kNumReasons); ++i) {
+    absl::StrAppendFormat(&out, "%s%s=%d", out.empty() ? "" : ", ",
+                          kSaveAndJumpRejectNames[i], stats.by_reason[i]);
+  }
+  return out;
+}
+
+// Why a block is not a Call-Return candidate. The compiler emits each master
+// from the bytes checked here, and replaces a block only if its own
+// instructions match them (llvm/lib/CodeGen/DeduBBCallReturn.cpp). So these
+// checks decide what the masters do; the compiler's checks only decide which
+// blocks use them. Code the linker rewrites is refused here, since no block's
+// instructions would match it.
+enum class CallReturnReject {
+  kNone,
+  kBranch,          // A branch in the body, or trailing branches that are not
+                    // the jumps a block ends with.
+  kStackPointer,    // Reads or writes %rsp (or the shadow-stack pointer) other
+                    // than as a call's return address: the master runs with
+                    // %rsp 8 or 16 bytes lower.
+  kRipRelative,     // A %rip-relative or absolute address, other than a
+                    // direct call's target.
+  kSystem,          // syscall, int, ud, hlt, endbr, a far call, a call the
+                    // callee identifies by its return address (mcount).
+  kUnresolvedCall,  // A direct call whose target has no function or PLT
+                    // symbol to check the compiler's call against.
+  kAmbiguousCall,   // A direct call to a target with a name that another
+                    // symbol also has: the master, which calls it by name,
+                    // could reach the other.
+  kReturnsTwice,    // Calls setjmp, vfork or the like, which would save the
+                    // master's frame.
+  kTls,             // Addresses memory through %fs or %gs: thread-local
+                    // storage, whose code the linker rewrites (a call to
+                    // __tls_get_addr becomes `mov %fs:0,%rax`).
+  kPrefixedCall,    // A direct call with a prefix, as the linker writes for a
+                    // call through the GOT (`addr32 call`).
+  kRedZone,         // The function keeps data below %rsp (the x86-64 red
+                    // zone), where the stub's `call` writes.
+  kEmpty,           // Nothing but branches: no body to share.
+  kDecodeError,
+  kNumReasons,
+};
+
+constexpr std::array<const char*,
+                     static_cast<int>(CallReturnReject::kNumReasons)>
+    kCallReturnRejectNames = {"eligible",        "branch",
+                              "rsp",             "rip-relative",
+                              "system",          "unresolved-call",
+                              "ambiguous-call",  "returns-twice",
+                              "tls",             "prefixed-call",
+                              "red-zone",        "empty",
+                              "decode-error"};
+
+struct CallReturnScanStats {
+  int64_t scanned = 0;
+  int64_t red_zone_functions = 0;
+  std::array<int64_t, static_cast<int>(CallReturnReject::kNumReasons)>
+      by_reason{};
+};
+
+std::string FormatRejects(const CallReturnScanStats& stats) {
+  std::string out;
+  for (int i = 1; i < static_cast<int>(CallReturnReject::kNumReasons); ++i) {
+    absl::StrAppendFormat(&out, "%s%s=%d", out.empty() ? "" : ", ",
+                          kCallReturnRejectNames[i], stats.by_reason[i]);
+  }
+  return out;
+}
+
+struct DecodedInst {
+  llvm::MCInst inst;
+  uint32_t offset = 0;  // From the start of the block.
+  uint32_t size = 0;
+};
+
+// True if `name` can be written into a directive line as one callee name.
+bool IsPlainSymbolName(llvm::StringRef name) {
+  if (name.empty()) return false;
+  for (char c : name)
+    if (c <= ' ' || c == ',' || c == '|' || c == '(' || c == ')' || c == 0x7f)
+      return false;
+  return true;
+}
+
+// Maps each function start to the names the compiler may call it by: all
+// function symbols at that address, '|'-separated, or the symbol a PLT entry
+// resolves to.
+absl::flat_hash_map<uint64_t, std::string> BuildCalleeNames(
+    const BinaryContent& binary_content, const llvm::MCSubtargetInfo& sti) {
+  absl::flat_hash_map<uint64_t, std::string> names;
+  for (const auto& [address, info] : GetSymbolInfoMap(binary_content)) {
+    std::string joined;
+    bool plain = true;
+    for (llvm::StringRef alias : info.aliases) {
+      plain = plain && IsPlainSymbolName(alias);
+      if (!joined.empty()) joined += '|';
+      joined += alias.str();
+    }
+    if (plain && !joined.empty()) names.emplace(address, std::move(joined));
+  }
+  const auto* elf = llvm::dyn_cast<llvm::object::ELFObjectFileBase>(
+      binary_content.object_file.get());
+  if (elf == nullptr) return names;
+  for (const llvm::object::ELFPltEntry& entry : elf->getPltEntries(sti)) {
+    if (!entry.Symbol.has_value()) continue;
+    llvm::Expected<llvm::StringRef> name =
+        llvm::object::SymbolRef(*entry.Symbol, elf).getName();
+    if (!name) {
+      llvm::consumeError(name.takeError());
+      continue;
+    }
+    if (IsPlainSymbolName(*name)) names.try_emplace(entry.Address, name->str());
+  }
+  return names;
+}
+
+// True if any of the '|'-separated `names` is in `set`.
+bool AnyNameIn(llvm::StringRef names,
+               std::initializer_list<llvm::StringRef> set) {
+  llvm::SmallVector<llvm::StringRef, 4> parts;
+  names.split(parts, '|');
+  for (llvm::StringRef part : parts)
+    for (llvm::StringRef name : set)
+      if (part == name) return true;
+  return false;
+}
+
+// Callees that return twice: a call to one from a master would save the
+// master's frame, which is gone once the master returns.
+bool IsReturnsTwice(llvm::StringRef names) {
+  return AnyNameIn(names, {"setjmp", "_setjmp", "__setjmp", "sigsetjmp",
+                           "__sigsetjmp", "savectx", "vfork", "__vfork",
+                           "getcontext", "__getcontext", "qsetjmp"});
+}
+
+// Callees that identify their caller by the return address: moving the call
+// into a master would attribute it to the master.
+bool IsCallerSensitive(llvm::StringRef names) {
+  if (AnyNameIn(names, {"__fentry__", "mcount", "_mcount", "__mcount",
+                        "__cyg_profile_func_enter", "__cyg_profile_func_exit"}))
+    return true;
+  llvm::SmallVector<llvm::StringRef, 4> parts;
+  names.split(parts, '|');
+  for (llvm::StringRef part : parts)
+    if (part.starts_with("__sanitizer_cov") || part.starts_with("__asan_") ||
+        part.starts_with("__tsan_") || part.starts_with("__msan_") ||
+        part.starts_with("__hwasan_"))
+      return true;
+  return false;
+}
+
+// Functions the compiler reaches through pseudo-instructions (return thunks,
+// retpolines, LVI thunks, the thread-local storage resolver) rather than
+// through a call or jump it can check.
+bool IsThunk(llvm::StringRef names) {
+  if (AnyNameIn(names, {"__tls_get_addr", "___tls_get_addr"})) return true;
+  llvm::SmallVector<llvm::StringRef, 4> parts;
+  names.split(parts, '|');
+  for (llvm::StringRef part : parts)
+    if (part.starts_with("__x86_return_thunk") ||
+        part.starts_with("__x86_indirect_thunk") ||
+        part.starts_with("__x86_indirect_call_thunk") ||
+        part.starts_with("__x86_indirect_jump_thunk") ||
+        part.starts_with("__llvm_retpoline_") ||
+        part.starts_with("__llvm_lvi_thunk_"))
+      return true;
+  return false;
+}
+
+// Rules to relax when estimating what a wider Call-Return could save. No
+// directive is ever written for a block that needed one.
+struct CallReturnRelax {
+  // %rsp as the base of a memory operand: a master would add the stub's push
+  // (8 or 16) to the displacement.
+  bool stack_base = false;
+  // %rip-relative memory operands, grouped by their targets: a master would
+  // need them relocated.
+  bool rip_relative = false;
+};
+
+// Decides whether a block's body can move into a Call-Return master:
+//
+//   <body>                  the master runs this with %rsp 8 (no call in the
+//   <trailing branches>     body) or 16 bytes lower, so it must not touch %rsp
+//                           other than through calls, must not depend on its
+//                           own address, and must not branch.
+//
+// The trailing branches stay in the block, after the stub.
+class CallReturnAnalyzer {
+ public:
+  // `absolute_addresses` is the span of addresses that an operand may hold as
+  // an absolute address (AbsoluteAddressRange).
+  CallReturnAnalyzer(
+      MiniDisassembler& disassembler,
+      const absl::flat_hash_map<uint64_t, std::string>& callee_names,
+      const SymbolNameIndex& symbol_names,
+      std::pair<uint64_t, uint64_t> absolute_addresses = {0, 0})
+      : disassembler_(disassembler),
+        mii_(disassembler.instr_info()),
+        mri_(disassembler.register_info()),
+        callee_names_(callee_names),
+        symbol_names_(symbol_names),
+        absolute_addresses_(absolute_addresses),
+        rip_(FindRegister("RIP")),
+        rsp_(FindRegister("RSP")),
+        ssp_(FindRegister("SSP")),
+        fs_(FindRegister("FS")),
+        gs_(FindRegister("GS")),
+        r11_(FindRegister("R11")) {}
+
+  bool IsValid() const {
+    return rip_.isValid() && rsp_.isValid() && fs_.isValid() &&
+           gs_.isValid() && r11_.isValid();
+  }
+
+  // True if a Save-and-Jump range may hold instruction `decoded`: its master
+  // runs it at another address but in the block's own frame, between the
+  // stub's `lea 1f(%rip),%r11; jmp` and its own `jmp *%r11`. So it must not
+  // call (a call clobbers %r11), branch, touch %r11, depend on its address
+  // (%rip-relative or absolute operands, or thread-local storage the linker
+  // rewrites) or move %rsp; reading and writing stack slots is fine.
+  bool IsSaveAndJumpRunnable(const DecodedInst& decoded) const {
+    const llvm::MCInst& inst = decoded.inst;
+    const llvm::MCInstrDesc& desc = mii_.get(inst.getOpcode());
+    const llvm::StringRef name = mii_.getName(inst.getOpcode());
+    if (IsSystem(desc, name) || IsShadowStack(inst, desc, name)) return false;
+    if (desc.isCall() || desc.mayAffectControlFlow(inst, mri_) ||
+        desc.isBranch() || desc.isIndirectBranch() || desc.isReturn())
+      return false;
+    if (Touches(inst, desc, r11_)) return false;
+    if (OperandsOverlap(inst, rip_) || IsAbsolute(inst) ||
+        UsesTlsSegment(inst))
+      return false;
+    return !Defines(inst, desc, rsp_);
+  }
+
+  // Decides whether instruction `decoded` of a block that ends in a return or
+  // a tail call (`last` if it is the block's last) can be part of an ending
+  // shared in place (a tail-call suffix, see subsequence_dedupper.h). Another
+  // block jumps to it and runs it in its own frame, so only its address may
+  // not matter: no %rip-relative or absolute operand, no thread-local access
+  // (code the linker rewrites, and that the compiler holds as a symbol), and
+  // no branch but the final return or tail jump, which may only jump to a
+  // named function: `callee` receives its names (and `direct` says it is a
+  // direct jump, whose target the compiler checks). No call either: an
+  // exception or a backtrace through it would unwind the block's frame with
+  // the unwind rules of the master's function, which describe that frame only
+  // if both functions address it alike (with a frame pointer or without) and
+  // both have unwind tables. The compiler finds an ending by counting
+  // instructions back from the end, so it must also be one instruction it
+  // emits as one: no no-op padding. And it must reference no symbol other than
+  // the callee, which in a binary that is not position independent rules out
+  // operands that may be absolute addresses: those in `absolute_addresses`.
+  // If it can, appends its key to `key`: its bytes, with a direct jump's
+  // displacement replaced by the absolute target.
+  bool ClassifyTailCallInstruction(const DecodedInst& decoded,
+                                   llvm::ArrayRef<uint8_t> bytes,
+                                   uint64_t address, bool last,
+                                   std::vector<uint8_t>& key,
+                                   std::string& callee, bool& direct) const {
+    const llvm::MCInst& inst = decoded.inst;
+    const llvm::MCInstrDesc& desc = mii_.get(inst.getOpcode());
+    const llvm::StringRef name = mii_.getName(inst.getOpcode());
+    const llvm::ArrayRef<uint8_t> inst_bytes =
+        bytes.slice(decoded.offset, decoded.size);
+    key.clear();
+    callee.clear();
+    direct = false;
+    if (desc.isCall() || IsSystem(desc, name) ||
+        IsShadowStack(inst, desc, name))
+      return false;
+    // No-ops are padding the compiler emits from pseudo-instructions that
+    // stand for several instructions (patchable entries, XRay sleds), and
+    // `lfence` comes from hardening passes that run after DeduBB's (load value
+    // injection rewrites a `ret` into three instructions): where they are, the
+    // compiler could not find an ending's first instruction by counting.
+    if (name.starts_with("NOOP") || name == "LFENCE") return false;
+    if (OperandsOverlap(inst, rip_) || IsAbsolute(inst) ||
+        UsesTlsSegment(inst))
+      return false;
+    const auto [absolute_begin, absolute_end] = absolute_addresses_;
+    for (unsigned i = 0; i < inst.getNumOperands(); ++i) {
+      const llvm::MCOperand& op = inst.getOperand(i);
+      if (op.isImm() &&
+          static_cast<uint64_t>(op.getImm()) - absolute_begin <
+              absolute_end - absolute_begin)
+        return false;
+    }
+    uint64_t target = 0;
+    const bool evaluable = disassembler_.instr_analysis().evaluateBranch(
+        inst, address + decoded.offset, decoded.size, target);
+    // The names a direct jump reaches `target` by, if it is a function the
+    // master may reach from anywhere.
+    const auto named_target = [&]() -> const std::string* {
+      if (!evaluable) return nullptr;
+      const auto it = callee_names_.find(target);
+      if (it == callee_names_.end() || IsReturnsTwice(it->second) ||
+          IsCallerSensitive(it->second) || IsThunk(it->second))
+        return nullptr;
+      return &it->second;
+    };
+    if (desc.mayAffectControlFlow(inst, mri_) || desc.isBranch() ||
+        desc.isIndirectBranch() || desc.isReturn()) {
+      if (!last) return false;
+      if (name == "JMP_1" || name == "JMP_4") {
+        const std::string* names = named_target();
+        if (names == nullptr) return false;
+        const size_t width = name == "JMP_1" ? 1 : 4;
+        if (inst_bytes.size() <= width) return false;
+        key.assign(inst_bytes.begin(), inst_bytes.end() - width);
+        for (int i = 0; i < 8; ++i)
+          key.push_back(static_cast<uint8_t>(target >> (8 * i)));
+        callee = *names;
+        direct = true;
+        return true;
+      }
+      if (name == "JMP64r" || name == "JMP64m" || name == "JMP64r_NT" ||
+          name == "JMP64m_NT" || name == "RET64" || name == "RETI64") {
+        key.assign(inst_bytes.begin(), inst_bytes.end());
+        return true;
+      }
+      return false;
+    }
+    key.assign(inst_bytes.begin(), inst_bytes.end());
+    return true;
+  }
+
+  // Decodes the block `bytes` at `address` into `insts`, one for each
+  // instruction the compiler emits, which is how directives count them. The
+  // disassembler returns some prefixes, such as `lock`, as instructions of
+  // their own: each goes with the instruction it prefixes, whose offset and
+  // size then include it. Returns false on a decode error.
+  bool Decode(llvm::ArrayRef<uint8_t> bytes, uint64_t address,
+              std::vector<DecodedInst>& insts) const {
+    insts.clear();
+    uint64_t start = 0;  // Where the next instruction's prefixes start.
+    for (uint64_t offset = 0; offset < bytes.size();) {
+      uint64_t size = 0;
+      absl::StatusOr<llvm::MCInst> inst = disassembler_.DisassembleOne(
+          bytes.drop_front(offset), address + offset, size);
+      if (!inst.ok() || size == 0 || offset + size > bytes.size()) return false;
+      offset += size;
+      if (mii_.getName(inst->getOpcode()).ends_with("_PREFIX")) continue;
+      insts.push_back({*std::move(inst), static_cast<uint32_t>(start),
+                       static_cast<uint32_t>(offset - start)});
+      start = offset;
+    }
+    return start == bytes.size();  // No prefix without its instruction.
+  }
+
+  // True if instruction `j` of `insts` follows one that addresses memory
+  // through %fs or %gs. The linker rewrites some thread-local accesses, each
+  // of which the compiler emits as one pseudo-instruction, into such an
+  // instruction and the one after it (`mov %fs:0,%rax; lea x@tpoff(%rax),%rax`
+  // for a general-dynamic access), so the compiler may not count that
+  // instruction as one of its own.
+  bool FollowsTlsAccess(const std::vector<DecodedInst>& insts,
+                        size_t j) const {
+    return j > 0 && UsesTlsSegment(insts[j - 1].inst);
+  }
+
+  // True if the code keeps data in the red zone below %rsp: a memory operand,
+  // or an address computed by `lea`, at a negative displacement from %rsp.
+  // The compiler only does this in leaf functions, and the backend's own check
+  // (X86MachineFunctionInfo::getUsesRedZone) is authoritative; this only
+  // keeps such blocks available for Save-and-Jump.
+  bool UsesRedZone(const std::vector<DecodedInst>& insts) const {
+    for (const DecodedInst& decoded : insts) {
+      const llvm::MCInst& inst = decoded.inst;
+      const MemoryReference mem = GetMemoryReference(inst);
+      if (mem.kind == MemoryReference::kBaseIndexDisp && mem.base.isValid() &&
+          mri_.regsOverlap(mem.base, rsp_) && mem.disp < 0)
+        return true;
+    }
+    return false;
+  }
+
+  // Decides whether a master can run instruction `decoded` of the block at
+  // `address` whose bytes are `bytes`, wherever the master is and with %rsp 8
+  // or 16 bytes lower. If it can, appends the instruction's key to `key`: its
+  // bytes, or for a direct call the call without its rel32 and then the
+  // absolute target (`direct_call`). A call's target goes to `callee`: its
+  // names, or "*" for an indirect call. `relax` and `used` are as for Analyze.
+  CallReturnReject ClassifyInstruction(
+      const DecodedInst& decoded, llvm::ArrayRef<uint8_t> bytes,
+      uint64_t address, std::vector<uint8_t>& key, std::string& callee,
+      bool& direct_call, const CallReturnRelax& relax = CallReturnRelax(),
+      CallReturnRelax* used = nullptr) const {
+    const llvm::MCInst& inst = decoded.inst;
+    const llvm::MCInstrDesc& desc = mii_.get(inst.getOpcode());
+    const llvm::StringRef name = mii_.getName(inst.getOpcode());
+    const llvm::ArrayRef<uint8_t> inst_bytes =
+        bytes.slice(decoded.offset, decoded.size);
+    callee.clear();
+    direct_call = false;
+    if (IsSystem(desc, name)) return CallReturnReject::kSystem;
+    if (desc.isCall()) {
+      if (name == "CALL64pcrel32") {
+        // The master calls its target by name, with `call rel32`.
+        if (inst_bytes.size() != 5 || inst_bytes[0] != 0xe8)
+          return CallReturnReject::kPrefixedCall;
+        uint64_t target = 0;
+        if (!disassembler_.instr_analysis().evaluateBranch(
+                inst, address + decoded.offset, decoded.size, target))
+          return CallReturnReject::kDecodeError;
+        const auto it = callee_names_.find(target);
+        if (it == callee_names_.end()) return CallReturnReject::kUnresolvedCall;
+        if (NamesAnotherSymbol(it->second, target))
+          return CallReturnReject::kAmbiguousCall;
+        if (IsReturnsTwice(it->second)) return CallReturnReject::kReturnsTwice;
+        if (IsCallerSensitive(it->second)) return CallReturnReject::kSystem;
+        callee = it->second;
+        direct_call = true;
+        AppendDirectCallToKey(key, inst_bytes.data(), inst_bytes.size(),
+                              target);
+        return CallReturnReject::kNone;
+      }
+      if (name == "CALL64r" || name == "CALL64m" || name == "CALL64r_NT" ||
+          name == "CALL64m_NT") {
+        // Through a register or memory: the address must not depend on
+        // %rsp or %rip either.
+        bool normalized = false;
+        if (OperandsOverlap(inst, rsp_) ||
+            (ssp_.isValid() && OperandsOverlap(inst, ssp_))) {
+          if (!relax.stack_base || !OnlyAsMemoryBase(inst, desc, rsp_))
+            return CallReturnReject::kStackPointer;
+          if (used) used->stack_base = true;
+        }
+        if (OperandsOverlap(inst, rip_) || IsAbsolute(inst)) {
+          if (!relax.rip_relative || IsAbsolute(inst) ||
+              !OnlyAsMemoryBase(inst, desc, rip_) ||
+              !AppendRipTargetToKey(key, inst, address + decoded.offset,
+                                    decoded.size))
+            return CallReturnReject::kRipRelative;
+          if (used) used->rip_relative = true;
+          normalized = true;
+        }
+        if (UsesTlsSegment(inst)) return CallReturnReject::kTls;
+        callee = "*";
+        if (!normalized)
+          key.insert(key.end(), inst_bytes.begin(), inst_bytes.end());
+        return CallReturnReject::kNone;
+      }
+      return CallReturnReject::kSystem;
+    }
+    if (desc.mayAffectControlFlow(inst, mri_) || desc.isBranch() ||
+        desc.isIndirectBranch() || desc.isReturn())
+      return CallReturnReject::kBranch;
+    if (IsShadowStack(inst, desc, name))
+      return CallReturnReject::kStackPointer;
+    if (Touches(inst, desc, rsp_)) {
+      if (!relax.stack_base || !OnlyAsMemoryBase(inst, desc, rsp_))
+        return CallReturnReject::kStackPointer;
+      if (used) used->stack_base = true;
+    }
+    if (OperandsOverlap(inst, rip_) || IsAbsolute(inst)) {
+      if (!relax.rip_relative || IsAbsolute(inst) ||
+          !OnlyAsMemoryBase(inst, desc, rip_) ||
+          !AppendRipTargetToKey(key, inst, address + decoded.offset,
+                                decoded.size))
+        return CallReturnReject::kRipRelative;
+      if (used) used->rip_relative = true;
+      if (UsesTlsSegment(inst)) return CallReturnReject::kTls;
+      return CallReturnReject::kNone;
+    }
+    if (UsesTlsSegment(inst)) return CallReturnReject::kTls;
+    key.insert(key.end(), inst_bytes.begin(), inst_bytes.end());
+    return CallReturnReject::kNone;
+  }
+
+  // Classifies the block `insts` (decoded from `bytes` at `address`) and, if
+  // it qualifies, fills in the key, body size, instruction count and callees
+  // of `block`.
+  // `block_at` maps the start address of every block of the function to its
+  // entry. With `relax`, `used` tells which relaxations the block needed.
+  CallReturnReject Analyze(
+      const std::vector<DecodedInst>& insts, llvm::ArrayRef<uint8_t> bytes,
+      uint64_t address,
+      const std::unordered_map<uint64_t, const BbEntryPb*>& block_at,
+      CallReturnBlock& block,
+      const CallReturnRelax& relax = CallReturnRelax(),
+      CallReturnRelax* used = nullptr) const {
+    // Split off the trailing branches: these stay in the block. They must be
+    // what the compiler ends a block with (conditional jumps, then at most one
+    // jump) so that the body here is the part before the compiler's
+    // terminators.
+    size_t body_end = insts.size();
+    int conditional = 0;
+    bool seen_final = false;
+    while (body_end > 0) {
+      const DecodedInst& decoded = insts[body_end - 1];
+      const llvm::MCInstrDesc& desc = mii_.get(decoded.inst.getOpcode());
+      if (desc.isCall() || !(desc.isBranch() || desc.isIndirectBranch())) break;
+      const llvm::StringRef name = mii_.getName(decoded.inst.getOpcode());
+      const bool is_last = body_end == insts.size();
+      if (name == "JCC_1" || name == "JCC_4") {
+        if (++conditional > 2) return CallReturnReject::kBranch;
+      } else if (name == "JMP_1" || name == "JMP_4" || name == "JMP64r" ||
+                 name == "JMP64m" || name == "JMP64r_NT" ||
+                 name == "JMP64m_NT") {
+        if (!is_last || seen_final) return CallReturnReject::kBranch;
+        seen_final = true;
+      } else {
+        return CallReturnReject::kBranch;
+      }
+      // A direct jump must land on the start of a block of this function; a
+      // jump elsewhere is a tail call or a jump into the middle of a block.
+      uint64_t target = 0;
+      if (disassembler_.instr_analysis().evaluateBranch(
+              decoded.inst, address + decoded.offset, decoded.size, target)) {
+        const auto it = block_at.find(target);
+        if (it == block_at.end() || it->second->is_eh_pad())
+          return CallReturnReject::kBranch;
+      } else if (!desc.isIndirectBranch()) {
+        return CallReturnReject::kBranch;
+      }
+      --body_end;
+    }
+    if (body_end == 0) return CallReturnReject::kEmpty;
+
+    block.key.clear();
+    block.callees.clear();
+    block.call_key_offsets.clear();
+    for (size_t i = 0; i < body_end; ++i) {
+      const uint32_t key_offset = static_cast<uint32_t>(block.key.size());
+      std::string callee;
+      bool direct_call = false;
+      const CallReturnReject reject =
+          ClassifyInstruction(insts[i], bytes, address, block.key, callee,
+                              direct_call, relax, used);
+      if (reject != CallReturnReject::kNone) return reject;
+      if (!callee.empty()) block.callees.push_back(std::move(callee));
+      if (direct_call) block.call_key_offsets.push_back(key_offset);
+    }
+    block.body_size = insts[body_end - 1].offset + insts[body_end - 1].size;
+    block.inst_count = static_cast<uint32_t>(body_end);
+    return CallReturnReject::kNone;
+  }
+
+ private:
+  // A decoded memory reference: `seg:disp(base,index,scale)`, or an absolute
+  // `seg:disp` (the moffs forms of `mov`).
+  struct MemoryReference {
+    enum Kind { kNone, kBaseIndexDisp, kOffset, kOther } kind = kNone;
+    llvm::MCRegister base;
+    llvm::MCRegister index;
+    llvm::MCRegister segment;
+    int64_t disp = 0;
+  };
+
+  // Returns the index of the first operand of `inst`'s memory reference, or
+  // -1 if it has none.
+  int MemoryOperandStart(const llvm::MCInst& inst) const {
+    const llvm::MCInstrDesc& desc = mii_.get(inst.getOpcode());
+    const llvm::StringRef name = mii_.getName(inst.getOpcode());
+    // `lea`'s address operand is not typed as memory.
+    if (name.starts_with("LEA16r") || name.starts_with("LEA32r") ||
+        name.starts_with("LEA64r") || name.starts_with("LEA64_32r"))
+      return 1;
+    for (unsigned i = 0; i < desc.getNumOperands(); ++i)
+      if (desc.operands()[i].OperandType == llvm::MCOI::OPERAND_MEMORY)
+        return static_cast<int>(i);
+    return -1;
+  }
+
+  MemoryReference GetMemoryReference(const llvm::MCInst& inst) const {
+    MemoryReference mem;
+    const int start = MemoryOperandStart(inst);
+    if (start < 0) return mem;
+    const unsigned n = inst.getNumOperands();
+    const auto op = [&](unsigned i) -> const llvm::MCOperand& {
+      return inst.getOperand(i);
+    };
+    const unsigned s = static_cast<unsigned>(start);
+    if (s + 4 < n && op(s).isReg() && op(s + 1).isImm() && op(s + 2).isReg() &&
+        op(s + 4).isReg()) {
+      mem.kind = MemoryReference::kBaseIndexDisp;
+      mem.base = op(s).getReg();
+      mem.index = op(s + 2).getReg();
+      mem.segment = op(s + 4).getReg();
+      if (op(s + 3).isImm())
+        mem.disp = op(s + 3).getImm();
+      else
+        mem.kind = MemoryReference::kOther;
+      return mem;
+    }
+    if (s + 1 < n && op(s).isImm() && op(s + 1).isReg()) {
+      mem.kind = MemoryReference::kOffset;
+      mem.disp = op(s).getImm();
+      mem.segment = op(s + 1).getReg();
+      return mem;
+    }
+    // String instructions address through %rsi/%rdi.
+    if (op(s).isReg()) return mem;
+    mem.kind = MemoryReference::kOther;
+    return mem;
+  }
+
+  // True if `reg` appears in `inst` only as the base register of its memory
+  // operand (or of the address `lea` computes), not implicitly, not written.
+  bool OnlyAsMemoryBase(const llvm::MCInst& inst, const llvm::MCInstrDesc& desc,
+                        llvm::MCRegister reg) const {
+    for (llvm::MCPhysReg r : desc.implicit_uses())
+      if (mri_.regsOverlap(r, reg)) return false;
+    for (llvm::MCPhysReg r : desc.implicit_defs())
+      if (mri_.regsOverlap(r, reg)) return false;
+    const int start = MemoryOperandStart(inst);
+    if (start < 0 ||
+        GetMemoryReference(inst).kind != MemoryReference::kBaseIndexDisp)
+      return false;
+    for (unsigned i = 0; i < inst.getNumOperands(); ++i) {
+      const llvm::MCOperand& op = inst.getOperand(i);
+      if (op.isReg() && op.getReg().isValid() &&
+          mri_.regsOverlap(op.getReg(), reg) && static_cast<int>(i) != start)
+        return false;
+    }
+    return true;
+  }
+
+  // Appends a %rip-relative instruction to a key by its opcode and operands,
+  // with the displacement replaced by the absolute target, so the same access
+  // from another place gives the same key.
+  bool AppendRipTargetToKey(std::vector<uint8_t>& key, const llvm::MCInst& inst,
+                            uint64_t address, uint64_t size) const {
+    const int start = MemoryOperandStart(inst);
+    if (start < 0) return false;
+    const std::optional<uint64_t> target =
+        disassembler_.instr_analysis().evaluateMemoryOperandAddress(
+            inst, &disassembler_.subtarget_info(), address, size);
+    if (!target.has_value()) return false;
+    const auto append64 = [&key](uint64_t v) {
+      for (int i = 0; i < 8; ++i) key.push_back(static_cast<uint8_t>(v >> (8 * i)));
+    };
+    key.push_back(0xf1);  // No body starts with `int1`: it is rejected.
+    append64(inst.getOpcode());
+    for (unsigned i = 0; i < inst.getNumOperands(); ++i) {
+      const llvm::MCOperand& op = inst.getOperand(i);
+      if (static_cast<int>(i) == start + 3) {
+        append64(*target);
+      } else if (op.isReg()) {
+        append64(op.getReg().id());
+      } else if (op.isImm()) {
+        append64(static_cast<uint64_t>(op.getImm()));
+      } else {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  // True if the instruction addresses memory through %fs or %gs.
+  bool UsesTlsSegment(const llvm::MCInst& inst) const {
+    const MemoryReference mem = GetMemoryReference(inst);
+    return mem.segment.isValid() && (mri_.regsOverlap(mem.segment, fs_) ||
+                                     mri_.regsOverlap(mem.segment, gs_));
+  }
+
+  // True if the instruction addresses memory by an absolute address, which is
+  // only position independent in a non-PIC binary: no base register and no
+  // segment override.
+  bool IsAbsolute(const llvm::MCInst& inst) const {
+    const MemoryReference mem = GetMemoryReference(inst);
+    switch (mem.kind) {
+      case MemoryReference::kNone:
+        return false;
+      case MemoryReference::kBaseIndexDisp:
+        return !mem.base.isValid() && !mem.segment.isValid();
+      case MemoryReference::kOffset:
+        return !mem.segment.isValid();
+      case MemoryReference::kOther:
+        return true;
+    }
+    return true;
+  }
+
+  static bool IsSystem(const llvm::MCInstrDesc& desc, llvm::StringRef name) {
+    return desc.isTrap() || name.starts_with("SYSCALL") ||
+           name.starts_with("SYSENTER") || name.starts_with("SYSEXIT") ||
+           name.starts_with("SYSRET") || name.starts_with("INT") ||
+           name.starts_with("UD") || name == "TRAP" || name == "HLT" ||
+           name.starts_with("ENDBR") || name.starts_with("IRET") ||
+           name == "VMCALL" || name == "VMMCALL" || name == "VMLAUNCH" ||
+           name == "VMRESUME" || name.starts_with("VMRUN") ||
+           name == "VMFUNC" || name.starts_with("ENCL") ||
+           name == "TDCALL" || name.starts_with("SEAM") ||
+           name == "UIRET" || name.starts_with("XBEGIN") ||
+           name.starts_with("XABORT") || name.starts_with("FAR");
+  }
+
+  llvm::MCRegister FindRegister(llvm::StringRef name) const {
+    for (unsigned reg = 1, e = mri_.getNumRegs(); reg < e; ++reg)
+      if (name == mri_.getName(reg)) return llvm::MCRegister(reg);
+    return llvm::MCRegister();
+  }
+
+  // True if the instruction reads or writes the shadow-stack pointer.
+  bool IsShadowStack(const llvm::MCInst& inst, const llvm::MCInstrDesc& desc,
+                     llvm::StringRef name) const {
+    return (ssp_.isValid() && Touches(inst, desc, ssp_)) ||
+           name.starts_with("RDSSP") || name.starts_with("INCSSP") ||
+           name.starts_with("SAVEPREVSSP") || name.starts_with("RSTORSSP") ||
+           name.starts_with("WRSS") || name.starts_with("WRUSS") ||
+           name.starts_with("SETSSBSY") || name.starts_with("CLRSSBSY");
+  }
+
+  // Writes `reg`, explicitly or implicitly.
+  bool Defines(const llvm::MCInst& inst, const llvm::MCInstrDesc& desc,
+               llvm::MCRegister reg) const {
+    for (unsigned i = 0; i < desc.getNumDefs() && i < inst.getNumOperands();
+         ++i) {
+      const llvm::MCOperand& op = inst.getOperand(i);
+      if (op.isReg() && op.getReg().isValid() &&
+          mri_.regsOverlap(op.getReg(), reg))
+        return true;
+    }
+    for (llvm::MCPhysReg r : desc.implicit_defs())
+      if (mri_.regsOverlap(r, reg)) return true;
+    return false;
+  }
+
+  // True if a symbol at an address other than `target` has one of the
+  // '|'-separated `names` of a callee at `target`.
+  bool NamesAnotherSymbol(llvm::StringRef names, uint64_t target) const {
+    llvm::SmallVector<llvm::StringRef, 4> parts;
+    names.split(parts, '|');
+    for (llvm::StringRef name : parts)
+      if (symbol_names_.IsShared(absl::string_view(name.data(), name.size()),
+                                 target))
+        return true;
+    return false;
+  }
+
+  // True if an explicit register operand is or overlaps `reg`.
+  bool OperandsOverlap(const llvm::MCInst& inst, llvm::MCRegister reg) const {
+    for (const llvm::MCOperand& op : inst) {
+      if (op.isReg() && op.getReg().isValid() &&
+          mri_.regsOverlap(op.getReg(), reg))
+        return true;
+    }
+    return false;
+  }
+
+  // Reads or writes `reg`, explicitly or implicitly.
+  bool Touches(const llvm::MCInst& inst, const llvm::MCInstrDesc& desc,
+               llvm::MCRegister reg) const {
+    if (OperandsOverlap(inst, reg)) return true;
+    for (llvm::MCPhysReg r : desc.implicit_uses())
+      if (mri_.regsOverlap(r, reg)) return true;
+    for (llvm::MCPhysReg r : desc.implicit_defs())
+      if (mri_.regsOverlap(r, reg)) return true;
+    return false;
+  }
+
+  MiniDisassembler& disassembler_;
+  const llvm::MCInstrInfo& mii_;
+  const llvm::MCRegisterInfo& mri_;
+  const absl::flat_hash_map<uint64_t, std::string>& callee_names_;
+  const SymbolNameIndex& symbol_names_;
+  const std::pair<uint64_t, uint64_t> absolute_addresses_;
+  const llvm::MCRegister rip_;
+  const llvm::MCRegister rsp_;
+  const llvm::MCRegister ssp_;
+  const llvm::MCRegister fs_;
+  const llvm::MCRegister gs_;
+  const llvm::MCRegister r11_;
+};
+
+// Builds the Call-Return candidates. Every block of a function qualifies
+// except its entry block (which holds the prologue and entry
+// instrumentation), blocks that end in a return or a tail call (those are
+// tail-call folds), EH pads, and functions named `DeduBB.*` (the masters of a
+// previous run).
+// A block that would be a Call-Return candidate if a rule were relaxed (for
+// the estimate only).
+struct RelaxedCallReturnBlock {
+  CallReturnBlock block;
+  bool stack_base = false;    // Needs %rsp as a memory base.
+  bool rip_relative = false;  // Needs %rip-relative operands.
+};
+
+std::vector<CallReturnBlock> BuildCallReturnBlocks(
+    const BbAddrMapPb& bb_addr_map, const BinaryContent& binary_content,
+    const SymbolNameIndex& symbol_names, bool cold_only,
+    bool skip_aliased_functions, CallReturnScanStats& stats,
+    std::vector<RelaxedCallReturnBlock>* relaxed = nullptr) {
+  std::vector<CallReturnBlock> candidates;
+  absl::StatusOr<std::unique_ptr<MiniDisassembler>> disassembler =
+      MiniDisassembler::Create(binary_content.object_file.get());
+  if (!disassembler.ok()) {
+    LOG(WARNING) << "DeduBB call-return skipped: "
+                 << disassembler.status().message();
+    return candidates;
+  }
+  const absl::flat_hash_map<uint64_t, std::string> callee_names =
+      BuildCalleeNames(binary_content, (*disassembler)->subtarget_info());
+  const CallReturnAnalyzer analyzer(**disassembler, callee_names,
+                                    symbol_names);
+  if (!analyzer.IsValid()) {
+    LOG(WARNING) << "DeduBB call-return skipped: RIP/RSP/FS/GS not found";
+    return candidates;
+  }
+  for (const ModuleBbAddrMapPb& module : bb_addr_map.module_bb_addr_maps()) {
+    for (const FunctionBbAddrMapPb& function :
+         module.function_bb_addr_maps()) {
+      if (skip_aliased_functions && IsAliased(function)) continue;
+      const std::string function_name =
+          function.function_names().empty()
+              ? std::string(absl::StrFormat("0x%lx", function.function_address()))
+              : std::string(function.function_names(0));
+      if (llvm::StringRef(function_name).starts_with("DeduBB.")) continue;
+      std::unordered_map<uint64_t, const BbEntryPb*> block_at;
+      for (const BbRangePb& bb_range : function.bb_ranges()) {
+        for (const BbEntryPb& bb_entry : bb_range.bb_entries()) {
+          block_at.emplace(bb_range.base_address() + bb_entry.offset(),
+                           &bb_entry);
+        }
+      }
+      // Decode the whole function once: the red-zone check needs every block.
+      struct Decoded {
+        const BbEntryPb* entry;
+        uint64_t address;
+        std::vector<uint8_t> bytes;
+        std::vector<DecodedInst> insts;
+        bool ok;
+      };
+      std::vector<Decoded> decoded;
+      bool red_zone = false;
+      for (const BbRangePb& bb_range : function.bb_ranges()) {
+        for (const BbEntryPb& bb_entry : bb_range.bb_entries()) {
+          if (bb_entry.size() == 0) continue;
+          const uint64_t address = bb_range.base_address() + bb_entry.offset();
+          Decoded d{&bb_entry, address, {}, {}, false};
+          absl::StatusOr<std::vector<uint8_t>> block_bytes = GetBlockBytes(
+              *binary_content.object_file, address, bb_entry.size());
+          if (block_bytes.ok()) {
+            d.bytes = *std::move(block_bytes);
+            d.ok = analyzer.Decode(d.bytes, address, d.insts);
+          }
+          // An undecodable block might keep data in the red zone too.
+          red_zone = red_zone || !d.ok || analyzer.UsesRedZone(d.insts);
+          decoded.push_back(std::move(d));
+        }
+      }
+      stats.red_zone_functions += red_zone;
+
+      std::string mod_name = std::string(module.module_name());
+      if (mod_name.empty()) {
+        size_t uniq_pos = function_name.find(".__uniq.");
+        if (uniq_pos != std::string::npos) {
+          mod_name = function_name.substr(uniq_pos + 8);
+        }
+      }
+      for (const Decoded& d : decoded) {
+        const BbEntryPb& bb_entry = *d.entry;
+        if (bb_entry.has_return() || bb_entry.has_tail_call()) continue;
+        if (d.address == function.function_address()) continue;
+        if (bb_entry.is_eh_pad()) continue;
+        if (cold_only && (bb_entry.post_link_frequency() > 0 ||
+                          bb_entry.frequency() > 0))
+          continue;
+        ++stats.scanned;
+        CallReturnBlock block;
+        CallReturnReject reject = CallReturnReject::kNone;
+        if (!d.ok) {
+          reject = CallReturnReject::kDecodeError;
+        } else {
+          reject = analyzer.Analyze(d.insts, d.bytes, d.address, block_at,
+                                    block);
+          if (reject == CallReturnReject::kNone && red_zone)
+            reject = CallReturnReject::kRedZone;
+        }
+        ++stats.by_reason[static_cast<int>(reject)];
+        if (relaxed != nullptr && !red_zone &&
+            (reject == CallReturnReject::kStackPointer ||
+             reject == CallReturnReject::kRipRelative)) {
+          RelaxedCallReturnBlock r;
+          CallReturnRelax relax, used;
+          relax.stack_base = relax.rip_relative = true;
+          if (analyzer.Analyze(d.insts, d.bytes, d.address, block_at, r.block,
+                               relax, &used) == CallReturnReject::kNone) {
+            r.block.module_name = mod_name;
+            r.block.function_name = function_name;
+            r.block.bb_id = bb_entry.id();
+            r.block.address = d.address;
+            r.stack_base = used.stack_base;
+            r.rip_relative = used.rip_relative;
+            relaxed->push_back(std::move(r));
+          }
+        }
+        if (reject != CallReturnReject::kNone) continue;
+        block.module_name = mod_name;
+        block.function_name = function_name;
+        block.bb_id = bb_entry.id();
+        block.address = d.address;
+        block.frequency =
+            std::max(static_cast<uint64_t>(bb_entry.post_link_frequency()),
+                     static_cast<uint64_t>(bb_entry.frequency()));
+        candidates.push_back(std::move(block));
+      }
+    }
+  }
+  return candidates;
+}
+
+// Builds the input of the range finder (subsequence_dedupper.h): every
+// instruction of every block, with the kinds of range of `kinds` that may hold
+// it (Call-Return: CallReturnAnalyzer::ClassifyInstruction; Save-and-Jump:
+// CallReturnAnalyzer::IsSaveAndJumpRunnable) and its key. A block holds no
+// range if it is an EH pad or, with `cold_only`, hot, and no Call-Return range
+// if its function keeps data in the red zone, where the stub's call writes.
+// Instructions from `reserved_from` on, by function name and block id, belong
+// to a tail-call fold (a whole block, or an ending shared in place) and hold
+// none. An undecodable block has no instructions, so the compiler folds
+// nothing in it either. The entry block takes part: the compiler folds a
+// range there only after the prologue. Functions named `DeduBB.*` (the
+// masters of a previous run) are left out. `sj_runnable` counts the
+// instructions a Save-and-Jump range may hold.
+SubsequenceInput BuildSubsequenceInput(
+    const BbAddrMapPb& bb_addr_map, const BinaryContent& binary_content,
+    const SymbolNameIndex& symbol_names, bool cold_only,
+    bool skip_aliased_functions, uint8_t kinds,
+    const absl::flat_hash_map<std::pair<std::string, uint32_t>, uint32_t>&
+        reserved_from,
+    CallReturnScanStats& stats, int64_t& left_out_blocks,
+    int64_t& sj_runnable) {
+  SubsequenceInput input;
+  absl::StatusOr<std::unique_ptr<MiniDisassembler>> disassembler =
+      MiniDisassembler::Create(binary_content.object_file.get());
+  if (!disassembler.ok()) {
+    LOG(WARNING) << "DeduBB subsequence skipped: "
+                 << disassembler.status().message();
+    return input;
+  }
+  const absl::flat_hash_map<uint64_t, std::string> callee_names =
+      BuildCalleeNames(binary_content, (*disassembler)->subtarget_info());
+  const CallReturnAnalyzer analyzer(**disassembler, callee_names,
+                                    symbol_names);
+  if (!analyzer.IsValid()) {
+    LOG(WARNING) << "DeduBB subsequence skipped: RIP/RSP/FS/GS not found";
+    return input;
+  }
+  std::vector<uint8_t> key;
+  std::string callee;
+  for (const ModuleBbAddrMapPb& module : bb_addr_map.module_bb_addr_maps()) {
+    for (const FunctionBbAddrMapPb& function :
+         module.function_bb_addr_maps()) {
+      if (skip_aliased_functions && IsAliased(function)) continue;
+      const std::string function_name =
+          function.function_names().empty()
+              ? std::string(absl::StrFormat("0x%lx", function.function_address()))
+              : std::string(function.function_names(0));
+      if (llvm::StringRef(function_name).starts_with("DeduBB.")) continue;
+      // Decode the whole function first: the red-zone check needs every block.
+      struct Decoded {
+        const BbEntryPb* entry;
+        uint64_t address;
+        std::vector<uint8_t> bytes;
+        std::vector<DecodedInst> insts;
+        bool ok;
+      };
+      std::vector<Decoded> decoded;
+      bool red_zone = false;
+      for (const BbRangePb& bb_range : function.bb_ranges()) {
+        for (const BbEntryPb& bb_entry : bb_range.bb_entries()) {
+          if (bb_entry.size() == 0) continue;
+          const uint64_t address = bb_range.base_address() + bb_entry.offset();
+          Decoded d{&bb_entry, address, {}, {}, false};
+          absl::StatusOr<std::vector<uint8_t>> block_bytes = GetBlockBytes(
+              *binary_content.object_file, address, bb_entry.size());
+          if (block_bytes.ok()) {
+            d.bytes = *std::move(block_bytes);
+            d.ok = analyzer.Decode(d.bytes, address, d.insts);
+          }
+          red_zone = red_zone || !d.ok || analyzer.UsesRedZone(d.insts);
+          decoded.push_back(std::move(d));
+        }
+      }
+      stats.red_zone_functions += red_zone;
+
+      std::string mod_name = std::string(module.module_name());
+      if (mod_name.empty()) {
+        size_t uniq_pos = function_name.find(".__uniq.");
+        if (uniq_pos != std::string::npos) {
+          mod_name = function_name.substr(uniq_pos + 8);
+        }
+      }
+      for (const Decoded& d : decoded) {
+        const BbEntryPb& bb_entry = *d.entry;
+        input.AddBlock(mod_name, function_name, bb_entry.id(), d.address,
+                       std::max(static_cast<uint64_t>(
+                                    bb_entry.post_link_frequency()),
+                                static_cast<uint64_t>(bb_entry.frequency())));
+        if (!d.ok) {
+          ++left_out_blocks;
+          continue;
+        }
+        const bool range_ok =
+            !bb_entry.is_eh_pad() &&
+            !(cold_only && (bb_entry.post_link_frequency() > 0 ||
+                            bb_entry.frequency() > 0));
+        const bool cr_ok = range_ok && !red_zone && (kinds & kRunCallReturn);
+        const bool sj_ok = range_ok && (kinds & kRunSaveAndJump);
+        const auto reserved =
+            reserved_from.find(std::make_pair(function_name, bb_entry.id()));
+        const uint32_t reserved_at =
+            reserved == reserved_from.end()
+                ? std::numeric_limits<uint32_t>::max()
+                : reserved->second;
+        if ((!cr_ok && !sj_ok) || reserved_at == 0) ++left_out_blocks;
+        for (uint32_t j = 0; j < d.insts.size(); ++j) {
+          const DecodedInst& inst = d.insts[j];
+          key.clear();
+          callee.clear();
+          bool direct_call = false;
+          uint8_t inst_kinds = 0;
+          // Possibly made by the linker out of a thread-local access.
+          const bool after_tls = analyzer.FollowsTlsAccess(d.insts, j);
+          if (j < reserved_at) {
+            if (cr_ok) {
+              ++stats.scanned;
+              const CallReturnReject reject =
+                  after_tls ? CallReturnReject::kTls
+                            : analyzer.ClassifyInstruction(
+                                  inst, d.bytes, d.address, key, callee,
+                                  direct_call);
+              ++stats.by_reason[static_cast<int>(reject)];
+              if (reject == CallReturnReject::kNone) {
+                inst_kinds |= kRunCallReturn;
+              } else {
+                key.clear();
+                callee.clear();
+                direct_call = false;
+              }
+            }
+            if (sj_ok && !after_tls && analyzer.IsSaveAndJumpRunnable(inst)) {
+              // A Call-Return key, if any, is the instruction's bytes too: it
+              // makes no call.
+              if (!(inst_kinds & kRunCallReturn))
+                key.assign(d.bytes.begin() + inst.offset,
+                           d.bytes.begin() + inst.offset + inst.size);
+              inst_kinds |= kRunSaveAndJump;
+              ++sj_runnable;
+            }
+          }
+          input.AddInstruction(key, static_cast<uint8_t>(inst.size),
+                               direct_call, callee, inst_kinds);
+        }
+      }
+    }
+  }
+  return input;
+}
+
+// Builds the input of the tail-call suffix finder (subsequence_dedupper.h):
+// the blocks that end in a return or a tail call, picked as for whole-block
+// tail-call folds but for conditional tail calls, which keep a successor, with
+// every instruction that an ending shared in place may hold
+// (CallReturnAnalyzer::ClassifyTailCallInstruction) and its key. `scanned`
+// counts the blocks, `shareable` the instructions that may be shared.
+SubsequenceInput BuildTailCallSuffixInput(
+    const BbAddrMapPb& bb_addr_map, const BinaryContent& binary_content,
+    const SymbolNameIndex& symbol_names, bool cold_only,
+    bool skip_aliased_functions, int64_t& scanned, int64_t& shareable) {
+  SubsequenceInput input;
+  absl::StatusOr<std::unique_ptr<MiniDisassembler>> disassembler =
+      MiniDisassembler::Create(binary_content.object_file.get());
+  if (!disassembler.ok()) {
+    LOG(WARNING) << "DeduBB tail-call suffixes skipped: "
+                 << disassembler.status().message();
+    return input;
+  }
+  const absl::flat_hash_map<uint64_t, std::string> callee_names =
+      BuildCalleeNames(binary_content, (*disassembler)->subtarget_info());
+  const CallReturnAnalyzer analyzer(
+      **disassembler, callee_names, symbol_names,
+      AbsoluteAddressRange(*binary_content.object_file));
+  if (!analyzer.IsValid()) {
+    LOG(WARNING) << "DeduBB tail-call suffixes skipped: registers not found";
+    return input;
+  }
+  std::vector<uint8_t> key;
+  std::string callee;
+  std::vector<DecodedInst> insts;
+  for (const ModuleBbAddrMapPb& module : bb_addr_map.module_bb_addr_maps()) {
+    for (const FunctionBbAddrMapPb& function :
+         module.function_bb_addr_maps()) {
+      if (skip_aliased_functions && IsAliased(function)) continue;
+      const std::string function_name =
+          function.function_names().empty()
+              ? std::string(absl::StrFormat("0x%lx", function.function_address()))
+              : std::string(function.function_names(0));
+      if (llvm::StringRef(function_name).starts_with("DeduBB.")) continue;
+      std::string mod_name = std::string(module.module_name());
+      if (mod_name.empty()) {
+        size_t uniq_pos = function_name.find(".__uniq.");
+        if (uniq_pos != std::string::npos) {
+          mod_name = function_name.substr(uniq_pos + 8);
+        }
+      }
+      for (const BbRangePb& bb_range : function.bb_ranges()) {
+        for (const BbEntryPb& bb_entry : bb_range.bb_entries()) {
+          if (!bb_entry.has_tail_call() && !bb_entry.has_return()) continue;
+          if (bb_entry.size() == 0 || bb_entry.is_eh_pad() ||
+              bb_entry.can_fall_through())
+            continue;
+          if (cold_only && (bb_entry.post_link_frequency() > 0 ||
+                            bb_entry.frequency() > 0))
+            continue;
+          const uint64_t address = bb_range.base_address() + bb_entry.offset();
+          absl::StatusOr<std::vector<uint8_t>> bytes = GetBlockBytes(
+              *binary_content.object_file, address, bb_entry.size());
+          if (!bytes.ok() || !analyzer.Decode(*bytes, address, insts)) continue;
+          ++scanned;
+          input.AddBlock(mod_name, function_name, bb_entry.id(), address,
+                         std::max(static_cast<uint64_t>(
+                                      bb_entry.post_link_frequency()),
+                                  static_cast<uint64_t>(bb_entry.frequency())));
+          for (size_t j = 0; j < insts.size(); ++j) {
+            bool direct = false;
+            const bool ok =
+                !analyzer.FollowsTlsAccess(insts, j) &&
+                analyzer.ClassifyTailCallInstruction(
+                    insts[j], *bytes, address, j + 1 == insts.size(), key,
+                    callee, direct);
+            if (!ok) {
+              key.clear();
+              callee.clear();
+              direct = false;
+            }
+            shareable += ok;
+            input.AddInstruction(key, static_cast<uint8_t>(insts[j].size),
+                                 direct, callee, ok ? kRunCallReturn : 0);
+          }
+        }
+      }
+    }
+  }
+  return input;
+}
+
+// Why a tail-call candidate was left out (x86-64 only).
+enum class TailCallSkip {
+  kNone,
+  kRipRelative,      // A %rip-relative operand.
+  kUnnamedTarget,    // A call or jump to an address no function symbol names.
+  kCallerSensitive,  // A call to a function that returns twice or that
+                     // identifies its caller by the return address.
+  kDecodeError,
+};
+
+// Fills in the key and callees of the x86-64 tail-call candidate `block` (see
+// `TailCallBlock`). The key is its bytes, except that each direct call or
+// jump contributes its bytes without the displacement and then the absolute
+// target. Blocks with equal keys run the same instructions to the same
+// targets, which is what folding one into another needs; equal bytes are not
+// enough.
+TailCallSkip KeyTailCallBlock(
+    MiniDisassembler& disassembler, llvm::MCRegister rip,
+    const absl::flat_hash_map<uint64_t, std::string>& callee_names,
+    TailCallBlock& block) {
+  const llvm::MCRegisterInfo& mri = disassembler.register_info();
+  const llvm::ArrayRef<uint8_t> bytes = block.bytes;
+  block.key.clear();
+  block.callees.clear();
+  for (uint64_t offset = 0; offset < bytes.size();) {
+    uint64_t size = 0;
+    absl::StatusOr<llvm::MCInst> inst = disassembler.DisassembleOne(
+        bytes.drop_front(offset), block.address + offset, size);
+    if (!inst.ok() || size == 0 || offset + size > bytes.size())
+      return TailCallSkip::kDecodeError;
+    const llvm::ArrayRef<uint8_t> inst_bytes = bytes.slice(offset, size);
+    for (unsigned i = 0; i < inst->getNumOperands(); ++i) {
+      const llvm::MCOperand& op = inst->getOperand(i);
+      if (op.isReg() && op.getReg().isValid() &&
+          mri.regsOverlap(op.getReg(), rip))
+        return TailCallSkip::kRipRelative;
+    }
+    uint64_t target = 0;
+    if (disassembler.instr_analysis().evaluateBranch(
+            *inst, block.address + offset, size, target)) {
+      // The displacement ends the instruction: 4 bytes, or 1 for the short
+      // forms.
+      const int64_t disp =
+          static_cast<int64_t>(target - (block.address + offset + size));
+      uint32_t rel32 = 0;
+      if (size >= 5)
+        for (int i = 0; i < 4; ++i)
+          rel32 |= static_cast<uint32_t>(inst_bytes[size - 4 + i]) << (8 * i);
+      size_t width = 0;
+      if (size >= 5 && static_cast<int32_t>(rel32) == disp)
+        width = 4;
+      else if (static_cast<int8_t>(inst_bytes.back()) == disp)
+        width = 1;
+      else
+        return TailCallSkip::kDecodeError;
+      const auto it = callee_names.find(target);
+      if (it == callee_names.end()) return TailCallSkip::kUnnamedTarget;
+      if (IsReturnsTwice(it->second) || IsCallerSensitive(it->second))
+        return TailCallSkip::kCallerSensitive;
+      block.callees.push_back(it->second);
+      block.key.insert(block.key.end(), inst_bytes.begin(),
+                       inst_bytes.end() - width);
+      for (int i = 0; i < 8; ++i)
+        block.key.push_back(static_cast<uint8_t>(target >> (8 * i)));
+    } else {
+      block.key.insert(block.key.end(), inst_bytes.begin(), inst_bytes.end());
+    }
+    offset += size;
+  }
+  return TailCallSkip::kNone;
+}
+
+}  // namespace
+
+std::vector<TailCallBlock> BuildTailCallBlocks(
+    const BbAddrMapPb& bb_addr_map, const BinaryContent& binary_content,
+    bool cold_only, bool skip_aliased_functions, TailCallScanStats* stats) {
+  std::vector<TailCallBlock> blocks;
+  TailCallScanStats unused;
+  if (stats == nullptr) stats = &unused;
+  // On x86-64 each block is decoded and keyed by the targets it reaches;
+  // elsewhere, blocks are grouped by their bytes and the compiler refuses to
+  // fold one that names a symbol.
+  std::unique_ptr<MiniDisassembler> disassembler;
+  absl::flat_hash_map<uint64_t, std::string> callee_names;
+  llvm::MCRegister rip;
+  if (binary_content.object_file->getArch() == llvm::Triple::x86_64) {
+    absl::StatusOr<std::unique_ptr<MiniDisassembler>> created =
+        MiniDisassembler::Create(binary_content.object_file.get());
+    if (created.ok()) {
+      disassembler = *std::move(created);
+      callee_names =
+          BuildCalleeNames(binary_content, disassembler->subtarget_info());
+      const llvm::MCRegisterInfo& mri = disassembler->register_info();
+      for (unsigned reg = 1, e = mri.getNumRegs(); reg < e; ++reg)
+        if (llvm::StringRef(mri.getName(reg)) == "RIP")
+          rip = llvm::MCRegister(reg);
+    }
+    if (!rip.isValid()) {
+      LOG(WARNING) << "DeduBB tail-call dedup skipped: cannot decode "
+                      "x86-64 code";
+      return blocks;
+    }
+  }
+  for (const ModuleBbAddrMapPb& module : bb_addr_map.module_bb_addr_maps()) {
+    for (const FunctionBbAddrMapPb& function :
+         module.function_bb_addr_maps()) {
+      if (skip_aliased_functions && IsAliased(function)) continue;
+      const std::string function_name =
+          function.function_names().empty()
+              ? std::string(absl::StrFormat("0x%lx", function.function_address()))
+              : std::string(function.function_names(0));
+      for (const BbRangePb& bb_range : function.bb_ranges()) {
+        for (const BbEntryPb& bb_entry : bb_range.bb_entries()) {
+          // Only blocks that end in a tail call or a return are foldable with a
+          // single jump (DeduBB Case I).
+          if (!bb_entry.has_tail_call() && !bb_entry.has_return()) continue;
+          if (bb_entry.size() == 0) continue;
+          // Exception-handling pads have special unwinder requirements; leave
+          // them alone.
+          if (bb_entry.is_eh_pad()) continue;
+          // Optionally restrict to cold blocks to preserve hot-path
+          // performance (DeduBB profile-guided mode).
+          if (cold_only && (bb_entry.post_link_frequency() > 0 || bb_entry.frequency() > 0)) continue;
+
+          const uint64_t address = bb_range.base_address() + bb_entry.offset();
+          absl::StatusOr<std::vector<uint8_t>> bytes = GetBlockBytes(
+              *binary_content.object_file, address, bb_entry.size());
+          if (!bytes.ok()) {
+            LOG(WARNING) << "Skipping block " << function_name << "#"
+                         << bb_entry.id() << ": " << bytes.status().message();
+            continue;
+          }
+          std::string mod_name = std::string(module.module_name());
+          if (mod_name.empty()) {
+            size_t uniq_pos = function_name.find(".__uniq.");
+            if (uniq_pos != std::string::npos) {
+              mod_name = function_name.substr(uniq_pos + 8);
+            }
+          }
+          TailCallBlock block{mod_name, function_name, bb_entry.id(), address,
+                              std::max(static_cast<uint64_t>(bb_entry.post_link_frequency()), static_cast<uint64_t>(bb_entry.frequency())),
+                              *std::move(bytes)};
+          if (disassembler != nullptr) {
+            ++stats->scanned;
+            // A block that also falls through (a conditional tail call) keeps
+            // its successor, which a jump to the master would lose.
+            if (bb_entry.can_fall_through()) {
+              ++stats->falls_through;
+              continue;
+            }
+            switch (KeyTailCallBlock(*disassembler, rip, callee_names, block)) {
+              case TailCallSkip::kNone:
+                break;
+              case TailCallSkip::kRipRelative:
+                ++stats->rip_relative;
+                continue;
+              case TailCallSkip::kUnnamedTarget:
+                ++stats->unnamed_target;
+                continue;
+              case TailCallSkip::kCallerSensitive:
+                ++stats->caller_sensitive;
+                continue;
+              case TailCallSkip::kDecodeError:
+                ++stats->decode_error;
+                continue;
+            }
+            if (!block.callees.empty()) ++stats->with_targets;
+          }
+          blocks.push_back(std::move(block));
+        }
+      }
+    }
+  }
+  return blocks;
+}
+
+absl::Status WriteTailCallDedupProfile(const PropellerOptions& opts,
+                                       const ProgramCfg* program_cfg) {
+  if (opts.dedubb_profile_out_name().empty()) return absl::OkStatus();
+
+  ASSIGN_OR_RETURN(std::unique_ptr<BinaryContent> binary_content,
+                   GetBinaryContent(opts.binary_name()));
+
+  // `GetBbAddrMap` decodes the `SHT_LLVM_BB_ADDR_MAP` section into a proto with
+  // module names (via DWARF), function names (via the symbol table), and the
+  // per-block tail-call/return flags we need.
+  BbAddrMapPb bb_addr_map = GetBbAddrMap(opts.binary_name());
+
+  // Block frequencies pick the hottest copy of a duplicate as its master and,
+  // with `dedubb_cold_only`, leave the blocks that ran alone. They come from
+  // the perf profile, if there is one, and from the binary itself if it was
+  // built with `-pgo-analysis-map`.
+  if (program_cfg != nullptr) {
+    LOG(INFO) << "DeduBB: the profile shows "
+              << AddProfileFrequencies(*program_cfg, bb_addr_map)
+              << " block(s) to have run";
+  }
+  if (opts.dedubb_cold_only()) {
+    int64_t blocks = 0;
+    int64_t hot = 0;
+    for (const ModuleBbAddrMapPb& module : bb_addr_map.module_bb_addr_maps())
+      for (const FunctionBbAddrMapPb& function : module.function_bb_addr_maps())
+        for (const BbRangePb& range : function.bb_ranges())
+          for (const BbEntryPb& block : range.bb_entries()) {
+            ++blocks;
+            hot += block.post_link_frequency() > 0 || block.frequency() > 0;
+          }
+    LOG(INFO) << "DeduBB: cold only, leaving alone the " << hot << " of "
+              << blocks << " block(s) that ran";
+    if (hot == 0) {
+      LOG(WARNING) << "DeduBB: --dedubb_cold_only, but no block has a "
+                      "frequency, so every block counts as cold: pass the "
+                      "perf profile with --profile";
+    }
+  }
+
+  // The compiler knows functions by name alone. A function without a symbol
+  // could have the name of any function a directive names, or of any callee a
+  // master calls by name, so nothing can be folded safely.
+  int64_t unnamed = 0;
+  for (const ModuleBbAddrMapPb& module : bb_addr_map.module_bb_addr_maps())
+    for (const FunctionBbAddrMapPb& function : module.function_bb_addr_maps())
+      unnamed += function.function_names().empty();
+  if (unnamed != 0) {
+    LOG(ERROR) << "DeduBB: " << unnamed
+               << " function(s) have no symbol, as when the binary's local "
+                  "symbols are discarded (-Wl,--discard-all, -Wl,-x or "
+                  "-Wl,--strip-all); the compiler tells functions apart by "
+                  "name, so any directive could apply to one of them too. "
+                  "Writing no directives to "
+               << opts.dedubb_profile_out_name();
+    std::ofstream out(std::string(opts.dedubb_profile_out_name()),
+                      std::ofstream::out | std::ofstream::trunc);
+    if (!out) {
+      return absl::UnavailableError(
+          absl::StrFormat("Failed to write DeduBB directives to '%s'",
+                          opts.dedubb_profile_out_name()));
+    }
+    return absl::OkStatus();
+  }
+  // Functions that share a name, such as local functions of the same name in
+  // two source files, are left alone: the compiler would apply the directives
+  // of one to both.
+  SymbolNameIndex symbol_names;
+  symbol_names.AddSymbols(*binary_content->object_file);
+  const int64_t ambiguous = RemoveAmbiguousFunctions(symbol_names, bb_addr_map);
+  LOG(INFO) << "DeduBB: skipping " << ambiguous
+            << " function(s) whose name, up to a ThinLTO .llvm. suffix, "
+               "another function shares "
+               "(-funique-internal-linkage-names tells local functions apart)";
+
+  if (opts.dedubb_skip_aliased_functions()) {
+    int64_t aliased = 0;
+    for (const ModuleBbAddrMapPb& module : bb_addr_map.module_bb_addr_maps())
+      for (const FunctionBbAddrMapPb& function : module.function_bb_addr_maps())
+        aliased += IsAliased(function);
+    LOG(INFO) << "DeduBB: skipping " << aliased
+              << " function(s) whose address carries more than one name "
+                 "(aliases or identical-code-folded functions)";
+  }
+
+  TailCallScanStats tc_stats;
+  std::vector<TailCallBlock> blocks =
+      BuildTailCallBlocks(bb_addr_map, *binary_content, opts.dedubb_cold_only(),
+                          opts.dedubb_skip_aliased_functions(), &tc_stats);
+
+  SaveAndJumpScanStats sj_stats;
+  SaveAndJumpCandidates sj_blocks;
+  const int sj_patch_size = SaveAndJumpPatchSize(*binary_content);
+  const bool branch_tracking =
+      HasIndirectBranchTracking(*binary_content->object_file);
+  if (sj_patch_size > 0 && !branch_tracking) {
+    sj_blocks = BuildSaveAndJumpBlocks(bb_addr_map, *binary_content,
+                                       opts.dedubb_cold_only(),
+                                       opts.dedubb_skip_aliased_functions(),
+                                       sj_stats);
+  } else if (branch_tracking) {
+    LOG(INFO) << "DeduBB save-and-jump: not used, the binary is built for "
+                 "indirect branch tracking";
+  } else {
+    LOG(INFO) << "DeduBB save-and-jump: not supported for this target";
+  }
+
+  // Call-Return (x86-64 only). With `dedubb_call_return` its groups are formed
+  // first and their blocks are withheld from Save-and-Jump: for a block that
+  // qualifies for both, a Call-Return stub is smaller (5 or 11 bytes against
+  // 12 or 19) and its master costs one byte instead of 10 or 22.
+  // `dedubb_call_return_estimate` only logs what that would do.
+  const bool call_return = opts.dedubb_call_return();
+  const bool call_return_estimate =
+      call_return || opts.dedubb_call_return_estimate();
+  CallReturnScanStats cr_stats;
+  std::vector<CallReturnBlock> cr_blocks;
+  std::vector<RelaxedCallReturnBlock> cr_relaxed;
+  if (call_return_estimate) {
+    if (binary_content->object_file->getArch() == llvm::Triple::x86_64) {
+      cr_blocks = BuildCallReturnBlocks(
+          bb_addr_map, *binary_content, symbol_names, opts.dedubb_cold_only(),
+          opts.dedubb_skip_aliased_functions(), cr_stats,
+          opts.dedubb_call_return_estimate() ? &cr_relaxed : nullptr);
+    } else {
+      LOG(INFO) << "DeduBB call-return: not supported for this target";
+    }
+  }
+  CallReturnDedupOptions cr_options;
+  cr_options.intra_module_only = opts.dedubb_intra_module_only();
+  CallReturnDedupResult cr_result =
+      DeduplicateCallReturnBlocks(cr_blocks, cr_options);
+
+  TailCallDedupOptions dedup_options;
+  dedup_options.patch_size = TailCallPatchSize(*binary_content);
+  dedup_options.intra_module_only = opts.dedubb_intra_module_only();
+  const TailCallDedupResult result =
+      DeduplicateTailCallBlocks(blocks, dedup_options);
+
+  // Ranges (x86-64 only), written with `dedubb_subsequence` and only logged
+  // with `dedubb_subsequence_estimate`. Of the kinds `dedubb_subsequence_kinds`
+  // names: tail-call endings shared in place first, which replace whole-block
+  // tail-call folds; then Call-Return and Save-and-Jump runs in the rest of
+  // every block, which replace whole-body Call-Return folds; then, below,
+  // whole-block Save-and-Jump on the blocks that hold no range.
+  const bool subsequence = opts.dedubb_subsequence();
+  const bool subsequence_estimate =
+      subsequence || opts.dedubb_subsequence_estimate();
+  bool tc_kind = false;
+  uint8_t run_kinds = 0;
+  for (absl::string_view kind :
+       absl::StrSplit(opts.dedubb_subsequence_kinds(), ',', absl::SkipEmpty())) {
+    if (kind == "tc") {
+      tc_kind = true;
+    } else if (kind == "cr") {
+      run_kinds |= kRunCallReturn;
+    } else if (kind == "sj") {
+      run_kinds |= kRunSaveAndJump;
+    } else {
+      return absl::InvalidArgumentError(absl::StrFormat(
+          "unknown kind '%s' in --dedubb_subsequence_kinds", kind));
+    }
+  }
+  const bool x86_64 =
+      binary_content->object_file->getArch() == llvm::Triple::x86_64;
+  if (branch_tracking) run_kinds &= ~kRunSaveAndJump;
+  if (subsequence_estimate && !x86_64)
+    LOG(INFO) << "DeduBB subsequence: not supported for this target";
+
+  // Tail-call endings.
+  const bool tc_suffixes = subsequence_estimate && x86_64 && tc_kind;
+  TailCallSuffixResult tc_suffix;
+  std::vector<Directive> tc_suffix_directives;
+  int64_t tc_suffix_scanned = 0, tc_suffix_shareable = 0;
+  if (tc_suffixes) {
+    const SubsequenceInput tc_input = BuildTailCallSuffixInput(
+        bb_addr_map, *binary_content, symbol_names, opts.dedubb_cold_only(),
+        opts.dedubb_skip_aliased_functions(), tc_suffix_scanned,
+        tc_suffix_shareable);
+    TailCallSuffixOptions tc_options;
+    tc_options.patch_size = TailCallPatchSize(*binary_content);
+    tc_options.intra_module_only = opts.dedubb_intra_module_only();
+    tc_suffix = FindTailCallSuffixes(tc_input, tc_options);
+    tc_suffix_directives = MakeTailCallSuffixDirectives(
+        tc_input, tc_suffix, /*first_master_id=*/0);
+  }
+  // With ranges, the masters of the other kinds are numbered after the
+  // tail-call ones that are written with them.
+  const uint64_t seq_tc_masters =
+      tc_suffixes ? tc_suffix.groups.size() : result.num_masters;
+
+  SubsequenceResult seq_result;
+  std::vector<Directive> seq_directives;
+  std::vector<uint64_t> seq_stub_addresses;
+  int seq_master_modules = 0;
+  CallReturnScanStats seq_stats;
+  int64_t seq_left_out_blocks = 0;
+  int64_t seq_sj_runnable = 0;
+  uint64_t seq_blocks = 0;
+  if (subsequence_estimate && x86_64) {
+    // The instructions tail-call folds keep: from the start of an ending
+    // shared in place (the longest, for a master of several), or whole
+    // blocks.
+    absl::flat_hash_map<std::pair<std::string, uint32_t>, uint32_t>
+        reserved_from;
+    if (tc_suffixes) {
+      for (const Directive& d : tc_suffix_directives) {
+        const auto [it, inserted] = reserved_from.try_emplace(
+            std::make_pair(d.function_name, d.bb_id), d.at);
+        if (!inserted) it->second = std::min(it->second, d.at);
+      }
+    } else {
+      for (const Directive& d : result.directives)
+        reserved_from[std::make_pair(d.function_name, d.bb_id)] = 0;
+    }
+    const SubsequenceInput input = BuildSubsequenceInput(
+        bb_addr_map, *binary_content, symbol_names, opts.dedubb_cold_only(),
+        opts.dedubb_skip_aliased_functions(), run_kinds, reserved_from,
+        seq_stats, seq_left_out_blocks, seq_sj_runnable);
+    seq_blocks = input.blocks().size();
+    SubsequenceOptions seq_options;
+    seq_options.intra_module_only = opts.dedubb_intra_module_only();
+    seq_result = FindRepeatedRuns(input, seq_options);
+    seq_directives = MakeSubsequenceDirectives(
+        input, seq_result, /*first_master_id=*/0, seq_stub_addresses,
+        seq_master_modules);
+  }
+
+  // Save-and-Jump, on all of its candidates and on those Call-Return leaves.
+  SaveAndJumpDedupOptions sj_options;
+  sj_options.patch_size = sj_patch_size;
+  sj_options.intra_module_only = opts.dedubb_intra_module_only();
+  SaveAndJumpDedupOptions sj2_options;
+  sj2_options.patch_size = kSaveAndJump2PatchSize;
+  sj2_options.master_overhead = kSaveAndJump2MasterOverhead;
+  sj2_options.intra_module_only = opts.dedubb_intra_module_only();
+  sj2_options.two_exit = true;
+  const std::vector<SaveAndJumpBlock> sj_left =
+      RemoveBlocksAt(sj_blocks.single_exit, cr_result.stub_addresses);
+  const std::vector<SaveAndJumpBlock> sj2_left =
+      RemoveBlocksAt(sj_blocks.two_exit, cr_result.stub_addresses);
+  const auto run_save_and_jump = [&](bool hybrid, SaveAndJumpDedupResult& sj,
+                                     SaveAndJumpDedupResult& sj2) {
+    sj_options.first_master_id = result.num_masters;
+    sj = DeduplicateSaveAndJumpBlocks(hybrid ? sj_left : sj_blocks.single_exit,
+                                      sj_options);
+    sj2_options.first_master_id = sj_options.first_master_id + sj.num_masters;
+    sj2 = DeduplicateSaveAndJumpBlocks(hybrid ? sj2_left : sj_blocks.two_exit,
+                                       sj2_options);
+    return sj2_options.first_master_id + sj2.num_masters;
+  };
+  // Save-and-Jump on its own, and next to Call-Return (the same if there are
+  // no Call-Return candidates).
+  SaveAndJumpDedupResult sj_alone, sj2_alone, sj_hybrid, sj2_hybrid;
+  const uint64_t next_id_alone =
+      run_save_and_jump(/*hybrid=*/false, sj_alone, sj2_alone);
+  const uint64_t next_id_hybrid =
+      call_return_estimate
+          ? run_save_and_jump(/*hybrid=*/true, sj_hybrid, sj2_hybrid)
+          : next_id_alone;
+  if (!call_return_estimate) {
+    sj_hybrid = sj_alone;
+    sj2_hybrid = sj2_alone;
+  }
+  // Save-and-Jump next to ranges: on the blocks that hold no range.
+  SaveAndJumpDedupResult sj_seq, sj2_seq;
+  if (subsequence_estimate) {
+    sj_options.first_master_id = seq_tc_masters;
+    sj_seq = DeduplicateSaveAndJumpBlocks(
+        RemoveBlocksAt(sj_blocks.single_exit, seq_stub_addresses), sj_options);
+    sj2_options.first_master_id = sj_options.first_master_id + sj_seq.num_masters;
+    sj2_seq = DeduplicateSaveAndJumpBlocks(
+        RemoveBlocksAt(sj_blocks.two_exit, seq_stub_addresses), sj2_options);
+    // Range masters are numbered after the two-exit Save-and-Jump ones.
+    const uint64_t next_id_seq =
+        sj2_options.first_master_id + sj2_seq.num_masters;
+    for (Directive& directive : seq_directives)
+      directive.master_id += next_id_seq;
+  }
+  const SaveAndJumpDedupResult& sj_result =
+      subsequence ? sj_seq : call_return ? sj_hybrid : sj_alone;
+  const SaveAndJumpDedupResult& sj2_result =
+      subsequence ? sj2_seq : call_return ? sj2_hybrid : sj2_alone;
+  // Call-Return masters are numbered after the two-exit Save-and-Jump ones.
+  OffsetCallReturnMasterIds(cr_result, next_id_hybrid);
+
+  const std::string out_path(opts.dedubb_profile_out_name());
+  std::ofstream out(out_path, std::ofstream::out | std::ofstream::trunc);
+  if (subsequence && tc_suffixes) {
+    TailCallDedupResult tc_ranges;
+    tc_ranges.directives = std::move(tc_suffix_directives);
+    out << FormatDirectives(tc_ranges);
+  } else {
+    out << FormatDirectives(result);
+  }
+  out << FormatSaveAndJumpDirectives(sj_result);
+  out << FormatSaveAndJumpDirectives(sj2_result);
+  if (subsequence) {
+    CallReturnDedupResult cr_ranges;
+    SaveAndJumpDedupResult sj_ranges;
+    for (Directive& directive : seq_directives) {
+      if (directive.kind == DirectiveKind::kMasterSaveJump ||
+          directive.kind == DirectiveKind::kFoldSaveJump)
+        sj_ranges.directives.push_back(std::move(directive));
+      else
+        cr_ranges.directives.push_back(std::move(directive));
+    }
+    out << FormatCallReturnDirectives(cr_ranges);
+    out << FormatSaveAndJumpDirectives(sj_ranges);
+  } else if (call_return) {
+    out << FormatCallReturnDirectives(cr_result);
+  }
+  if (!out) {
+    return absl::UnavailableError(
+        absl::StrFormat("Failed to write DeduBB directives to '%s'", out_path));
+  }
+
+  if (tc_stats.scanned != 0)
+    LOG(INFO) << "DeduBB tail-call: " << tc_stats.scanned
+              << " blocks scanned; left out: falls-through="
+              << tc_stats.falls_through
+              << ", rip-relative=" << tc_stats.rip_relative
+              << ", unnamed-target=" << tc_stats.unnamed_target
+              << ", caller-sensitive=" << tc_stats.caller_sensitive
+              << ", decode-error=" << tc_stats.decode_error << "; "
+              << tc_stats.with_targets
+              << " candidate(s) call or jump to named functions";
+  LOG(INFO) << "DeduBB tail-call dedup: " << blocks.size()
+            << " candidate blocks, " << result.num_groups << " master group(s), "
+            << result.num_folds << " fold(s), ~" << result.bytes_saved
+            << " bytes saved; wrote " << opts.dedubb_profile_out_name();
+  LOG(INFO) << "DeduBB save-and-jump: " << sj_stats.scanned
+            << " blocks scanned; rejected: " << FormatRejects(sj_stats);
+  LOG(INFO) << "DeduBB save-and-jump, one exit: "
+            << sj_blocks.single_exit.size() << " eligible, "
+            << sj_result.num_groups << " master group(s), "
+            << sj_result.num_folds << " fold(s), ~" << sj_result.bytes_saved
+            << " bytes saved";
+  LOG(INFO) << "DeduBB save-and-jump, two exits: "
+            << sj_blocks.two_exit.size() << " eligible, "
+            << sj2_result.num_groups << " master group(s), "
+            << sj2_result.num_folds << " fold(s), ~" << sj2_result.bytes_saved
+            << " bytes saved";
+  if (tc_suffixes) {
+    LOG(INFO) << "DeduBB tail-call suffixes"
+              << (subsequence ? "" : " (estimate only)") << ": "
+              << tc_suffix_scanned << " blocks scanned, "
+              << tc_suffix_shareable << " instructions shareable, "
+              << tc_suffix.blocks << " blocks with an ending; "
+              << tc_suffix.groups.size() << " group(s), " << tc_suffix.masters
+              << " master block(s), " << tc_suffix.folds << " fold(s) ("
+              << tc_suffix.whole_blocks << " whole blocks), ~"
+              << tc_suffix.bytes_saved << " bytes saved";
+  }
+  if (subsequence_estimate && x86_64) {
+    LOG(INFO) << "DeduBB subsequence" << (subsequence ? "" : " (estimate only)")
+              << ": " << seq_stats.scanned << " instructions scanned in "
+              << seq_blocks << " blocks (" << seq_left_out_blocks
+              << " left out), " << seq_stats.red_zone_functions
+              << " red-zone function(s); rejected: "
+              << FormatRejects(seq_stats);
+    LOG(INFO) << "DeduBB subsequence: " << seq_result.runnable
+              << " instructions a master can run (" << seq_sj_runnable
+              << " by Save-and-Jump), " << seq_result.distinct
+              << " distinct, " << seq_result.repeated << " repeating; "
+              << seq_result.text_length << " symbols sorted, "
+              << seq_result.candidates << " candidate runs";
+    std::array<uint64_t, 9> by_length{};
+    for (const SubsequenceResult::Group& group : seq_result.groups)
+      ++by_length[std::min<uint32_t>(group.length, 8)];
+    std::string lengths;
+    for (size_t l = 1; l < by_length.size(); ++l)
+      absl::StrAppendFormat(&lengths, "%s%d%s:%d", lengths.empty() ? "" : " ",
+                            l, l + 1 == by_length.size() ? "+" : "",
+                            by_length[l]);
+    LOG(INFO) << "DeduBB subsequence: " << seq_result.groups.size()
+              << " master group(s), " << seq_result.copies << " copies ("
+              << seq_result.copies_with_calls << " with calls), ~"
+              << seq_result.bytes_saved << " bytes saved in .text; masters in "
+              << seq_master_modules << " module(s); groups by run length "
+              << lengths;
+    LOG(INFO) << "DeduBB subsequence, Save-and-Jump runs: "
+              << seq_result.sj_groups << " master group(s), "
+              << seq_result.sj_copies << " copies, ~"
+              << seq_result.sj_bytes_saved << " bytes saved (part of the above)";
+    const int64_t tail_call_bytes =
+        tc_suffixes ? tc_suffix.bytes_saved : result.bytes_saved;
+    LOG(INFO) << "DeduBB total with subsequence: ~"
+              << tail_call_bytes + sj_seq.bytes_saved + sj2_seq.bytes_saved +
+                     seq_result.bytes_saved
+              << " bytes in .text (tail call ~" << tail_call_bytes
+              << ", ranges ~" << seq_result.bytes_saved
+              << ", save-and-jump ~" << sj_seq.bytes_saved << " + ~"
+              << sj2_seq.bytes_saved << ")";
+    if (subsequence && call_return)
+      LOG(INFO) << "DeduBB: --dedubb_subsequence replaces "
+                   "--dedubb_call_return's whole-body directives";
+  }
+  if (!call_return_estimate) return absl::OkStatus();
+
+  int64_t eligible_with_calls = 0;
+  for (const CallReturnBlock& block : cr_blocks)
+    eligible_with_calls += !block.callees.empty();
+  // The compiler puts each module's masters in one function with one unwind
+  // table entry, about 32 bytes of .eh_frame and .eh_frame_hdr, which
+  // llvm-size counts as text.
+  constexpr int64_t kFdeBytes = 32;
+  const int64_t cr_with_fdes =
+      cr_result.bytes_saved - kFdeBytes * cr_result.num_master_modules;
+  const size_t sj_taken = sj_blocks.single_exit.size() - sj_left.size();
+  const size_t sj2_taken = sj_blocks.two_exit.size() - sj2_left.size();
+  LOG(INFO) << "DeduBB call-return" << (call_return ? "" : " (estimate only)")
+            << ": " << cr_stats.scanned << " blocks scanned, "
+            << cr_stats.red_zone_functions
+            << " red-zone function(s); rejected: " << FormatRejects(cr_stats);
+  LOG(INFO) << "DeduBB call-return, no call in the body: "
+            << cr_blocks.size() - eligible_with_calls << " eligible, "
+            << cr_result.num_groups - cr_result.num_groups_with_calls
+            << " master group(s), "
+            << cr_result.num_stubs - cr_result.num_stubs_with_calls
+            << " stub(s)";
+  LOG(INFO) << "DeduBB call-return, calls in the body: " << eligible_with_calls
+            << " eligible, " << cr_result.num_groups_with_calls
+            << " master group(s), " << cr_result.num_stubs_with_calls
+            << " stub(s)";
+  LOG(INFO) << "DeduBB call-return: ~" << cr_result.bytes_saved
+            << " bytes saved in .text; masters in "
+            << cr_result.num_master_modules << " module(s), ~" << cr_with_fdes
+            << " bytes with one FDE each";
+  LOG(INFO) << "DeduBB hybrid: call-return takes " << sj_taken
+            << " one-exit and " << sj2_taken
+            << " two-exit save-and-jump candidates; save-and-jump then saves ~"
+            << sj_hybrid.bytes_saved << " + ~" << sj2_hybrid.bytes_saved
+            << " bytes (alone: ~" << sj_alone.bytes_saved << " + ~"
+            << sj2_alone.bytes_saved << ")";
+  LOG(INFO) << "DeduBB total with call-return: ~"
+            << result.bytes_saved + sj_hybrid.bytes_saved +
+                   sj2_hybrid.bytes_saved + cr_result.bytes_saved
+            << " bytes in .text (without: ~"
+            << result.bytes_saved + sj_alone.bytes_saved +
+                   sj2_alone.bytes_saved
+            << ")";
+  // What relaxing the %rsp and %rip rules would add, with Save-and-Jump
+  // taking the blocks Call-Return leaves, as for the real directives.
+  if (opts.dedubb_call_return_estimate()) {
+    const auto total_with = [&](bool stack_base, bool rip_relative,
+                                int64_t& added) {
+      std::vector<CallReturnBlock> blocks = cr_blocks;
+      added = 0;
+      for (const RelaxedCallReturnBlock& r : cr_relaxed) {
+        if ((r.stack_base && !stack_base) || (r.rip_relative && !rip_relative))
+          continue;
+        blocks.push_back(r.block);
+        ++added;
+      }
+      const CallReturnDedupResult cr =
+          DeduplicateCallReturnBlocks(blocks, cr_options);
+      SaveAndJumpDedupOptions o1 = sj_options, o2 = sj2_options;
+      o1.first_master_id = o2.first_master_id = 0;
+      const SaveAndJumpDedupResult sj1 = DeduplicateSaveAndJumpBlocks(
+          RemoveBlocksAt(sj_blocks.single_exit, cr.stub_addresses), o1);
+      const SaveAndJumpDedupResult sj2 = DeduplicateSaveAndJumpBlocks(
+          RemoveBlocksAt(sj_blocks.two_exit, cr.stub_addresses), o2);
+      return result.bytes_saved + sj1.bytes_saved + sj2.bytes_saved +
+             cr.bytes_saved;
+    };
+    int64_t added_rsp = 0, added_rip = 0, added_both = 0;
+    const int64_t with_rsp = total_with(true, false, added_rsp);
+    const int64_t with_rip = total_with(false, true, added_rip);
+    const int64_t with_both = total_with(true, true, added_both);
+    LOG(INFO) << "DeduBB call-return headroom (estimate): %rsp-based bodies +"
+              << added_rsp << " blocks, total ~" << with_rsp
+              << " bytes; %rip-relative bodies +" << added_rip
+              << " blocks, total ~" << with_rip << " bytes; both +"
+              << added_both << " blocks, total ~" << with_both << " bytes";
+  }
+  if (!call_return)
+    LOG(INFO) << "DeduBB call-return: estimate only, no call-return "
+                 "directives written (use --dedubb_call_return)";
+  return absl::OkStatus();
+}
+
+}  // namespace propeller
