+void SubsequenceInput::AddBlock(const std::string& module_name,
+                                const std::string& function_name,
+                                uint32_t bb_id, uint64_t address,
+                                uint64_t frequency) {
+  blocks_.push_back(Block{module_name, function_name, bb_id, address, frequency,
+                          static_cast<uint32_t>(size_.size()), 0});
+}
+
+void SubsequenceInput::AddInstruction(const std::vector<uint8_t>& key,
+                                      uint8_t size, bool direct_call,
+                                      const std::string& callee,
+                                      uint8_t kinds) {
+  if (blocks_.empty()) AddBlock("", "", 0, 0, 0);
+  if (key.empty()) kinds = 0;
+  if (kinds != 0)
+    key_bytes_.insert(key_bytes_.end(), key.begin(), key.end());
+  key_begin_.push_back(key_bytes_.size());
+  size_.push_back(size);
+  direct_call_.push_back(direct_call ? 1 : 0);
+  kinds_.push_back(kinds);
+  int32_t id = -1;
+  if (!callee.empty()) {
+    const auto [it, inserted] = callee_ids_.try_emplace(
+        callee, static_cast<int32_t>(callee_names_.size()));
+    if (inserted) callee_names_.push_back(callee);
+    id = it->second;
+  }
+  callee_.push_back(id);
+  ++blocks_.back().num_insts;
+}
+
+std::vector<int32_t> BuildSuffixArray(const std::vector<int32_t>& text,
+                                      int32_t alphabet) {
+  const int32_t n = static_cast<int32_t>(text.size());
+  std::vector<int32_t> sa(n), rank(n), tmp(n);
+  if (n == 0) return sa;
+  // Prefix doubling: sort by the first symbol, then by pairs of classes of
+  // prefixes of length k, 2k, ... until every suffix has a class of its own.
+  // Each round is two stable counting sorts, so the whole is O(n log n).
+  {
+    std::vector<int32_t> count(static_cast<size_t>(alphabet) + 1, 0);
+    for (int32_t c : text) ++count[c + 1];
+    for (size_t c = 1; c < count.size(); ++c) count[c] += count[c - 1];
+    for (int32_t i = 0; i < n; ++i) sa[count[text[i]]++] = i;
+  }
+  int32_t classes = 1;
+  rank[sa[0]] = 0;
+  for (int32_t j = 1; j < n; ++j) {
+    if (text[sa[j]] != text[sa[j - 1]]) ++classes;
+    rank[sa[j]] = classes - 1;
+  }
+  std::vector<int32_t> count(static_cast<size_t>(n) + 1);
+  for (int64_t k = 1; classes < n; k <<= 1) {
+    // By the second half first: the suffixes too short to have one come
+    // first, then the others in the order of their second half's class.
+    int32_t p = 0;
+    for (int64_t i = std::max<int64_t>(0, n - k); i < n; ++i)
+      tmp[p++] = static_cast<int32_t>(i);
+    for (int32_t j = 0; j < n; ++j)
+      if (sa[j] >= k) tmp[p++] = static_cast<int32_t>(sa[j] - k);
+    // Then, stably, by the first half.
+    std::fill(count.begin(), count.begin() + classes + 1, 0);
+    for (int32_t i = 0; i < n; ++i) ++count[rank[i] + 1];
+    for (int32_t c = 1; c <= classes; ++c) count[c] += count[c - 1];
+    for (int32_t j = 0; j < n; ++j) sa[count[rank[tmp[j]]]++] = tmp[j];
+    // The classes of the prefixes of length 2k.
+    int32_t next_classes = 1;
+    tmp[sa[0]] = 0;
+    for (int32_t j = 1; j < n; ++j) {
+      const int32_t a = sa[j - 1], b = sa[j];
+      const int32_t a2 = a + k < n ? rank[a + k] : -1;
+      const int32_t b2 = b + k < n ? rank[b + k] : -1;
+      if (rank[a] != rank[b] || a2 != b2) ++next_classes;
+      tmp[b] = next_classes - 1;
+    }
+    rank.swap(tmp);
+    classes = next_classes;
+  }
+  return sa;
+}
+
+std::vector<int32_t> BuildLcpArray(const std::vector<int32_t>& text,
+                                   const std::vector<int32_t>& sa) {
+  // Kasai et al.: the LCP of a suffix with its predecessor in the suffix
+  // array drops by at most one from one text position to the next.
+  const int32_t n = static_cast<int32_t>(text.size());
+  std::vector<int32_t> rank(n), lcp(n, 0);
+  for (int32_t i = 0; i < n; ++i) rank[sa[i]] = i;
+  int32_t h = 0;
+  for (int32_t i = 0; i < n; ++i) {
+    if (rank[i] == 0) {
+      h = 0;
+      continue;
+    }
+    const int32_t j = sa[rank[i] - 1];
+    while (i + h < n && j + h < n && text[i + h] == text[j + h]) ++h;
+    lcp[rank[i]] = h;
+    if (h > 0) --h;
+  }
+  return lcp;
+}
+
+SubsequenceResult FindRepeatedRuns(const SubsequenceInput& input,
+                                   const SubsequenceOptions& options) {
+  SubsequenceResult result;
+  const size_t num_insts = input.num_instructions();
+  result.instructions = num_insts;
+
+  // Tokens: FNV-1a picks a bucket, and the bytes decide.
+  std::unordered_map<std::string_view, int32_t, KeyHash> ids;
+  std::vector<int32_t> token(num_insts, -1);
+  std::vector<uint32_t> occurrences;
+  for (size_t i = 0; i < num_insts; ++i) {
+    if (input.kinds(i) == 0) continue;
+    ++result.runnable;
+    const std::string_view key(reinterpret_cast<const char*>(input.key(i)),
+                               input.key_size(i));
+    const auto [it, inserted] =
+        ids.try_emplace(key, static_cast<int32_t>(occurrences.size()));
+    if (inserted) occurrences.push_back(0);
+    token[i] = it->second;
+    ++occurrences[it->second];
+  }
+  // Within a module only: equal keys in two modules get tokens of their own.
+  if (options.intra_module_only) {
+    std::unordered_map<std::string_view, uint64_t> module_index;
+    std::unordered_map<uint64_t, int32_t> split;  // (module, token) -> token
+    std::vector<uint32_t> split_occurrences;
+    for (const SubsequenceInput::Block& block : input.blocks()) {
+      const uint64_t module =
+          module_index.try_emplace(block.module_name, module_index.size())
+              .first->second;
+      for (uint32_t i = block.first_inst;
+           i < block.first_inst + block.num_insts; ++i) {
+        if (token[i] < 0) continue;
+        const auto [it, inserted] =
+            split.try_emplace(module << 32 | static_cast<uint32_t>(token[i]),
+                              static_cast<int32_t>(split_occurrences.size()));
+        if (inserted) split_occurrences.push_back(0);
+        token[i] = it->second;
+        ++split_occurrences[it->second];
+      }
+    }
+    occurrences = std::move(split_occurrences);
+  }
+  result.distinct = occurrences.size();
+
+  // The text: the tokens that repeat, block after block, with a barrier after
+  // each block and in place of every other instruction. Barriers are unique
+  // symbols after the tokens; consecutive ones collapse into one.
+  const int32_t num_tokens = static_cast<int32_t>(occurrences.size());
+  std::vector<int32_t> text;
+  std::vector<uint32_t> inst_at;  // The instruction at each text position.
+  text.reserve(num_insts + input.blocks().size());
+  inst_at.reserve(num_insts + input.blocks().size());
+  int32_t next_barrier = num_tokens;
+  bool after_barrier = false;
+  const auto add_barrier = [&] {
+    if (after_barrier) return;
+    text.push_back(next_barrier++);
+    inst_at.push_back(kBarrier);
+    after_barrier = true;
+  };
+  for (const SubsequenceInput::Block& block : input.blocks()) {
+    for (uint32_t i = block.first_inst; i < block.first_inst + block.num_insts;
+         ++i) {
+      if (token[i] < 0 || occurrences[token[i]] < 2) {
+        add_barrier();
+        continue;
+      }
+      ++result.repeated;
+      text.push_back(token[i]);
+      inst_at.push_back(i);
+      after_barrier = false;
+    }
+    add_barrier();
+  }
+  add_barrier();
+  result.text_length = text.size();
+  const int32_t n = static_cast<int32_t>(text.size());
+  if (result.repeated == 0) return result;
+
+  const std::vector<int32_t> sa = BuildSuffixArray(text, next_barrier);
+  const std::vector<int32_t> lcp = BuildLcpArray(text, sa);
+  // Sizes, calls, and instructions that a kind of range may not hold, before
+  // each text position, to cost a run and check a copy in O(1).
+  std::vector<uint64_t> bytes_before(static_cast<size_t>(n) + 1, 0);
+  std::vector<uint32_t> calls_before(static_cast<size_t>(n) + 1, 0);
+  std::vector<uint32_t> not_cr_before(static_cast<size_t>(n) + 1, 0);
+  std::vector<uint32_t> not_sj_before(static_cast<size_t>(n) + 1, 0);
+  for (int32_t p = 0; p < n; ++p) {
+    const uint32_t i = inst_at[p];
+    const bool instruction = i != kBarrier;
+    const uint8_t kinds = instruction ? input.kinds(i) : 0;
+    bytes_before[p + 1] = bytes_before[p] + (instruction ? input.size(i) : 0);
+    calls_before[p + 1] =
+        calls_before[p] + (instruction && input.callee(i) != nullptr ? 1 : 0);
+    not_cr_before[p + 1] =
+        not_cr_before[p] + (instruction && !(kinds & kRunCallReturn) ? 1 : 0);
+    not_sj_before[p + 1] =
+        not_sj_before[p] + (instruction && !(kinds & kRunSaveAndJump) ? 1 : 0);
+  }
+  // A Call-Return run; a Save-and-Jump one never makes calls, and saves less
+  // than a Call-Return one of the same copies would, so the former bounds
+  // both.
+  const auto benefit = [&](int64_t copies, int64_t bytes, bool with_calls) {
+    const int64_t stub =
+        with_calls ? options.stub_size_with_calls : options.stub_size;
+    return copies * (bytes - stub) - (bytes + options.master_overhead);
+  };
+  const auto sj_benefit = [&](int64_t copies, int64_t bytes) {
+    return copies * (bytes - options.sj_stub_size) -
+           (bytes + options.sj_master_overhead);
+  };
+
+  // Every repeated run is an LCP interval: the suffixes in [lb, rb] of the
+  // suffix array share their first `lcp` symbols. Walk them bottom-up with a
+  // stack (Abouelhoda, Kurtz and Ohlebusch), keeping those that could save
+  // bytes if every copy were folded.
+  std::vector<Candidate> candidates;
+  struct Open {
+    int32_t lcp;
+    int32_t lb;
+  };
+  std::vector<Open> stack = {{0, 0}};
+  for (int32_t i = 1; i <= n; ++i) {
+    const int32_t h = i < n ? lcp[i] : 0;
+    int32_t lb = i - 1;
+    while (h < stack.back().lcp) {
+      const Open top = stack.back();
+      stack.pop_back();
+      const int32_t p = sa[top.lb];
+      const uint64_t bytes = bytes_before[p + top.lcp] - bytes_before[p];
+      const bool with_calls = calls_before[p + top.lcp] != calls_before[p];
+      const int64_t copies = i - top.lb;
+      if (copies >= options.min_occurrences &&
+          benefit(copies, static_cast<int64_t>(bytes), with_calls) > 0)
+        candidates.push_back({top.lb, i - 1, static_cast<uint32_t>(top.lcp),
+                              static_cast<uint32_t>(bytes), with_calls});
+      lb = top.lb;
+    }
+    if (h > stack.back().lcp) stack.push_back({h, lb});
+  }
+  result.candidates = candidates.size();
+
+  // The copies of `c` that a range of `kind` can still fold: in text order,
+  // skipping those that hold an instruction the kind may not, and those that
+  // overlap a run taken before or the previous copy kept.
+  std::vector<uint8_t> taken(n, 0);
+  std::vector<int32_t> starts;
+  const auto keep = [&](const Candidate& c, RunKind kind,
+                        std::vector<int32_t>& kept) {
+    const std::vector<uint32_t>& banned =
+        kind == kRunCallReturn ? not_cr_before : not_sj_before;
+    starts.assign(sa.begin() + c.lb, sa.begin() + c.rb + 1);
+    std::sort(starts.begin(), starts.end());
+    kept.clear();
+    int64_t free_from = 0;
+    for (int32_t p : starts) {
+      if (p < free_from) continue;
+      if (banned[p + c.length] != banned[p]) continue;
+      bool clear = true;
+      for (uint32_t k = 0; k < c.length; ++k) {
+        if (taken[p + k]) {
+          clear = false;
+          break;
+        }
+      }
+      if (!clear) continue;
+      kept.push_back(p);
+      free_from = static_cast<int64_t>(p) + c.length;
+    }
+  };
+
+  // Lazy greedy. A candidate's saving only drops as runs are taken (each kind
+  // keeps as many copies as can be kept, and taken runs only remove copies),
+  // so the heap holds upper bounds: the one on top is costed again, with the
+  // kind that saves more, taken if it still comes first, and put back with its
+  // new saving otherwise.
+  using Entry = std::pair<int64_t, int32_t>;  // saving, -candidate
+  std::priority_queue<Entry> heap;
+  for (int32_t c = 0; c < static_cast<int32_t>(candidates.size()); ++c) {
+    const Candidate& cand = candidates[c];
+    heap.push({benefit(cand.rb - cand.lb + 1, cand.bytes, cand.with_calls), -c});
+  }
+  constexpr int64_t kNone = std::numeric_limits<int64_t>::min();
+  std::vector<int32_t> kept_cr, kept_sj;
+  while (!heap.empty()) {
+    const auto [bound, neg] = heap.top();
+    heap.pop();
+    const Candidate& c = candidates[-neg];
+    keep(c, kRunCallReturn, kept_cr);
+    int64_t saving_cr = kNone, saving_sj = kNone;
+    if (static_cast<int>(kept_cr.size()) >= options.min_occurrences)
+      saving_cr = benefit(static_cast<int64_t>(kept_cr.size()), c.bytes,
+                          c.with_calls);
+    // A Save-and-Jump master cannot make calls.
+    if (!c.with_calls) {
+      keep(c, kRunSaveAndJump, kept_sj);
+      if (static_cast<int>(kept_sj.size()) >= options.min_occurrences)
+        saving_sj = sj_benefit(static_cast<int64_t>(kept_sj.size()), c.bytes);
+    }
+    const bool sj = saving_sj > saving_cr;
+    const int64_t saving = sj ? saving_sj : saving_cr;
+    const std::vector<int32_t>& kept = sj ? kept_sj : kept_cr;
+    if (saving <= 0) continue;
+    if (!heap.empty() && saving < heap.top().first) {
+      heap.push({saving, neg});
+      continue;
+    }
+    SubsequenceResult::Group group;
+    group.length = c.length;
+    group.bytes = c.bytes;
+    group.with_calls = c.with_calls;
+    group.kind = sj ? kRunSaveAndJump : kRunCallReturn;
+    group.benefit = saving;
+    group.starts.reserve(kept.size());
+    for (int32_t p : kept) {
+      std::fill(taken.begin() + p, taken.begin() + p + c.length, 1);
+      group.starts.push_back(inst_at[p]);
+    }
+    result.copies += kept.size();
+    if (c.with_calls) result.copies_with_calls += kept.size();
+    if (sj) {
+      ++result.sj_groups;
+      result.sj_copies += kept.size();
+      result.sj_bytes_saved += saving;
+    }
+    result.bytes_saved += saving;
+    result.groups.push_back(std::move(group));
+  }
+  return result;
+}
+
+std::string FormatSubsequenceBody(const SubsequenceInput& input,
+                                  uint32_t start, uint32_t length) {
+  static constexpr char kHex[] = "0123456789abcdef";
+  std::string out;
+  for (uint32_t i = start; i < start + length; ++i) {
+    if (input.direct_call(i)) {
+      out += '.';
+      continue;
+    }
+    const uint8_t* key = input.key(i);
+    for (size_t j = 0; j < input.key_size(i); ++j) {
+      out += kHex[key[j] >> 4];
+      out += kHex[key[j] & 15];
+    }
+  }
+  return out;
+}
+
+std::vector<Directive> MakeSubsequenceDirectives(
+    const SubsequenceInput& input, const SubsequenceResult& result,
+    uint64_t first_master_id, std::vector<uint64_t>& stub_addresses,
+    int& num_master_modules) {
+  using Block = SubsequenceInput::Block;
+  const std::vector<Block>& blocks = input.blocks();
+  // The block holding instruction `i`: the last one starting at or before it
+  // (an empty block starts where the next one does, and comes before it).
+  const auto block_of = [&](uint32_t i) {
+    const auto it = std::upper_bound(
+        blocks.begin(), blocks.end(), i,
+        [](uint32_t v, const Block& b) { return v < b.first_inst; });
+    return static_cast<size_t>(it - blocks.begin()) - 1;
+  };
+  struct Copy {
+    size_t block;
+    uint32_t at;     // In the block.
+    uint32_t start;  // In the program.
+  };
+  // The order of the other kinds (BlockLess), then the place in the block.
+  const auto copy_less = [&](const Copy& a, const Copy& b) {
+    const Block& x = blocks[a.block];
+    const Block& y = blocks[b.block];
+    if (a.block != b.block) return BlockLess(x, y);
+    return a.at < b.at;
+  };
+  struct Plan {
+    const SubsequenceResult::Group* group;
+    std::vector<Copy> copies;  // The master's first.
+  };
+  std::vector<Plan> plans;
+  plans.reserve(result.groups.size());
+  for (const SubsequenceResult::Group& group : result.groups) {
+    Plan plan{&group, {}};
+    plan.copies.reserve(group.starts.size());
+    for (uint32_t start : group.starts) {
+      const size_t b = block_of(start);
+      plan.copies.push_back({b, start - blocks[b].first_inst, start});
+    }
+    std::sort(plan.copies.begin(), plan.copies.end(), copy_less);
+    plans.push_back(std::move(plan));
+  }
+  std::sort(plans.begin(), plans.end(), [&](const Plan& a, const Plan& b) {
+    return copy_less(a.copies.front(), b.copies.front());
+  });
+
+  std::vector<Directive> directives;
+  std::set<std::string> master_modules;
+  uint64_t master_id = first_master_id;
+  for (const Plan& plan : plans) {
+    const SubsequenceResult::Group& group = *plan.group;
+    const Copy& master = plan.copies.front();
+    // Every copy has the master's calls: equal keys call equal targets.
+    std::string callees;
+    for (uint32_t i = master.start; i < master.start + group.length; ++i) {
+      if (const std::string* callee = input.callee(i)) {
+        if (!callees.empty()) callees += ',';
+        callees += *callee;
+      }
+    }
+    const bool sj = group.kind == kRunSaveAndJump;
+    for (size_t k = 0; k < plan.copies.size(); ++k) {
+      const Copy& copy = plan.copies[k];
+      const Block& block = blocks[copy.block];
+      DirectiveKind kind;
+      if (sj)
+        kind = k == 0 ? DirectiveKind::kMasterSaveJump
+                      : DirectiveKind::kFoldSaveJump;
+      else
+        kind = k == 0 ? DirectiveKind::kMasterCallReturn
+                      : DirectiveKind::kFoldCallReturn;
+      Directive directive{kind, block.module_name, block.function_name,
+                          block.bb_id, master_id};
+      directive.callees = callees;
+      directive.inst_count = group.length;
+      directive.range = true;
+      directive.at = copy.at;
+      directive.block_insts = block.num_insts;
+      if (k == 0)
+        directive.body = FormatSubsequenceBody(input, copy.start, group.length);
+      directives.push_back(std::move(directive));
+      stub_addresses.push_back(block.address);
+    }
+    master_modules.insert(blocks[master.block].module_name);
+    ++master_id;
+  }
+  std::sort(directives.begin(), directives.end(),
+            [](const Directive& a, const Directive& b) {
+              return std::tie(a.module_name, a.function_name, a.bb_id, a.at) <
+                     std::tie(b.module_name, b.function_name, b.bb_id, b.at);
+            });
+  std::sort(stub_addresses.begin(), stub_addresses.end());
+  stub_addresses.erase(
+      std::unique(stub_addresses.begin(), stub_addresses.end()),
+      stub_addresses.end());
+  num_master_modules = static_cast<int>(master_modules.size());
+  return directives;
+}
+
+TailCallSuffixResult FindTailCallSuffixes(
+    const SubsequenceInput& input, const TailCallSuffixOptions& options) {
+  using Block = SubsequenceInput::Block;
+  TailCallSuffixResult result;
+  const std::vector<Block>& blocks = input.blocks();
+  const uint32_t num_blocks = static_cast<uint32_t>(blocks.size());
+
+  // Tokens: instructions with equal keys (and, within a module only, in the
+  // same module) share one.
+  std::unordered_map<std::string, int32_t> ids;
+  std::unordered_map<std::string_view, uint32_t> module_index;
+  std::string composite;
+  const auto token_of = [&](uint32_t i, uint32_t module) {
+    composite.assign(reinterpret_cast<const char*>(input.key(i)),
+                     input.key_size(i));
+    if (options.intra_module_only)
+      composite.append(reinterpret_cast<const char*>(&module), sizeof(module));
+    const int32_t next = static_cast<int32_t>(ids.size());
+    return ids.try_emplace(composite, next).first->second;
+  };
+
+  // The trie of the blocks' endings, read from the end: a node is an ending
+  // that the blocks through it share.
+  struct Node {
+    int32_t parent = -1;
+    uint32_t depth = 0;   // Instructions.
+    uint32_t bytes = 0;
+    uint32_t count = 0;   // Blocks that end with it.
+    int32_t best = -1;    // Of those, the one preferred as master.
+    int32_t master = -1;  // The master serving it, once there is one.
+  };
+  std::vector<Node> nodes(1);  // The root: the empty ending.
+  std::unordered_map<uint64_t, int32_t> child;  // (node, token) -> node
+  // Each block's nodes, from its last instruction to the start of its ending.
+  std::vector<uint32_t> path_begin(num_blocks + 1, 0);
+  std::vector<int32_t> path;
+  for (uint32_t b = 0; b < num_blocks; ++b) {
+    const Block& block = blocks[b];
+    path_begin[b] = static_cast<uint32_t>(path.size());
+    const uint32_t module =
+        options.intra_module_only
+            ? module_index
+                  .try_emplace(block.module_name,
+                               static_cast<uint32_t>(module_index.size()))
+                  .first->second
+            : 0;
+    int32_t node = 0;
+    for (uint32_t k = 0; k < block.num_insts; ++k) {
+      const uint32_t i = block.first_inst + block.num_insts - 1 - k;
+      if (input.kinds(i) == 0) break;
+      const uint64_t edge = static_cast<uint64_t>(node) << 32 |
+                            static_cast<uint32_t>(token_of(i, module));
+      const auto [it, inserted] =
+          child.try_emplace(edge, static_cast<int32_t>(nodes.size()));
+      if (inserted) {
+        Node next;
+        next.parent = node;
+        next.depth = nodes[node].depth + 1;
+        next.bytes = nodes[node].bytes + input.size(i);
+        nodes.push_back(next);
+      }
+      node = it->second;
+      Node& n = nodes[node];
+      ++n.count;
+      if (n.best < 0 || BlockLess(block, blocks[n.best]))
+        n.best = static_cast<int32_t>(b);
+      path.push_back(node);
+    }
+    if (path.size() > path_begin[b]) ++result.blocks;
+  }
+  path_begin[num_blocks] = static_cast<uint32_t>(path.size());
+
+  // Masters, deepest shared nodes first. A node whose subtree has a master
+  // already is served by it; otherwise its best block becomes one, and serves
+  // every node above too, up to one that has a master. (A master is set on a
+  // node only together with all the nodes above it.)
+  std::vector<int32_t> order(nodes.size() - 1);
+  std::iota(order.begin(), order.end(), 1);
+  std::stable_sort(order.begin(), order.end(), [&](int32_t a, int32_t b) {
+    return nodes[a].depth > nodes[b].depth;
+  });
+  std::vector<uint8_t> is_master(num_blocks, 0);
+  for (int32_t v : order) {
+    if (nodes[v].count < 2 || nodes[v].master >= 0) continue;
+    const int32_t m = nodes[v].best;
+    is_master[m] = 1;
+    for (int32_t u = v; u > 0 && nodes[u].master < 0; u = nodes[u].parent)
+      nodes[u].master = m;
+  }
+
+  // Every other block folds its deepest served ending, the longest one it
+  // shares with a master, if that saves bytes; a shallower one saves less.
+  std::unordered_map<uint64_t, uint32_t> group_of;  // (master, length)
+  std::set<int32_t> used_masters;
+  for (uint32_t b = 0; b < num_blocks; ++b) {
+    if (is_master[b]) continue;
+    for (uint32_t k = path_begin[b + 1]; k > path_begin[b]; --k) {
+      const Node& n = nodes[path[k - 1]];
+      if (n.master < 0) continue;
+      const int64_t saving = static_cast<int64_t>(n.bytes) - options.patch_size;
+      if (saving > 0) {
+        const auto [it, inserted] = group_of.try_emplace(
+            static_cast<uint64_t>(n.master) << 32 | n.depth,
+            static_cast<uint32_t>(result.groups.size()));
+        if (inserted) {
+          TailCallSuffixResult::Group group;
+          group.master = static_cast<uint32_t>(n.master);
+          group.length = n.depth;
+          group.bytes = n.bytes;
+          result.groups.push_back(std::move(group));
+          used_masters.insert(n.master);
+        }
+        TailCallSuffixResult::Group& group = result.groups[it->second];
+        group.folds.push_back(b);
+        group.benefit += saving;
+        ++result.folds;
+        if (n.depth == blocks[b].num_insts) ++result.whole_blocks;
+        result.bytes_saved += saving;
+      }
+      break;
+    }
+  }
+  result.masters = used_masters.size();
+  return result;
+}
+
+std::vector<Directive> MakeTailCallSuffixDirectives(
+    const SubsequenceInput& input, const TailCallSuffixResult& result,
+    uint64_t first_master_id) {
+  using Block = SubsequenceInput::Block;
+  using Group = TailCallSuffixResult::Group;
+  const std::vector<Block>& blocks = input.blocks();
+  std::vector<const Group*> groups;
+  groups.reserve(result.groups.size());
+  for (const Group& group : result.groups) groups.push_back(&group);
+  std::sort(groups.begin(), groups.end(), [&](const Group* a, const Group* b) {
+    if (a->master != b->master)
+      return BlockLess(blocks[a->master], blocks[b->master]);
+    return a->length > b->length;
+  });
+
+  std::vector<Directive> directives;
+  uint64_t master_id = first_master_id;
+  for (const Group* group : groups) {
+    const Block& master = blocks[group->master];
+    // Every block of the group ends with the master's calls and jumps: equal
+    // keys reach equal targets.
+    std::string callees;
+    for (uint32_t i = master.first_inst + master.num_insts - group->length;
+         i < master.first_inst + master.num_insts; ++i) {
+      if (const std::string* callee = input.callee(i)) {
+        if (!callees.empty()) callees += ',';
+        callees += *callee;
+      }
+    }
+    const auto add = [&](DirectiveKind kind, const Block& block) {
+      Directive directive{kind, block.module_name, block.function_name,
+                          block.bb_id, master_id};
+      directive.callees = callees;
+      directive.range = true;
+      directive.at = block.num_insts - group->length;
+      directive.block_insts = block.num_insts;
+      directives.push_back(std::move(directive));
+    };
+    add(DirectiveKind::kMaster, master);
+    for (uint32_t fold : group->folds) add(DirectiveKind::kFold, blocks[fold]);
+    ++master_id;
+  }
+  std::sort(directives.begin(), directives.end(),
+            [](const Directive& a, const Directive& b) {
+              return std::tie(a.module_name, a.function_name, a.bb_id, a.at) <
+                     std::tie(b.module_name, b.function_name, b.bb_id, b.at);
+            });
+  return directives;
+}
