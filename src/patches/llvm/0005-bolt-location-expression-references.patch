+void DebugLocWriter::recordExpression(DIEBuilder &Builder, DWARFUnit &Unit,
+                                      const DebugLocationEntry &Entry,
+                                      uint64_t Offset, bool Body) {
+  SmallVector<uint8_t, 32> Check;
+  if (!Builder.rewriteLocationExpression(Entry.Expr, Unit, Check, false))
+    return;
+  std::vector<uint8_t> Bytes(Entry.Expr.begin(), Entry.Expr.end());
+  Builder.addExpressionPatch([this, &Builder, &Unit, Bytes = std::move(Bytes),
+                              Offset, Body]() {
+    SmallVector<uint8_t, 32> Patched;
+    Builder.rewriteLocationExpression(Bytes, Unit, Patched, true);
+    if (Patched.size() != Bytes.size())
+      report_fatal_error("location expression size changed after DIE layout");
+    uint64_t Start = Offset + (Body ? LocBodyOffset : 0);
+    assert(Start + Patched.size() <= LocBuffer->size());
+    std::copy(Patched.begin(), Patched.end(), LocBuffer->begin() + Start);
+  });
+}
