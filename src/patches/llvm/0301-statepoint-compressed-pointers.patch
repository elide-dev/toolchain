+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; Native Image (GraalVM) patch, https://reviews.llvm.org/D150936:
+; the "compressed-pointer" GC treats addrspace(1) (absolute) and addrspace(2)
+; (heap-base-relative) pointers as GC references, and reports the live
+; addrspace(2) values a second time in the statepoint's deopt section, so the
+; stack-map reader can tell compressed references apart.
+; RUN: opt < %s -passes=rewrite-statepoints-for-gc -S | FileCheck %s
+; RUN: opt < %s -passes=rewrite-statepoints-for-gc | llc -mtriple=x86_64-linux-gnu -o /dev/null
+; RUN: opt < %s -passes=rewrite-statepoints-for-gc | llc -mtriple=aarch64-linux-gnu -o /dev/null
+
+declare void @foo()
+declare void @use(ptr addrspace(1), ptr addrspace(2))
+declare i32 @__gxx_personality_v0(...)
+
+define void @call(ptr addrspace(1) %a, ptr addrspace(2) %c) gc "compressed-pointer" {
+; CHECK-LABEL: define void @call(
+; CHECK-SAME: ptr addrspace(1) [[A:%.*]], ptr addrspace(2) [[C:%.*]]) gc "compressed-pointer" {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[STATEPOINT_TOKEN:%.*]] = call token (i64, i32, ptr, i32, i32, ...) @llvm.experimental.gc.statepoint.p0(i64 2882400000, i32 0, ptr elementtype(void ()) @foo, i32 0, i32 0, i32 0, i32 0) [ "deopt"(ptr addrspace(2) [[C]]), "gc-live"(ptr addrspace(1) [[A]], ptr addrspace(2) [[C]]) ]
+; CHECK-NEXT:    [[A_RELOCATED:%.*]] = call coldcc ptr addrspace(1) @llvm.experimental.gc.relocate.p1(token [[STATEPOINT_TOKEN]], i32 0, i32 0)
+; CHECK-NEXT:    [[C_RELOCATED:%.*]] = call coldcc ptr addrspace(2) @llvm.experimental.gc.relocate.p2(token [[STATEPOINT_TOKEN]], i32 1, i32 1)
+; CHECK-NEXT:    [[STATEPOINT_TOKEN1:%.*]] = call token (i64, i32, ptr, i32, i32, ...) @llvm.experimental.gc.statepoint.p0(i64 2882400000, i32 0, ptr elementtype(void (ptr addrspace(1), ptr addrspace(2))) @use, i32 2, i32 0, ptr addrspace(1) [[A_RELOCATED]], ptr addrspace(2) [[C_RELOCATED]], i32 0, i32 0) [ "deopt"(ptr addrspace(2) [[C_RELOCATED]]), "gc-live"(ptr addrspace(1) [[A_RELOCATED]], ptr addrspace(2) [[C_RELOCATED]]) ]
+; CHECK-NEXT:    [[A_RELOCATED2:%.*]] = call coldcc ptr addrspace(1) @llvm.experimental.gc.relocate.p1(token [[STATEPOINT_TOKEN1]], i32 0, i32 0)
+; CHECK-NEXT:    [[C_RELOCATED3:%.*]] = call coldcc ptr addrspace(2) @llvm.experimental.gc.relocate.p2(token [[STATEPOINT_TOKEN1]], i32 1, i32 1)
+; CHECK-NEXT:    ret void
