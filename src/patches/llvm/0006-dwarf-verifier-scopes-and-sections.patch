diff --git a/llvm/unittests/DebugInfo/DWARF/DWARFVerifierTest.cpp b/llvm/unittests/DebugInfo/DWARF/DWARFVerifierTest.cpp
index 9fabc18..cf87c25 100644
--- a/llvm/unittests/DebugInfo/DWARF/DWARFVerifierTest.cpp
+++ b/llvm/unittests/DebugInfo/DWARF/DWARFVerifierTest.cpp
@@ -119,4 +119,37 @@ TEST(DWARFVerifierTest, InsertRandomOrderNoOverlap) {
   EXPECT_EQ(Parent.Children.size(), 4u);
 }
 
+TEST(DWARFVerifierTest, ContainsRangesInSeparateSections) {
+  DieRangeInfo Parent({{10, 30, 1}, {0, 10, 2}, {10, 20, 2}});
+  EXPECT_TRUE(Parent.contains(DieRangeInfo({{15, 20, 1}, {5, 15, 2}})));
+  EXPECT_FALSE(Parent.contains(DieRangeInfo({{5, 15, 1}})));
+  EXPECT_FALSE(Parent.contains(DieRangeInfo({{5, 15, 3}})));
+  EXPECT_FALSE(
+      DieRangeInfo({{0, 100, 1}}).contains(DieRangeInfo({{5, 10, 2}})));
+}
+
+TEST(DWARFVerifierTest, IntersectsRangesInSeparateSections) {
+  DieRangeInfo Left({{100, 200, 1}, {0, 10, 2}});
+  EXPECT_TRUE(Left.intersects(DieRangeInfo({{50, 60, 1}, {5, 15, 2}})));
+  EXPECT_FALSE(Left.intersects(DieRangeInfo({{0, 10, 1}, {100, 200, 2}})));
+  EXPECT_FALSE(Left.intersects(Left));
+}
+
+TEST(DWARFVerifierTest, DiscontiguousChildrenOverlap) {
+  DieRangeInfo Parent;
+  EXPECT_EQ(Parent.insert(DieRangeInfo({{0, 1}, {10, 11}})),
+            Parent.Children.end());
+  EXPECT_EQ(Parent.insert(makeRI(2, 3)), Parent.Children.end());
+  EXPECT_NE(Parent.insert(makeRI(10, 12)), Parent.Children.end());
+  EXPECT_EQ(Parent.insert(DieRangeInfo({{10, 11}, {20, 21}})),
+            Parent.Children.end());
+  EXPECT_NE(Parent.insert(makeRI(20, 22)), Parent.Children.end());
+  EXPECT_EQ(Parent.insert(makeRI(3, 10)), Parent.Children.end());
+  DieRangeInfo Copy = Parent;
+  EXPECT_NE(Copy.insert(makeRI(10, 12)), Copy.Children.end());
+  DieRangeInfo Assigned;
+  Assigned = Parent;
+  EXPECT_NE(Assigned.insert(makeRI(20, 22)), Assigned.Children.end());
+}
+
 } // namespace
