--- /dev/null
+++ b/llvm/test/tools/llvm-dwarfdump/X86/callsite-in-inline-scope.yaml
@@ -0,0 +1,117 @@
+## Call sites may be nested in inline scopes, but must still have an
+## enclosing subprogram definition and valid references. Completeness flags are optional.
+# RUN: yaml2obj %s -o %t
+# RUN: llvm-dwarfdump --verify %t | FileCheck %s --check-prefix=GOOD
+# RUN: sed 's/DW_TAG_inlined_subroutine/DW_TAG_structure_type/' %s | yaml2obj -o %t.scope
+# RUN: not llvm-dwarfdump --verify %t.scope 2>&1 | FileCheck %s --check-prefix=SCOPE
+# RUN: sed 's/DW_AT_call_all_calls/DW_AT_artificial/' %s | yaml2obj -o %t.coverage
+# RUN: llvm-dwarfdump --verify %t.coverage 2>&1 | FileCheck %s --check-prefix=GOOD
+# RUN: sed 's/0x0000000000000015/0x000000000000ffff/g' %s | yaml2obj -o %t.ref
+# RUN: not llvm-dwarfdump --verify %t.ref 2>&1 | FileCheck %s --check-prefix=REFERENCE
+# RUN: sed 's/DW_AT_call_all_calls/DW_AT_declaration/' %s | yaml2obj -o %t.decl
+# RUN: not llvm-dwarfdump --verify %t.decl 2>&1 | FileCheck %s --check-prefix=DECL
+# RUN: sed -e 's/DW_AT_low_pc/DW_AT_entry_pc/g' -e 's/DW_AT_high_pc/DW_AT_byte_size/g' %s | yaml2obj -o %t.no-ranges
+# RUN: llvm-dwarfdump --verify %t.no-ranges | FileCheck %s --check-prefix=GOOD
+# DECL: error: Call site entry not nested within a valid subprogram:
+# GOOD: No errors.
+# SCOPE: error: Call site entry nested within invalid source scope:
+# REFERENCE: error:
+# REFERENCE: Errors detected.
+
+--- !ELF
+FileHeader:
+  Class:   ELFCLASS64
+  Data:    ELFDATA2LSB
+  Type:    ET_EXEC
+  Machine: EM_X86_64
+DWARF:
+  debug_str:
+    - "callee"
+    - "caller"
+
+  debug_abbrev:
+    - Table:
+      - Code:            0x00000001
+        Tag:             DW_TAG_compile_unit
+        Children:        DW_CHILDREN_yes
+        Attributes:
+          - Attribute:       DW_AT_low_pc
+            Form:            DW_FORM_addr
+      - Code:            0x00000002
+        Tag:             DW_TAG_subprogram
+        Children:        DW_CHILDREN_no
+        Attributes:
+          - Attribute:       DW_AT_name
+            Form:            DW_FORM_strp
+          - Attribute:       DW_AT_low_pc
+            Form:            DW_FORM_addr
+          - Attribute:       DW_AT_high_pc
+            Form:            DW_FORM_data4
+      - Code:            0x00000003
+        Tag:             DW_TAG_subprogram
+        Children:        DW_CHILDREN_yes
+        Attributes:
+          - Attribute:       DW_AT_name
+            Form:            DW_FORM_strp
+          - Attribute:       DW_AT_low_pc
+            Form:            DW_FORM_addr
+          - Attribute:       DW_AT_high_pc
+            Form:            DW_FORM_data4
+          - Attribute:       DW_AT_call_all_calls
+            Form:            DW_FORM_flag_present
+      - Code:            0x00000004
+        Tag:             DW_TAG_inlined_subroutine
+        Children:        DW_CHILDREN_yes
+        Attributes:
+          - Attribute:       DW_AT_low_pc
+            Form:            DW_FORM_addr
+          - Attribute:       DW_AT_high_pc
+            Form:            DW_FORM_data4
+          - Attribute:       DW_AT_abstract_origin
+            Form:            DW_FORM_ref4
+      - Code:            0x00000005
+        Tag:             DW_TAG_call_site
+        Children:        DW_CHILDREN_no
+        Attributes:
+          - Attribute:       DW_AT_call_origin
+            Form:            DW_FORM_ref4
+
+  debug_info:
+    - Version:         5
+      UnitType:        DW_UT_compile
+      AbbrOffset:      0x00000000
+      AddrSize:        8
+      Entries:
+        # DW_TAG_compile_unit
+        - AbbrCode:    0x00000001
+          Values:
+            - Value:   0x0000000000000000   # DW_AT_low_pc
+        # DW_TAG_subprogram (callee) - offset will be 0x0c + some bytes
+        - AbbrCode:    0x00000002
+          Values:
+            - Value:   0x0000000000000000   # DW_AT_name -> "callee"
+            - Value:   0x0000000000003000   # DW_AT_low_pc
+            - Value:   0x0000000000000010   # DW_AT_high_pc
+        # DW_TAG_subprogram (caller, with DW_AT_call_all_calls)
+        - AbbrCode:    0x00000003
+          Values:
+            - Value:   0x0000000000000007   # DW_AT_name -> "caller"
+            - Value:   0x0000000000001000   # DW_AT_low_pc
+            - Value:   0x0000000000000100   # DW_AT_high_pc
+        # DW_TAG_lexical_block (child of caller)
+        - AbbrCode:    0x00000004
+          Values:
+            - Value:   0x0000000000001000   # DW_AT_low_pc
+            - Value:   0x0000000000000080   # DW_AT_high_pc
+            - Value:   0x0000000000000015   # DW_AT_abstract_origin
+        # DW_TAG_call_site (child of lexical_block)
+        - AbbrCode:    0x00000005
+          Values:
+            - Value:   0x0000000000000015   # DW_AT_call_origin -> callee subprogram
+        - AbbrCode:    0x00000000           # end lexical_block
+          Values:      []
+        - AbbrCode:    0x00000000           # end caller subprogram
+          Values:      []
+        - AbbrCode:    0x00000000           # end compile_unit
+          Values:      []
+...
