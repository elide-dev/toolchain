# local: Linux in-process LTO links read fat-object bitcode by default.
#   Index-only links keep native archive members for distributed ThinLTO.
#   Tracked in https://github.com/elide-dev/toolchain/issues/13
#   and https://github.com/elide-dev/toolchain/issues/18
diff --git a/clang/lib/Driver/ToolChains/CommonArgs.cpp b/clang/lib/Driver/ToolChains/CommonArgs.cpp
index 08c06951cf22..41ff8f891e37 100644
--- a/clang/lib/Driver/ToolChains/CommonArgs.cpp
+++ b/clang/lib/Driver/ToolChains/CommonArgs.cpp
@@ -1013,6 +1013,24 @@ void tools::addDTLTOOptions(const ToolChain &ToolChain, const ArgList &Args,
   }
 }

+// Distributed ThinLTO backends cannot consume archive-member paths in .imports
+// files. Recognize both lld's spelling and its plugin-opt alias, forwarded through
+// either -Wl, or -Xlinker. Do not claim the arguments: the linker still needs them.
+static bool isThinLTOIndexOnly(const ArgList &Args) {
+  for (const Arg *A : Args.filtered(options::OPT_Wl_COMMA, options::OPT_Xlinker)) {
+    for (StringRef Value : A->getValues()) {
+      if (!Value.consume_front("-"))
+        continue;
+      Value.consume_front("-");
+      Value.consume_front("plugin-opt=");
+      if (Value == "thinlto-index-only" ||
+          Value.starts_with("thinlto-index-only="))
+        return true;
+    }
+  }
+  return false;
+}
+
 void tools::addLTOOptions(const ToolChain &ToolChain, const ArgList &Args,
                           ArgStringList &CmdArgs, const InputInfo &Output,
                           const InputInfoList &Inputs, bool IsThinLTO) {
@@ -1022,8 +1040,14 @@ void tools::addLTOOptions(const ToolChain &ToolChain, const ArgList &Args,
   StringRef Linker = Args.getLastArgValue(options::OPT_fuse_ld_EQ);
   const char *LinkerPath = Args.MakeArgString(ToolChain.GetLinkerPath());
   const Driver &D = ToolChain.getDriver();
+  // Elide: the Linux sysroot and runtime archives are fat LTO objects, so a
+  // Linux in-process LTO link reads their bitcode by default. Index-only links
+  // keep the native archive members for distributed backends (e.g. Bazel).
+  // Explicit -f[no-]fat-lto-objects still overrides either default.
   const bool IsFatLTO = Args.hasFlag(options::OPT_ffat_lto_objects,
-                                     options::OPT_fno_fat_lto_objects, false);
+                                     options::OPT_fno_fat_lto_objects,
+                                     Triple.isOSLinux() &&
+                                         !isThinLTOIndexOnly(Args));
   const bool IsUnifiedLTO = Args.hasArg(options::OPT_funified_lto);

   assert(!Inputs.empty() && "Must have at least one input.");
diff --git a/clang/test/Driver/elide-fat-lto-objects-default.c b/clang/test/Driver/elide-fat-lto-objects-default.c
new file mode 100644
index 000000000000..37e9f6862bec
--- /dev/null
+++ b/clang/test/Driver/elide-fat-lto-objects-default.c
@@ -0,0 +1,51 @@
+/// Elide: a Linux LTO link passes --fat-lto-objects to lld by default, so the
+/// fat sysroot and runtime archives contribute bitcode. -fno-fat-lto-objects
+/// opts out; index-only links, non-LTO links and non-Linux targets are unchanged.
+// RUN: %clang --target=x86_64-unknown-linux-gnu --sysroot=%S/Inputs/basic_cross_linux_tree %s \
+// RUN:   -fuse-ld=lld -flto=thin -### 2>&1 | FileCheck --check-prefix=FAT %s
+// RUN: %clang --target=aarch64-unknown-linux-musl --sysroot=%S/Inputs/basic_cross_linux_tree %s \
+// RUN:   -fuse-ld=lld -flto -### 2>&1 | FileCheck --check-prefix=FAT %s
+// RUN: %clang --target=x86_64-unknown-linux-gnu --sysroot=%S/Inputs/basic_cross_linux_tree %s \
+// RUN:   -fuse-ld=lld -flto=thin -fno-fat-lto-objects -### 2>&1 | FileCheck --check-prefix=NOFAT %s
+// RUN: %clang --target=x86_64-unknown-linux-gnu --sysroot=%S/Inputs/basic_cross_linux_tree %s \
+// RUN:   -fuse-ld=lld -### 2>&1 | FileCheck --check-prefix=NOFAT %s
+// RUN: %clang --target=x86_64-unknown-freebsd -fuse-ld=lld -flto=thin -### %s 2>&1 \
+// RUN:   | FileCheck --check-prefix=NOFAT %s
+
+/// Bazel's distributed ThinLTO index must not import from fat archive members.
+/// Cover lld/plugin spellings, with and without an index path, and both forwarding forms.
+// RUN: %clang --target=x86_64-unknown-linux-gnu -fuse-ld=lld -flto=thin -### %s \
+// RUN:   -Wl,-plugin-opt=thinlto-index-only=out.index,-plugin-opt=thinlto-emit-imports-files 2>&1 | FileCheck --check-prefix=NOFAT %s
+// RUN: %clang --target=aarch64-unknown-linux-musl -fuse-ld=lld -flto=thin -### %s \
+// RUN:   -Wl,--plugin-opt=thinlto-index-only 2>&1 | FileCheck --check-prefix=NOFAT %s
+// RUN: %clang --target=x86_64-unknown-linux-gnu -fuse-ld=lld -flto=thin -### %s \
+// RUN:   -Wl,--thinlto-index-only=out.index 2>&1 | FileCheck --check-prefix=NOFAT %s
+// RUN: %clang --target=x86_64-unknown-linux-musl -fuse-ld=lld -flto=thin -### %s \
+// RUN:   -Wl,--thinlto-index-only 2>&1 | FileCheck --check-prefix=NOFAT %s
+// RUN: %clang --target=x86_64-unknown-linux-gnu -fuse-ld=lld -flto=thin -### %s \
+// RUN:   -Xlinker -plugin-opt=thinlto-index-only=out.index 2>&1 | FileCheck --check-prefix=NOFAT %s
+// RUN: %clang --target=aarch64-unknown-linux-gnu -fuse-ld=lld -flto=thin -### %s \
+// RUN:   -Xlinker --thinlto-index-only 2>&1 | FileCheck --check-prefix=NOFAT %s
+/// Driver response files are expanded before deciding the default.
+// RUN: echo '-fuse-ld=lld -flto=thin -Wl,--thinlto-index-only=out.index' > %t.rsp
+// RUN: %clang --target=x86_64-unknown-linux-gnu @%t.rsp -### %s 2>&1 | FileCheck --check-prefix=NOFAT %s
+/// Explicit opt-in still wins, even for index-only links.
+// RUN: %clang --target=x86_64-unknown-linux-gnu -fuse-ld=lld -flto=thin -### %s \
+// RUN:   -Wl,--thinlto-index-only -ffat-lto-objects 2>&1 | FileCheck --check-prefix=FAT %s
+/// Emitting index/import files during an in-process link must retain the default.
+// RUN: %clang --target=x86_64-unknown-linux-gnu -fuse-ld=lld -flto=thin -### %s \
+// RUN:   -Wl,--thinlto-emit-index-files,--thinlto-emit-imports-files 2>&1 | FileCheck --check-prefix=FAT %s
+/// A path containing the option's name is not the option.
+// RUN: %clang --target=x86_64-unknown-linux-gnu -fuse-ld=lld -flto=thin -### %s \
+// RUN:   -Wl,-rpath,thinlto-index-only 2>&1 | FileCheck --check-prefix=FAT %s
+
+/// Compiles keep emitting plain (non-fat) bitcode unless -ffat-lto-objects is given.
+// RUN: %clang --target=x86_64-unknown-linux-gnu -flto=thin -### -c %s 2>&1 \
+// RUN:   | FileCheck --check-prefix=CC %s
+
+// FAT: "--fat-lto-objects"
+// NOFAT-NOT: "--fat-lto-objects"
+// NOFAT: "{{.*}}ld.lld"
+// NOFAT-NOT: "--fat-lto-objects"
+// CC: "-cc1"
+// CC-NOT: "-ffat-lto-objects"
