+++ b/llvm/test/CodeGen/AArch64/dedubb.ll
@@ -0,0 +1,27 @@
+; AArch64 version of the DeduBB tail-call deduplication test. The fold is
+; realized as a TCRETURNdi (tail branch), which the assembler emits as `b`.
+;
+; NOTE: exact assembly spelling may vary; checks are intentionally loose around
+; the symbol reference.
+
+; RUN: printf 'm test.c\nf master_fn\nbbm 0 (DeduBB.master.7)\nf fold_fn\nbbf 0 (DeduBB.master.7)\n' > %t.dir
+; RUN: llc -mtriple=aarch64-unknown-linux-gnu -basic-block-address-map \
+; RUN:     -dedubb-directives=%t.dir < %s | FileCheck %s
+
+define i32 @master_fn() {
+entry:
+  ret i32 42
+}
+
+; CHECK-LABEL: master_fn:
+; CHECK: .globl DeduBB.master.7
+; CHECK: DeduBB.master.7:
+
+define i32 @fold_fn() {
+entry:
+  ret i32 42
+}
+
+; CHECK-LABEL: fold_fn:
+; CHECK: b DeduBB.master.7
+; CHECK-NOT: ret
diff --git a/llvm/test/CodeGen/X86/dedubb-call-return-ranges.ll b/llvm/test/CodeGen/X86/dedubb-call-return-ranges.ll
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/X86/dedubb-call-return-ranges.ll
@@ -0,0 +1,264 @@
+; Tests Call-Return folds of ranges (`at=`, `block_insts=`): a run of
+; instructions inside a block, not its whole body, becomes a call to a master
+; emitted from the directive's bytes, and the rest of the block stays in place.
+
+; RUN: rm -rf %t && split-file %s %t
+; RUN: llc -mtriple=x86_64-unknown-linux-gnu -O2 -relocation-model=pic \
+; RUN:   -basic-block-address-map -verify-machineinstrs \
+; RUN:   -dedubb-directives=%t/d.txt %t/a.ll -o - | FileCheck %s
+
+; A master calls a callee by a name that means it in every module if its
+; module knows one, else by one of the module's local functions, else by a
+; name the module does not use; one the module uses for something else is an
+; error.
+; RUN: llc -mtriple=x86_64-unknown-linux-gnu -O2 -relocation-model=pic \
+; RUN:   -basic-block-address-map -verify-machineinstrs \
+; RUN:   -dedubb-directives=%t/names.txt %t/names.ll -o - \
+; RUN:   | FileCheck %s --check-prefix=NAMES
+; RUN: not llc -mtriple=x86_64-unknown-linux-gnu -O2 -relocation-model=pic \
+; RUN:   -basic-block-address-map -dedubb-directives=%t/var.txt \
+; RUN:   %t/names.ll -o /dev/null 2>&1 | FileCheck %s --check-prefix=VAR
+
+; The master's own copy is replaced too.
+; CHECK-LABEL: m_mid:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  callq DeduBB.master.cr.1
+; CHECK-NEXT:  {{^\.LBB[0-9]+_0_CS0}}:
+; CHECK-NEXT:  movq %rax, (%rsi)
+; CHECK-NEXT:  retq
+
+; A range after an instruction of the block's own.
+; CHECK-LABEL: f_mid:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  movq $7, (%rsi)
+; CHECK-NEXT:  callq DeduBB.master.cr.1
+; CHECK-NEXT:  {{^\.LBB[0-9]+_0_CS0}}:
+; CHECK-NEXT:  movq %rax, (%rsi)
+; CHECK-NEXT:  retq
+
+; Two ranges in one block, one of them a master's.
+; CHECK-LABEL: f_two:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  callq DeduBB.master.cr.1
+; CHECK-NEXT:  {{^\.LBB[0-9]+_0_CS0}}:
+; CHECK-NEXT:  movq %rax, (%rsi)
+; CHECK-NEXT:  callq DeduBB.master.cr.2
+; CHECK-NEXT:  {{^\.LBB[0-9]+_0_CS1}}:
+; CHECK-NEXT:  movq %rcx, (%rdi)
+; CHECK-NEXT:  retq
+
+; A range with a call in the entry block, after the prologue: the stub keeps
+; the stack aligned for the call, and its CFI accounts for that.
+; CHECK-LABEL: c_call:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  pushq %rax
+; CHECK-NEXT:  .cfi_def_cfa_offset 16
+; CHECK-NEXT:  pushq %rax
+; CHECK-NEXT:  .cfi_adjust_cfa_offset 8
+; CHECK-NEXT:  callq DeduBB.master.cr.3
+; CHECK-NEXT:  {{^\.LBB[0-9]+_0_CS0}}:
+; CHECK-NEXT:  leaq 8(%rsp), %rsp
+; CHECK-NEXT:  .cfi_adjust_cfa_offset -8
+; CHECK-NEXT:  popq %rcx
+; CHECK-NEXT:  .cfi_def_cfa_offset 8
+; CHECK-NEXT:  retq
+
+; The block holds 6 instructions, not the directive's 7: left as is.
+; CHECK-LABEL: f_count:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  movq $7, (%rsi)
+; CHECK-NEXT:  movabsq $-7046029254386353131, %rax
+; CHECK-NEXT:  imulq (%rdi), %rax
+; CHECK-NEXT:  xorq $12345, %rax
+
+; A range that holds the prologue's push: left as is.
+; CHECK-LABEL: c_prologue:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  pushq %rax
+; CHECK-NEXT:  .cfi_def_cfa_offset 16
+; CHECK-NEXT:  leaq (%rdi,%rdi,2), %rdi
+; CHECK-NEXT:  callq work@PLT
+
+; A range whose call is not the directive's callee: left as is.
+; CHECK-LABEL: c_callee:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  pushq %rax
+; CHECK-NEXT:  .cfi_def_cfa_offset 16
+; CHECK-NEXT:  leaq (%rdi,%rdi,2), %rdi
+; CHECK-NEXT:  callq work@PLT
+
+; Of two overlapping ranges, only the first is folded.
+; CHECK-LABEL: f_overlap:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  movq $7, (%rsi)
+; CHECK-NEXT:  callq DeduBB.master.cr.1
+; CHECK-NEXT:  {{^\.LBB[0-9]+_0_CS0}}:
+; CHECK-NEXT:  movq %rax, (%rsi)
+; CHECK-NEXT:  retq
+
+; The masters, from the directives' bytes, with their calls made by name.
+; CHECK-LABEL: DeduBB.cr.masters:
+; CHECK:       DeduBB.master.cr.1:
+; CHECK-NEXT:  #APP
+; CHECK-NEXT:  .byte 72
+; CHECK-NEXT:  .byte 184
+; CHECK-COUNT-18: .byte
+; CHECK-NEXT:  #NO_APP
+; CHECK-NEXT:  retq
+; CHECK:       DeduBB.master.cr.2:
+; CHECK-NEXT:  #APP
+; CHECK-COUNT-27: .byte
+; CHECK-NEXT:  #NO_APP
+; CHECK-NEXT:  retq
+; CHECK:       DeduBB.master.cr.3:
+; CHECK-NEXT:  #APP
+; CHECK-COUNT-4: .byte
+; CHECK-NEXT:  #NO_APP
+; CHECK-NEXT:  callq work@PLT
+; CHECK-NEXT:  {{^\.LBB[0-9]+_2_CS0}}:
+; CHECK-NEXT:  #APP
+; CHECK-COUNT-4: .byte
+; CHECK-NEXT:  #NO_APP
+; CHECK-NEXT:  retq
+
+; `shadow` is a local function of this module, so it may be another function
+; than the callee named `shadow` elsewhere: `ext` is called.
+; NAMES-LABEL: DeduBB.cr.masters:
+; NAMES:       DeduBB.master.cr.1:
+; NAMES-NEXT:  callq ext@PLT
+; NAMES:       DeduBB.master.cr.2:
+; NAMES-NEXT:  callq mine{{$}}
+; NAMES:       DeduBB.master.cr.3:
+; NAMES-NEXT:  callq runtime_helper@PLT
+; NAMES:       DeduBB.master.cr.4:
+; NAMES-NEXT:  callq other_name@PLT
+
+; VAR: LLVM ERROR: DeduBB: master DeduBB.master.cr.5 cannot call 'table': the module holds something else of that name
+
+;--- d.txt
+m test.c
+f m_mid
+bbmcr 0 (DeduBB.master.cr.1) callees= insts=3 at=0 block_insts=5 body=48b8157c4a7fb979379e480faf07483539300000
+f f_mid
+bbfcr 0 (DeduBB.master.cr.1) callees= insts=3 at=1 block_insts=6
+f f_two
+bbfcr 0 (DeduBB.master.cr.1) callees= insts=3 at=0 block_insts=10
+bbmcr 0 (DeduBB.master.cr.2) callees= insts=4 at=4 block_insts=10 body=48b82d7f954c2df45158480faf0648b94f8167f77e7b05144801c1
+f c_call
+bbmcr 0 (DeduBB.master.cr.3) callees=work insts=3 at=1 block_insts=6 body=488d3c7f.4883c005
+f f_count
+bbfcr 0 (DeduBB.master.cr.1) callees= insts=3 at=1 block_insts=7
+f c_prologue
+bbfcr 0 (DeduBB.master.cr.3) callees=work insts=3 at=0 block_insts=6
+f c_callee
+bbfcr 0 (DeduBB.master.cr.3) callees=other insts=3 at=1 block_insts=6
+f f_overlap
+bbfcr 0 (DeduBB.master.cr.1) callees= insts=3 at=1 block_insts=6
+bbfcr 0 (DeduBB.master.cr.2) callees= insts=2 at=2 block_insts=6
+;--- names.txt
+f holder
+bbmcr 0 (DeduBB.master.cr.1) callees=shadow|ext insts=1 at=0 block_insts=9 body=.
+bbmcr 0 (DeduBB.master.cr.2) callees=mine insts=1 at=1 block_insts=9 body=.
+bbmcr 0 (DeduBB.master.cr.3) callees=runtime_helper insts=1 at=2 block_insts=9 body=.
+bbmcr 0 (DeduBB.master.cr.4) callees=table|other_name insts=1 at=3 block_insts=9 body=.
+;--- var.txt
+f holder
+bbmcr 0 (DeduBB.master.cr.5) callees=table insts=1 at=0 block_insts=9 body=.
+;--- names.ll
+@table = global i32 0
+declare void @ext()
+
+define internal void @shadow() {
+  store volatile i32 1, ptr @table
+  ret void
+}
+
+define internal void @mine() {
+  store volatile i32 2, ptr @table
+  ret void
+}
+
+define void @holder() {
+  call void @shadow()
+  call void @mine()
+  call void @ext()
+  ret void
+}
+;--- a.ll
+declare i64 @work(i64)
+
+; The first run's master: the load-multiply-mix at the start of the block.
+define void @m_mid(ptr %p, ptr %q) {
+  %v = load volatile i64, ptr %p
+  %w = mul i64 %v, -7046029254386353131
+  %z = xor i64 %w, 12345
+  store volatile i64 %z, ptr %q
+  ret void
+}
+
+; The same run after a store of its own.
+define void @f_mid(ptr %p, ptr %q) {
+  store volatile i64 7, ptr %q
+  %v = load volatile i64, ptr %p
+  %w = mul i64 %v, -7046029254386353131
+  %z = xor i64 %w, 12345
+  store volatile i64 %z, ptr %q
+  ret void
+}
+
+; Two runs in one block: the first run, and the master of a second one.
+define void @f_two(ptr %p, ptr %q) {
+  %v = load volatile i64, ptr %p
+  %w = mul i64 %v, -7046029254386353131
+  %z = xor i64 %w, 12345
+  store volatile i64 %z, ptr %q
+  %v2 = load volatile i64, ptr %q
+  %w2 = mul i64 %v2, 6364136223846793005
+  %z2 = add i64 %w2, 1442695040888963407
+  store volatile i64 %z2, ptr %p
+  ret void
+}
+
+; A run with a call, after the prologue of the entry block.
+define i64 @c_call(i64 %x) {
+  %a = mul i64 %x, 3
+  %r = call i64 @work(i64 %a)
+  %s = add i64 %r, 5
+  ret i64 %s
+}
+
+; The directive counts 7 instructions in this block, which has 6.
+define void @f_count(ptr %p, ptr %q) {
+  store volatile i64 7, ptr %q
+  %v = load volatile i64, ptr %p
+  %w = mul i64 %v, -7046029254386353131
+  %z = xor i64 %w, 12345
+  store volatile i64 %z, ptr %q
+  ret void
+}
+
+; The directive's range starts with the prologue's push.
+define i64 @c_prologue(i64 %x) {
+  %a = mul i64 %x, 3
+  %r = call i64 @work(i64 %a)
+  %s = add i64 %r, 5
+  ret i64 %s
+}
+
+; The directive names another callee.
+define i64 @c_callee(i64 %x) {
+  %a = mul i64 %x, 3
+  %r = call i64 @work(i64 %a)
+  %s = add i64 %r, 5
+  ret i64 %s
+}
+
+; Two directives whose ranges overlap: the first is folded, the second not.
+define void @f_overlap(ptr %p, ptr %q) {
+  store volatile i64 7, ptr %q
+  %v = load volatile i64, ptr %p
+  %w = mul i64 %v, -7046029254386353131
+  %z = xor i64 %w, 12345
+  store volatile i64 %z, ptr %q
+  ret void
+}
diff --git a/llvm/test/CodeGen/X86/dedubb-call-return.ll b/llvm/test/CodeGen/X86/dedubb-call-return.ll
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/X86/dedubb-call-return.ll
@@ -0,0 +1,571 @@
+; DeduBB Call-Return folds (bbmcr/bbfcr). Every block of a group calls one
+; master, which is emitted from the directive's bytes into DeduBB.cr.masters.
+; A block keeps its body unless its instructions match the directive (the
+; instruction count and the callees) and its function can take the stub.
+; RUN: rm -rf %t && split-file %s %t
+; RUN: llc -mtriple=x86_64-unknown-linux-gnu -O2 -relocation-model=pic \
+; RUN:   -basic-block-address-map -enable-shrink-wrap=false \
+; RUN:   -verify-machineinstrs -dedubb-directives=%t/d.txt %t/a.ll -o - \
+; RUN:   | FileCheck %s
+;
+; A directive file with a malformed Call-Return line drops them all, so that
+; no block calls a master that is not emitted.
+; RUN: llc -mtriple=x86_64-unknown-linux-gnu -O2 -relocation-model=pic \
+; RUN:   -basic-block-address-map -verify-machineinstrs \
+; RUN:   -dedubb-directives=%t/bad.txt %t/a.ll -o - 2>%t/bad.err \
+; RUN:   | FileCheck %s --check-prefix=BAD
+; RUN: FileCheck %s --check-prefix=BADERR < %t/bad.err
+;
+; With a frame pointer the CFA is %rbp-based wherever a call is made, even
+; when shrink-wrapping sinks the prologue (here into `work`): a body with calls
+; calls its master without CFI.
+; RUN: llc -mtriple=x86_64-unknown-linux-gnu -O2 -relocation-model=pic \
+; RUN:   -basic-block-address-map -verify-machineinstrs \
+; RUN:   -dedubb-directives=%t/sw.txt %t/sw.ll -o - | FileCheck %s --check-prefix=SW
+
+; A body without calls: both blocks call the master.
+; CHECK-LABEL: cr0_master:
+; CHECK:       {{^\.LBB[0-9]+_1}}:
+; CHECK-NEXT:  callq DeduBB.master.cr.7
+; CHECK-LABEL: cr0_fold:
+; CHECK:       {{^\.LBB[0-9]+_1}}:
+; CHECK-NEXT:  callq DeduBB.master.cr.7
+; The directive counts another number of instructions: the body stays.
+; CHECK-LABEL: cr0_count:
+; CHECK:       {{^\.LBB[0-9]+_1}}:
+; CHECK-NEXT:  movl %eax, %ecx
+; CHECK-NEXT:  imull %esi, %ecx
+; The function keeps data in the red zone, where the call would write.
+; CHECK-LABEL: rz_fold:
+; CHECK:       {{^\.LBB[0-9]+_1}}:
+; CHECK-NEXT:  movl %eax, %ecx
+; CHECK-NEXT:  imull %esi, %ecx
+
+; A body with a call is entered with 16 bytes pushed; without a frame pointer
+; the CFA is %rsp-based, so CFI describes the padding.
+; CHECK-LABEL: cr1_master:
+; CHECK:       {{^\.LBB[0-9]+_1}}:
+; CHECK-NEXT:  pushq %rax
+; CHECK-NEXT:  .cfi_adjust_cfa_offset 8
+; CHECK-NEXT:  callq DeduBB.master.cr.8
+; CHECK-NEXT:  {{^\.LBB[0-9]+_1_CS0}}:
+; CHECK-NEXT:  leaq 8(%rsp), %rsp
+; CHECK-NEXT:  .cfi_adjust_cfa_offset -8
+; CHECK-LABEL: cr1_fold:
+; CHECK:       {{^\.LBB[0-9]+_1}}:
+; CHECK-NEXT:  pushq %rax
+; CHECK-NEXT:  .cfi_adjust_cfa_offset 8
+; CHECK-NEXT:  callq DeduBB.master.cr.8
+; With a frame pointer the CFA is %rbp-based: no CFI.
+; CHECK-LABEL: cr1_fp:
+; CHECK:       {{^\.LBB[0-9]+_1}}:
+; CHECK-NEXT:  pushq %rax
+; CHECK-NEXT:  callq DeduBB.master.cr.8
+; CHECK-NEXT:  {{^\.LBB[0-9]+_1_CS0}}:
+; CHECK-NEXT:  leaq 8(%rsp), %rsp
+; CHECK-NEXT:  {{^\.LBB_END[0-9]+_1}}:
+
+; The function passes arguments on the stack, which the master's call would
+; not find.
+; CHECK-LABEL: stackargs_fold:
+; CHECK:       {{^\.LBB[0-9]+_1}}:
+; CHECK-NEXT:  leal (%r14,%r14,2), %edi
+; CHECK-NEXT:  movl %edi, (%rbx)
+; CHECK-NEXT:  callq g@PLT
+; The function calls setjmp.
+; CHECK-LABEL: setjmp_fold:
+; CHECK:       {{^\.LBB[0-9]+_1}}:
+; CHECK-NOT:   DeduBB
+; CHECK:       callq g@PLT
+; The body calls another function than the directive says.
+; CHECK-LABEL: mismatch_fold:
+; CHECK:       {{^\.LBB[0-9]+_1}}:
+; CHECK-NEXT:  leal (%r14,%r14,2), %edi
+; CHECK-NEXT:  movl %edi, (%rbx)
+; CHECK-NEXT:  callq h@PLT
+
+; A block that ends in a conditional branch keeps it; the flags the master
+; sets reach it unchanged.
+; CHECK-LABEL: two_exit_master:
+; CHECK:       {{^\.LBB[0-9]+_1}}:
+; CHECK-NEXT:  callq DeduBB.master.cr.10
+; CHECK-NEXT:  {{^\.LBB[0-9]+_1_CS0}}:
+; CHECK-NEXT:  jne
+; CHECK-LABEL: two_exit_fold:
+; CHECK:       {{^\.LBB[0-9]+_1}}:
+; CHECK-NEXT:  callq DeduBB.master.cr.10
+; CHECK-NEXT:  {{^\.LBB[0-9]+_1_CS0}}:
+; CHECK-NEXT:  jne
+
+; An invoke has EH labels: neither block is replaced, but the master is still
+; emitted for blocks elsewhere.
+; CHECK-LABEL: invoke_master:
+; CHECK:       {{^\.LBB[0-9]+_1}}:
+; CHECK-NEXT:  leal (%r14,%r14,2), %edi
+; CHECK-NEXT:  movl %edi, (%rbx)
+; CHECK-NEXT:  .Ltmp{{[0-9]+}}: # EH_LABEL
+; CHECK-NEXT:  callq g@PLT
+; CHECK-LABEL: invoke_fold:
+; CHECK:       {{^\.LBB[0-9]+_1}}:
+; CHECK-NEXT:  leal (%r14,%r14,2), %edi
+; A body that reads the stack through %rsp.
+; CHECK-LABEL: rsp_fold:
+; CHECK:       {{^\.LBB[0-9]+_1}}:
+; CHECK-NEXT:  movl 8(%rsp), %edi
