--- /dev/null
+++ b/llvm/test/CodeGen/X86/dedubb-ranges.ll
@@ -0,0 +1,367 @@
+; Tests the tail-call and Save-and-Jump ranges of DeduBB (`at=`,
+; `block_insts=`): a tail-call ending shared in place, and a Save-and-Jump run
+; inside a block.
+
+; RUN: rm -rf %t && split-file %s %t
+; RUN: llc -mtriple=x86_64-unknown-linux-gnu -O2 -relocation-model=pic \
+; RUN:   -basic-block-address-map -verify-machineinstrs \
+; RUN:   -dedubb-directives=%t/d.txt %t/a.ll -o - | FileCheck %s
+
+; With indirect branch tracking, a Save-and-Jump master's indirect jump would
+; need an `endbr` at its target: the fold is left alone, but the master is
+; still emitted, for folds in modules without it.
+; RUN: llc -mtriple=x86_64-unknown-linux-gnu -O2 -relocation-model=pic \
+; RUN:   -basic-block-address-map -verify-machineinstrs \
+; RUN:   -dedubb-directives=%t/ibt.txt %t/ibt.ll -o - \
+; RUN:   | FileCheck %s --check-prefix=IBT
+
+; A tail-call master whose ending does not match its directive is an error:
+; blocks elsewhere jump into it. So is one whose ending holds a call, or an
+; absolute address, which may change once DeduBB has shrunk the code.
+; RUN: not llc -mtriple=x86_64-unknown-linux-gnu -O2 -relocation-model=pic \
+; RUN:   -basic-block-address-map -dedubb-directives=%t/tcerr.txt %t/a.ll \
+; RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=TCERR
+; RUN: not llc -mtriple=x86_64-unknown-linux-gnu -O2 -relocation-model=pic \
+; RUN:   -basic-block-address-map -dedubb-directives=%t/callerr.txt %t/a.ll \
+; RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=CALLERR
+; RUN: not llc -mtriple=x86_64-unknown-linux-gnu -O2 -relocation-model=static \
+; RUN:   -basic-block-address-map -dedubb-directives=%t/abs.txt %t/abs.ll \
+; RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=ABSERR
+
+; A master keeps its code, with a label for each ending other blocks share.
+; CHECK-LABEL: tc_m:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  leaq (%rdi,%rdi,2), %rax
+; CHECK-NEXT:  .globl DeduBB.master.11
+; CHECK-NEXT:  .hidden DeduBB.master.11
+; CHECK-NEXT:  DeduBB.master.11:
+; CHECK-NEXT:  movq %rax, (%rsi)
+; CHECK-NEXT:  .globl DeduBB.master.12
+; CHECK-NEXT:  .hidden DeduBB.master.12
+; CHECK-NEXT:  DeduBB.master.12:
+; CHECK-NEXT:  jmp tail@PLT
+
+; A fold keeps its first instructions and jumps to the master's ending.
+; CHECK-LABEL: tc_f:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  leaq (%rdi,%rdi,4), %rax
+; CHECK-NEXT:  jmp DeduBB.master.11
+
+; The ending may be the whole block.
+; CHECK-LABEL: tc_g:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  jmp DeduBB.master.12
+
+; An ending with the epilogue: the master pops the frame of the block that
+; jumps there.
+; CHECK-LABEL: ep_m:
+; CHECK:       callq work@PLT
+; CHECK:       callq work@PLT
+; CHECK-NEXT:  {{^\.LBB[0-9]+_0_CS1}}:
+; CHECK-NEXT:  .globl DeduBB.master.13
+; CHECK-NEXT:  .hidden DeduBB.master.13
+; CHECK-NEXT:  DeduBB.master.13:
+; CHECK-NEXT:  addq %rbx, %rax
+; CHECK-NEXT:  popq %rbx
+; CHECK-NEXT:  .cfi_def_cfa_offset 8
+; CHECK-NEXT:  retq
+; CHECK-LABEL: ep_f:
+; CHECK:       pushq %rbx
+; CHECK:       callq work2@PLT
+; CHECK:       callq work@PLT
+; CHECK-NEXT:  {{^\.LBB[0-9]+_0_CS1}}:
+; CHECK-NEXT:  jmp DeduBB.master.13
+; CHECK-NOT:   popq
+; CHECK:       .cfi_endproc
+
+; An ending with a call is not shared: unwinding through the call would use
+; the master function's rules for the frame of the block that jumped there.
+; CHECK-LABEL: ep_g:
+; CHECK:       callq work2@PLT
+; CHECK:       callq work@PLT
+; CHECK-NEXT:  {{^\.LBB[0-9]+_0_CS1}}:
+; CHECK-NEXT:  addq %rbx, %rax
+; CHECK-NEXT:  popq %rbx
+
+; The ending tail-calls another function than the directive's: left as is.
+; CHECK-LABEL: tc_callee:
+; CHECK:       movq %rax, (%rsi)
+; CHECK-NEXT:  jmp work@PLT
+
+; A Save-and-Jump run: the block is split after it, and the stub passes the
+; second half to the master, the master's own copy included.
+; CHECK-LABEL: sj_f:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  movq $7, (%rsi)
+; CHECK-NEXT:  leaq [[RET:\.LBB[0-9]+_1]](%rip), %r11
+; CHECK-NEXT:  jmp DeduBB.master.sj.21
+; CHECK:       [[RET]]:
+; CHECK-NEXT:  movq %rax, (%rsi)
+; CHECK-NEXT:  retq
+
+; A run and a tail-call ending in one block.
+; CHECK-LABEL: mix:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  movq $7, (%rsi)
+; CHECK-NEXT:  leaq [[RET2:\.LBB[0-9]+_1]](%rip), %r11
+; CHECK-NEXT:  jmp DeduBB.master.sj.21
+; CHECK:       [[RET2]]:
+; CHECK-NEXT:  movq %rax, (%rsi)
+; CHECK-NEXT:  movq %rdx, %rdi
+; CHECK-NEXT:  jmp DeduBB.master.12
+
+; A `lock` prefix is part of its instruction, which counts as one.
+; CHECK-LABEL: lk_m:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  lock incl (%rdi)
+; CHECK-NEXT:  .globl DeduBB.master.14
+; CHECK-NEXT:  .hidden DeduBB.master.14
+; CHECK-NEXT:  DeduBB.master.14:
+; CHECK-NEXT:  movq %rsi, (%rdx)
+; CHECK-LABEL: lk_f:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  lock decl (%rdi)
+; CHECK-NEXT:  jmp DeduBB.master.14
+
+; A thread-local access is one pseudo here and two instructions in the binary:
+; a master's ending is still found from the end, but a fold, which needs the
+; whole block counted, is left as is.
+; CHECK-LABEL: tls_m:
+; CHECK:       callq __tls_get_addr@PLT
+; CHECK-NEXT:  movq (%rax), %rax
+; CHECK-NEXT:  movq %rax, (%rbx)
+; CHECK-NEXT:  .globl DeduBB.master.15
+; CHECK-NEXT:  .hidden DeduBB.master.15
+; CHECK-NEXT:  DeduBB.master.15:
+; CHECK-NEXT:  movq %r14, %rdi
+; CHECK-LABEL: tls_f:
+; CHECK:       movq %rax, (%rbx)
+; CHECK-NEXT:  movq %r14, %rdi
+; CHECK-NEXT:  addq $8, %rsp
+; CHECK:       jmp tail@PLT
+
+; An ending may hold a thread-local variable's offset, which the linker fills
+; in alike in every block.
+; CHECK-LABEL: ld_m:
+; CHECK:       movq %rcx, (%r14)
+; CHECK-NEXT:  .globl DeduBB.master.16
+; CHECK-NEXT:  .hidden DeduBB.master.16
+; CHECK-NEXT:  DeduBB.master.16:
+; CHECK-NEXT:  movq %rbx, tlh@DTPOFF(%rax)
+
+; The Save-and-Jump masters, from the directives' bytes, without unwind info,
+; in `.text.dedubb.`.
+; CHECK:       .section .text.dedubb.,"ax",@progbits
+; CHECK-NEXT:  .type DeduBB.sj.masters,@function
+; CHECK-LABEL: DeduBB.sj.masters:
+; CHECK-NOT:   .cfi_startproc
+; CHECK:       DeduBB.master.sj.21:
+; CHECK-NEXT:  #APP
+; CHECK-NEXT:  .byte 72
+; CHECK-NEXT:  .byte 184
+; CHECK-COUNT-18: .byte
+; CHECK-NEXT:  #NO_APP
+; CHECK-NEXT:  jmpq *%r11
+; CHECK-NOT:   .cfi_endproc
+; CHECK:       -- End function
+
+; IBT-LABEL: sj_f:
+; IBT:         endbr64
+; IBT-NEXT:    movq $7, (%rsi)
+; IBT-NEXT:    movabsq
+; IBT-NEXT:    imulq (%rdi), %rax
+; IBT-LABEL: DeduBB.sj.masters:
+; IBT:         DeduBB.master.sj.21:
+
+; TCERR: LLVM ERROR: DeduBB: block 0 of tc_m does not end in the 2 instructions that tail-call master DeduBB.master.30 shares (they call other functions)
+
+; CALLERR: LLVM ERROR: DeduBB: block 0 of ep_m does not end in the 5 instructions that tail-call master DeduBB.master.32 shares (they hold a call, CALL64pcrel32)
+
+; ABSERR: LLVM ERROR: DeduBB: block 0 of abs_m does not end in the 2 instructions that tail-call master DeduBB.master.31 shares (MOV32ri references a symbol that is not its callee)
+
+;--- d.txt
+m test.c
+f tc_m
+bbm 0 (DeduBB.master.11) callees=tail at=1 block_insts=3
+bbm 0 (DeduBB.master.12) callees=tail at=2 block_insts=3
+f tc_f
+bbf 0 (DeduBB.master.11) callees=tail at=1 block_insts=3
+f tc_g
+bbf 0 (DeduBB.master.12) callees=tail at=0 block_insts=1
+f ep_m
+bbm 0 (DeduBB.master.13) at=5 block_insts=8
+f ep_f
+bbf 0 (DeduBB.master.13) at=5 block_insts=8
+f ep_g
+bbf 0 (DeduBB.master.13) callees=work at=3 block_insts=8
+f tc_callee
+bbf 0 (DeduBB.master.12) callees=other at=3 block_insts=4
+f sj_f
+bbmsj 0 (DeduBB.master.sj.21) insts=3 at=1 block_insts=6 body=48b8157c4a7fb979379e480faf07483539300000
+f mix
+bbfsj 0 (DeduBB.master.sj.21) insts=3 at=1 block_insts=7
+bbf 0 (DeduBB.master.12) callees=tail at=6 block_insts=7
+f lk_m
+bbm 0 (DeduBB.master.14) callees=tail at=1 block_insts=4
+f lk_f
+bbf 0 (DeduBB.master.14) callees=tail at=1 block_insts=4
+f tls_m
+bbm 0 (DeduBB.master.15) callees=tail at=9 block_insts=14
+f tls_f
+bbf 0 (DeduBB.master.15) callees=tail at=9 block_insts=14
+f ld_m
+bbm 0 (DeduBB.master.16) at=8 block_insts=13
+;--- ibt.txt
+f sj_f
+bbmsj 0 (DeduBB.master.sj.21) insts=3 at=2 block_insts=7 body=48b8157c4a7fb979379e480faf07483539300000
+;--- tcerr.txt
+f tc_m
+bbm 0 (DeduBB.master.30) callees=other at=1 block_insts=3
+;--- callerr.txt
+f ep_m
+bbm 0 (DeduBB.master.32) callees=work at=3 block_insts=8
+;--- abs.txt
+f abs_m
+bbm 0 (DeduBB.master.31) callees=tail at=0 block_insts=2
+;--- abs.ll
+declare i64 @tail(i64)
+@g = dso_local global i64 0
+
+; `movl $g, %edi`, without position independence.
+define i64 @abs_m(i64 %x) {
+  %r = tail call i64 @tail(i64 ptrtoint (ptr @g to i64))
+  ret i64 %r
+}
+;--- ibt.ll
+define void @sj_f(ptr %p, ptr %q) {
+  store volatile i64 7, ptr %q
+  %v = load volatile i64, ptr %p
+  %w = mul i64 %v, -7046029254386353131
+  %z = xor i64 %w, 12345
+  store volatile i64 %z, ptr %q
+  ret void
+}
+
+!llvm.module.flags = !{!0}
+!0 = !{i32 8, !"cf-protection-branch", i32 1}
+;--- a.ll
+declare i64 @tail(i64)
+declare i64 @work(i64)
+declare i64 @work2(i64)
+
+; The same last instructions after different first ones.
+define i64 @tc_m(i64 %x, ptr %p) {
+  %a = mul i64 %x, 3
+  store volatile i64 %a, ptr %p
+  %r = tail call i64 @tail(i64 %x)
+  ret i64 %r
+}
+
+define i64 @tc_f(i64 %x, ptr %p) {
+  %a = mul i64 %x, 5
+  store volatile i64 %a, ptr %p
+  %r = tail call i64 @tail(i64 %x)
+  ret i64 %r
+}
+
+; A shorter ending of the same master.
+define i64 @tc_g(i64 %x, ptr %p) {
+  %r = tail call i64 @tail(i64 %x)
+  ret i64 %r
+}
+
+; An ending with a call and the epilogue.
+define i64 @ep_m(i64 %x) {
+  %a = call i64 @work(i64 %x)
+  %b = call i64 @work(i64 %a)
+  %c = add i64 %b, %x
+  ret i64 %c
+}
+
+define i64 @ep_f(i64 %x) {
+  %a = call i64 @work2(i64 %x)
+  %b = call i64 @work(i64 %a)
+  %c = add i64 %b, %x
+  ret i64 %c
+}
+
+; Its directive covers the call.
+define i64 @ep_g(i64 %x) {
+  %a = call i64 @work2(i64 %x)
+  %b = call i64 @work(i64 %a)
+  %c = add i64 %b, %x
+  ret i64 %c
+}
+
+; Its directive names another callee.
+define i64 @tc_callee(i64 %x, ptr %p) {
+  %a = mul i64 %x, 7
+  store volatile i64 %a, ptr %p
+  %r = tail call i64 @work(i64 %x)
+  ret i64 %r
+}
+
+; A Save-and-Jump run: the load-multiply-mix after the first store.
+define void @sj_f(ptr %p, ptr %q) {
+  store volatile i64 7, ptr %q
+  %v = load volatile i64, ptr %p
+  %w = mul i64 %v, -7046029254386353131
+  %z = xor i64 %w, 12345
+  store volatile i64 %z, ptr %q
+  ret void
+}
+
+; The same run, and the tail call's ending.
+define i64 @mix(ptr %p, ptr %q, i64 %x) {
+  store volatile i64 7, ptr %q
+  %v = load volatile i64, ptr %p
+  %w = mul i64 %v, -7046029254386353131
+  %z = xor i64 %w, 12345
+  store volatile i64 %z, ptr %q
+  %r = tail call i64 @tail(i64 %x)
+  ret i64 %r
+}
+
+; `lock incl` and `lock decl`, before the same ending.
+define i64 @lk_m(ptr %c, i64 %x, ptr %p) {
+  %old = atomicrmw add ptr %c, i32 1 seq_cst
+  store volatile i64 %x, ptr %p
+  %r = tail call i64 @tail(i64 %x)
+  ret i64 %r
+}
+
+define i64 @lk_f(ptr %c, i64 %x, ptr %p) {
+  %old = atomicrmw sub ptr %c, i32 1 seq_cst
+  store volatile i64 %x, ptr %p
+  %r = tail call i64 @tail(i64 %x)
+  ret i64 %r
+}
+
+@tlv = thread_local global i64 0
+
+; A general-dynamic thread-local access before an ending with the epilogue.
+define i64 @tls_m(i64 %x, ptr %p) {
+  %v = load i64, ptr @tlv
+  store volatile i64 %v, ptr %p
+  %r = tail call i64 @tail(i64 %x)
+  ret i64 %r
+}
+
+define i64 @tls_f(i64 %x, ptr %p) {
+  %v = load i64, ptr @tlv
+  store volatile i64 %v, ptr %p
+  %r = tail call i64 @tail(i64 %x)
+  ret i64 %r
+}
+
+@tlh = internal thread_local global i64 0
+
+; A local-dynamic access: the store's offset is in the ending. The linker
+; rewrites the call that finds the module's block into one instruction, which
+; Step 1 counts as one.
+define void @ld_m(ptr %p, i64 %x) {
+  %a = load i64, ptr @tlh
+  store volatile i64 %a, ptr %p
+  store i64 %x, ptr @tlh
+  ret void
+}
diff --git a/llvm/test/CodeGen/X86/dedubb-tail-call-callees.ll b/llvm/test/CodeGen/X86/dedubb-tail-call-callees.ll
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/X86/dedubb-tail-call-callees.ll
@@ -0,0 +1,84 @@
+; Tests `callees=` on tail-call directives: a bbf block that calls or jumps to
+; a function is folded only if the directive names exactly its targets, and a
+; block with a successor or another symbol is never folded.
+
+; RUN: printf 'm test.c\nf m_call\nbbm 0 (DeduBB.master.1) callees=callee\nf f_call\nbbf 0 (DeduBB.master.1) callees=other|callee\nf f_wrong\nbbf 0 (DeduBB.master.1) callees=other\nf f_nolist\nbbf 0 (DeduBB.master.1)\nf m_data\nbbm 0 (DeduBB.master.2)\nf f_data\nbbf 0 (DeduBB.master.2) callees=\nf f_succ\nbbf 0 (DeduBB.master.2)\n' > %t.dir
+; RUN: llc -mtriple=x86_64-unknown-linux-gnu -basic-block-address-map \
+; RUN:     -dedubb-directives=%t.dir < %s | FileCheck %s
+
+declare i32 @callee(i32)
+
+@g = global i32 0
+
+; CHECK-LABEL: m_call:
+; CHECK:       DeduBB.master.1:
+; CHECK:       jmp callee
+define i32 @m_call(i32 %x) {
+  %a = add i32 %x, 7
+  %r = tail call i32 @callee(i32 %a)
+  ret i32 %r
+}
+
+; The directive names the tail call's target (as one of its names): folded.
+; CHECK-LABEL: f_call:
+; CHECK:       # %bb.0:
+; CHECK-NEXT:  jmp DeduBB.master.1
+; CHECK-NOT:   callee
+; CHECK:       .Lfunc_end
+define i32 @f_call(i32 %x) {
+  %a = add i32 %x, 7
+  %r = tail call i32 @callee(i32 %a)
+  ret i32 %r
+}
+
+; The directive names another function: left as is.
+; CHECK-LABEL: f_wrong:
+; CHECK-NOT:   DeduBB.master
+; CHECK:       jmp callee
+define i32 @f_wrong(i32 %x) {
+  %a = add i32 %x, 7
+  %r = tail call i32 @callee(i32 %a)
+  ret i32 %r
+}
+
+; No `callees=` (a directive from an older Step 1): left as is.
+; CHECK-LABEL: f_nolist:
+; CHECK-NOT:   DeduBB.master
+; CHECK:       jmp callee
+define i32 @f_nolist(i32 %x) {
+  %a = add i32 %x, 7
+  %r = tail call i32 @callee(i32 %a)
+  ret i32 %r
+}
+
+; CHECK-LABEL: m_data:
+; CHECK:       DeduBB.master.2:
+define i32 @m_data(i32 %x) {
+  %v = load i32, ptr @g
+  %s = add i32 %v, %x
+  ret i32 %s
+}
+
+; A symbol that is not a call target cannot be checked: left as is.
+; CHECK-LABEL: f_data:
+; CHECK-NOT:   DeduBB.master
+; CHECK:       {{g(@GOTPCREL)?}}(%rip)
+define i32 @f_data(i32 %x) {
+  %v = load i32, ptr @g
+  %s = add i32 %v, %x
+  ret i32 %s
+}
+
+; A block with successors: its fold would lose them, so it is left as is.
+; CHECK-LABEL: f_succ:
+; CHECK-NOT:   DeduBB.master
+; CHECK:       .Lfunc_end
+define i32 @f_succ(i32 %x) {
+entry:
+  %c = icmp eq i32 %x, 0
+  br i1 %c, label %a, label %b
+a:
+  ret i32 1
+b:
+  ret i32 2
+}
diff --git a/llvm/test/CodeGen/X86/dedubb.ll b/llvm/test/CodeGen/X86/dedubb.ll
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/X86/dedubb.ll
@@ -0,0 +1,34 @@
+; Tests the DeduBB tail-call deduplication pass applying bbm/bbf directives.
+;   bbm <id> (DeduBB.master.K) -> emit a global `DeduBB.master.K` label at the
+;                                 start of the master block.
+;   bbf <id> (DeduBB.master.K) -> replace the block with a jump to the master.
+; Both functions are single-block (entry block has bb_id 0), so the directives
+; are deterministic.
+;
+; NOTE: exact assembly spelling (e.g. an @PLT suffix under PIC) may vary; the
+; checks below are intentionally loose around the symbol reference.
+
+; RUN: printf 'm test.c\nf master_fn\nbbm 0 (DeduBB.master.7)\nf fold_fn\nbbf 0 (DeduBB.master.7)\n' > %t.dir
+; RUN: llc -mtriple=x86_64-unknown-linux-gnu -basic-block-address-map \
+; RUN:     -dedubb-directives=%t.dir < %s | FileCheck %s
+
+define i32 @master_fn() {
+entry:
+  ret i32 42
+}
+
+; The master block gets a global symbol so other modules can branch to it.
+; CHECK-LABEL: master_fn:
+; CHECK: .globl DeduBB.master.7
+; CHECK: DeduBB.master.7:
+
+define i32 @fold_fn() {
+entry:
+  ret i32 42
+}
+
+; The folded block is replaced by a single jump to the master copy; its original
+; `ret` is gone.
+; CHECK-LABEL: fold_fn:
+; CHECK: jmp DeduBB.master.7
+; CHECK-NOT: retq
