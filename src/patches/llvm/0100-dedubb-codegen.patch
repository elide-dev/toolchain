+MCRegister X86InstrInfo::getDeduBBLinkRegister() const {
+  // R11 is caller-saved, is never an argument register, and is the
+  // conventional scratch register for PLT stubs and veneers.
+  return Subtarget.is64Bit() ? MCRegister(X86::R11) : MCRegister();
+}
+
+MCRegister X86InstrInfo::getDeduBBSecondLinkRegister() const {
+  // R10 is caller-saved and carries an argument only for the static chain
+  // (`nest`); the DeduBB pass checks that it is dead wherever it is written.
+  return Subtarget.is64Bit() ? MCRegister(X86::R10) : MCRegister();
+}
+
+void X86InstrInfo::insertDeduBBLoadReturnAddress(MachineBasicBlock &MBB,
+                                                 MachineBasicBlock &Target,
+                                                 MCRegister Reg) const {
+  // leaq Target(%rip), Reg
+  BuildMI(&MBB, DebugLoc(), get(X86::LEA64r), Reg)
+      .addReg(X86::RIP).addImm(1).addReg(0).addMBB(&Target).addReg(0);
+}
+
+void X86InstrInfo::insertDeduBBSaveAndJumpReturn(MachineBasicBlock &MBB,
+                                                 MCRegister Reg) const {
+  // jmpq *Reg
+  BuildMI(&MBB, DebugLoc(), get(X86::JMP64r)).addReg(Reg, RegState::Kill);
+}
+
+bool X86InstrInfo::isDeduBBSingleInstruction(const MachineInstr &MI) const {
+  switch (MI.getOpcode()) {
+  // Lowered into one `jmp` or `jcc`.
+  case X86::TAILJMPd64:
+  case X86::TAILJMPd64_CC:
+  case X86::TAILJMPr64:
+  case X86::TAILJMPr64_REX:
+  case X86::TAILJMPm64:
+  case X86::TAILJMPm64_REX:
+    return true;
+  default:
+    // The AsmPrinter lowers the other pseudos left at this point into no code
+    // or into several instructions (thread-local accesses, checks), including
+    // those the instruction tables do not mark as pseudos.
+    return !MI.getDesc().isPseudo() &&
+           (MI.getDesc().TSFlags & X86II::FormMask) != X86II::Pseudo;
+  }
+}
+
+bool X86InstrInfo::isDeduBBLinkTimeConstant(const MachineOperand &MO) const {
+  if (!MO.isGlobal() && !MO.isSymbol() && !MO.isMCSymbol())
+    return false;
+  switch (MO.getTargetFlags()) {
+  // Offsets of thread-local variables from the thread pointer or from their
+  // module's block, and the GOT entry of an initial-exec access, which the
+  // linker rewrites into such an offset in an executable. Where it does not,
+  // the access is %rip-relative, and Step 1 shares no code that holds one.
+  case X86II::MO_TPOFF:
+  case X86II::MO_DTPOFF:
+  case X86II::MO_GOTTPOFF:
+    return true;
+  default:
+    return false;
+  }
+}
+
+ArrayRef<MCPhysReg> X86InstrInfo::getDeduBBCallReturnForbiddenRegs() const {
+  // A master runs with %rsp 8 or 16 bytes lower than the block it replaces,
+  // at another address, and with one more return address on the shadow stack.
+  static const MCPhysReg Regs[] = {X86::RSP, X86::RIP, X86::SSP};
+  return Subtarget.is64Bit() ? ArrayRef<MCPhysReg>(Regs)
+                             : ArrayRef<MCPhysReg>();
+}
+
+bool X86InstrInfo::isDeduBBCallReturnMovable(
+    const MachineInstr &MI, const MachineOperand *&Callee) const {
+  Callee = nullptr;
+  switch (MI.getOpcode()) {
+  case X86::CALL64pcrel32: {
+    // A direct call to a named function. Its rel32 is resolved wherever the
+    // call is emitted.
+    const MachineOperand &MO = MI.getOperand(0);
+    if (!(MO.isGlobal() || MO.isSymbol() || MO.isMCSymbol()) ||
+        MO.getOffset() != 0)
+      return false;
+    Callee = &MO;
+    return true;
+  }
+  case X86::CALL64r:
+  case X86::CALL64r_NT:
+  case X86::CALL64m:
+  case X86::CALL64m_NT:
+    // Through a register or memory; the caller checks that the address does
+    // not use %rsp or %rip.
+    return true;
+  // Lowered by the AsmPrinter into code that belongs to its function or
+  // place, or that the linker rewrites (thread-local accesses).
+  case X86::ENDBR32:
+  case X86::ENDBR64:
+  case X86::KCFI_CHECK:
+  case X86::ASAN_CHECK_MEMACCESS:
+  case X86::MORESTACK_RET:
+  case X86::MORESTACK_RET_RESTORE_R10:
+  case X86::MOVPC32r:
+  case X86::TLS_addr32:
+  case X86::TLS_addr64:
+  case X86::TLS_addrX32:
+  case X86::TLS_base_addr32:
+  case X86::TLS_base_addr64:
+  case X86::TLS_base_addrX32:
+  case X86::TLS_desc32:
+  case X86::TLS_desc64:
+  case X86::UBSAN_UD1:
+    return false;
+  default:
+    // Any other call: far calls, and calls that are lowered with extra code.
+    return !MI.isCall();
+  }
+}
+
+bool X86InstrInfo::supportsDeduBBCallReturn(const MachineFunction &MF) const {
+  const Function &F = MF.getFunction();
+  // x86-64 System V: a call reaches the masters through a rel32, and every
+  // block of the function starts with the same stack alignment.
+  if (!Subtarget.is64Bit() || Subtarget.isTargetWin64() ||
+      Subtarget.isCallingConvWin64(F.getCallingConv()) ||
+      MF.getTarget().getCodeModel() == CodeModel::Large)
+    return false;
+  // Naked functions and interrupt handlers have no ordinary stack frame.
+  if (F.hasFnAttribute(Attribute::Naked) ||
+      F.getCallingConv() == CallingConv::X86_INTR)
+    return false;
+  // LVI hardening rewrites returns into code that writes EFLAGS, which may
+  // carry a result out of a body.
+  return !Subtarget.useLVIControlFlowIntegrity();
+}
+
+bool X86InstrInfo::hasDeduBBRedZone(const MachineFunction &MF) const {
+  // The same test as isFunctionSafeToOutlineFrom.
+  if (!Subtarget.getFrameLowering()->has128ByteRedZone(MF))
+    return false;
+  const X86MachineFunctionInfo *X86FI = MF.getInfo<X86MachineFunctionInfo>();
+  return !X86FI || X86FI->getUsesRedZone();
+}
+
+MachineInstr *X86InstrInfo::insertDeduBBCallReturnStub(
+    MachineBasicBlock &MBB, MachineBasicBlock::iterator InsertPt,
+    StringRef MasterSym, bool WithCalls, bool EmitCFI) const {
+  MachineFunction &MF = *MBB.getParent();
+  const X86FrameLowering &TFL = *Subtarget.getFrameLowering();
+  const DebugLoc DL;
+  // A master that makes calls is entered with 16 bytes pushed instead of 8,
+  // so that its calls see the stack alignment they saw in the block:
+  //   pushq %rax; callq Master; leaq 8(%rsp), %rsp
+  // `push` only reads %rax, and neither `push`, `call` nor `lea` writes
+  // EFLAGS, so no register or flag the block uses is disturbed. (`subq`/`addq`
+  // would write EFLAGS.)
+  if (WithCalls) {
+    BuildMI(MBB, InsertPt, DL, get(X86::PUSH64r))
+        .addReg(X86::RAX, RegState::Undef);
+    if (EmitCFI)
+      TFL.BuildCFI(MBB, InsertPt, DL,
+                   MCCFIInstruction::createAdjustCfaOffset(nullptr, 8));
+  }
+  MachineInstr *Call =
+      BuildMI(MBB, InsertPt, DL, get(X86::CALL64pcrel32))
+          .addExternalSymbol(MF.createExternalSymbolName(MasterSym));
+  if (WithCalls) {
+    BuildMI(MBB, InsertPt, DL, get(X86::LEA64r), X86::RSP)
+        .addReg(X86::RSP)
+        .addImm(1)
+        .addReg(0)
+        .addImm(8)
+        .addReg(0);
+    if (EmitCFI)
+      TFL.BuildCFI(MBB, InsertPt, DL,
+                   MCCFIInstruction::createAdjustCfaOffset(nullptr, -8));
+  }
+  return Call;
+}
+
+void X86InstrInfo::insertDeduBBCallReturnRet(MachineBasicBlock &MBB) const {
+  BuildMI(&MBB, DebugLoc(), get(X86::RET64));
+}
+
+void X86InstrInfo::insertDeduBBCallReturnMasterCall(MachineBasicBlock &MBB,
+                                                    const GlobalValue *GV,
+                                                    StringRef Name) const {
+  MachineFunction &MF = *MBB.getParent();
+  // callq GV, with the flags a call of this module would carry. The block
+  // the master was taken from made a `call rel32`, so a call through the GOT
+  // (-fno-plt) is made through the PLT instead: it reaches the same function.
+  unsigned char Flags = Subtarget.classifyGlobalFunctionReference(
+      GV, *MF.getFunction().getParent());
+  if (Flags != X86II::MO_NO_FLAG && Flags != X86II::MO_PLT)
+    Flags = X86II::MO_PLT;
+  MachineInstrBuilder MIB = BuildMI(&MBB, DebugLoc(), get(X86::CALL64pcrel32));
+  if (GV)
+    MIB.addGlobalAddress(GV, 0, Flags);
+  else
+    MIB.addExternalSymbol(MF.createExternalSymbolName(Name), Flags);
+}
+
+std::string
+X86InstrInfo::getDeduBBCallReturnMasterFeatures(StringRef Features) const {
+  // LVI hardening would put code that writes EFLAGS in front of every master's
+  // `ret`. Blocks of hardened functions are never folded
+  // (supportsDeduBBCallReturn), so the masters do not need it.
+  SmallVector<StringRef, 16> Parts;
+  Features.split(Parts, ',', /*MaxSplit=*/-1, /*KeepEmpty=*/false);
+  std::string Result;
+  for (StringRef Part : Parts) {
+    if (Part == "+lvi-cfi")
+      continue;
+    if (!Result.empty())
+      Result += ',';
+    Result += Part;
+  }
+  return Result;
+}
+
