+//===----------------------------------------------------------------------===//
+// Checks on a block's body: do its instructions produce the directive's bytes?
+//===----------------------------------------------------------------------===//
+
+namespace {
+// What a block's body, everything before its terminators, does.
+struct BodyInfo {
+  enum Kind { OK, Ineligible, Mismatch, CalleeMismatch } Result = OK;
+  // Instructions that emit code.
+  unsigned NumInsts = 0;
+  // The body's calls in order: the callee's name for a direct call, "*" for a
+  // call through a register or memory.
+  SmallVector<std::string, 4> Callees;
+};
+} // namespace
+
+// A call to a function that returns twice would save the master's frame,
+// which is gone once the master returns. The names are the ones Step 1 refuses.
+static bool returnsTwice(const MachineOperand &Callee, StringRef Name) {
+  if (Callee.isGlobal())
+    if (const auto *F =
+            dyn_cast_or_null<Function>(Callee.getGlobal()->getAliaseeObject()))
+      if (F->hasFnAttribute(Attribute::ReturnsTwice))
+        return true;
+  static const StringRef Names[] = {
+      "setjmp",  "_setjmp", "__setjmp", "sigsetjmp",  "__sigsetjmp",
+      "savectx", "vfork",   "__vfork",  "getcontext", "__getcontext",
+      "qsetjmp"};
+  return is_contained(Names, Name);
+}
+
+// Decides whether a master can run \p MI, an instruction that emits code: it
+// emits one plain instruction, with no operand the linker fills in other than
+// the target of a direct call, and touches none of the forbidden registers
+// (%rsp, %rip and the shadow-stack pointer on x86-64) other than through a
+// call's own stack effects. Appends a call's callee to \p Callees: its name,
+// or "*" for a call through a register or memory.
+static bool isMovable(const MachineInstr &MI, const TargetInstrInfo &TII,
+                      const TargetRegisterInfo &TRI,
+                      SmallVectorImpl<std::string> &Callees) {
+  const ArrayRef<MCPhysReg> Forbidden = TII.getDeduBBCallReturnForbiddenRegs();
+  const auto IsForbidden = [&](Register Reg) {
+    return any_of(Forbidden, [&](MCPhysReg F) {
+      return TRI.regsOverlap(Reg, Register(F));
+    });
+  };
+  const auto IsForbiddenPhys = [&](MCPhysReg Reg) {
+    return IsForbidden(Register(Reg));
+  };
+  switch (MI.getOpcode()) {
+  // Inline asm may hold anything, including code the linker fills in; the
+  // others record the function's address or frame, or patch it.
+  case TargetOpcode::INLINEASM:
+  case TargetOpcode::INLINEASM_BR:
+  case TargetOpcode::ANNOTATION_LABEL:
+  case TargetOpcode::LOCAL_ESCAPE:
+  case TargetOpcode::STACKMAP:
+  case TargetOpcode::PATCHPOINT:
+  case TargetOpcode::STATEPOINT:
+  case TargetOpcode::FENTRY_CALL:
+  case TargetOpcode::PATCHABLE_OP:
+  case TargetOpcode::PATCHABLE_FUNCTION_ENTER:
+  case TargetOpcode::PATCHABLE_FUNCTION_EXIT:
+  case TargetOpcode::PATCHABLE_RET:
+  case TargetOpcode::PATCHABLE_TAIL_CALL:
+  case TargetOpcode::PATCHABLE_EVENT_CALL:
+  case TargetOpcode::PATCHABLE_TYPED_EVENT_CALL:
+  case TargetOpcode::ICALL_BRANCH_FUNNEL:
+  case TargetOpcode::FAULTING_OP:
+    return false;
+  default:
+    break;
+  }
+  if (MI.isBranch() || MI.isIndirectBranch() || MI.isReturn() ||
+      MI.getPreInstrSymbol() || MI.getPostInstrSymbol())
+    return false;
+  // Calls other than plain direct and indirect ones, and pseudos lowered into
+  // more than one instruction or into code that belongs to its place
+  // (thread-local accesses, checks, sleds).
+  const MachineOperand *Callee = nullptr;
+  if (!TII.isDeduBBCallReturnMovable(MI, Callee))
+    return false;
+  if (MI.isCall()) {
+    std::string Name = Callee ? DeduBBDirectives::getCalleeName(*Callee) : "*";
+    if (Callee && returnsTwice(*Callee, Name))
+      return false;
+    Callees.push_back(std::move(Name));
+  }
+  for (const MachineOperand &MO : MI.operands()) {
+    switch (MO.getType()) {
+    case MachineOperand::MO_Register:
+      if (!MO.getReg())
+        break;
+      if (!MO.getReg().isPhysical())
+        return false;
+      // A call's implicit operands are its own stack effects and its
+      // arguments and results; its address is an explicit operand.
+      if (MI.isCall() && MO.isImplicit())
+        break;
+      if (IsForbidden(MO.getReg()))
+        return false;
+      break;
+    case MachineOperand::MO_Immediate:
+    case MachineOperand::MO_CImmediate:
+    case MachineOperand::MO_FPImmediate:
+    case MachineOperand::MO_RegisterMask:
+      break;
+    default:
+      // The only symbol allowed is a direct call's target, which the master
+      // calls by name. Any other symbol, block, constant pool or jump table
+      // operand is filled in by the linker, and would not have the value the
+      // master's bytes hold.
+      if (&MO == Callee)
+        break;
+      return false;
+    }
+  }
+  // Instructions built without their implicit operands (see
+  // X86InstrInfo::getOutliningTypeImpl).
+  if (!MI.isCall()) {
+    const MCInstrDesc &Desc = MI.getDesc();
+    if (any_of(Desc.implicit_uses(), IsForbiddenPhys) ||
+        any_of(Desc.implicit_defs(), IsForbiddenPhys))
+      return false;
+  }
+  return true;
+}
+
+// Decides whether \p MBB's instructions produce the bytes of directive \p D's
+// body: every instruction emits one instruction with no operand the linker
+// fills in, other than the target of a direct call; there are as many as
+// Step 1 decoded; and they call the same functions. Only then does replacing
+// the body with a call to the master, which runs those bytes, change nothing.
+static BodyInfo checkBody(const MachineBasicBlock &MBB,
+                          const DeduBBDirectives::Directive &D,
+                          const TargetInstrInfo &TII,
+                          const TargetRegisterInfo &TRI) {
+  BodyInfo Info;
+  const auto Fail = [&Info](BodyInfo::Kind Result) {
+    Info.Result = Result;
+    return Info;
+  };
+  if (TII.getDeduBBCallReturnForbiddenRegs().empty())
+    return Fail(BodyInfo::Ineligible);
+  // The entry block holds the prologue and entry instrumentation.
+  if (MBB.isEntryBlock())
+    return Fail(BodyInfo::Ineligible);
+  // The block's branches stay where they are. They must be all that follows
+  // the body, so that the body here is the part Step 1 compared.
+  for (const MachineInstr &MI : MBB.terminators()) {
+    if (MI.isDebugInstr())
+      continue;
+    if (!MI.isBranch() || MI.isReturn() || MI.isCall() || MI.isInlineAsm() ||
+        MI.isBundle())
+      return Fail(BodyInfo::Mismatch);
+  }
+  for (const MachineInstr &MI :
+       make_range(MBB.begin(), MBB.getFirstTerminator())) {
+    if (MI.isBundle() || MI.isBundled())
+      return Fail(BodyInfo::Ineligible);
+    // Debug info and other instructions that emit no code. A block that holds
+    // CFI or labels keeps its body (checkSite).
+    if (MI.isMetaInstruction())
+      continue;
+    ++Info.NumInsts;
+    if (!isMovable(MI, TII, TRI, Info.Callees))
+      return Fail(BodyInfo::Ineligible);
+  }
+  if (Info.NumInsts != D.NumInsts)
+    return Fail(BodyInfo::Mismatch);
+  if (!DeduBBDirectives::calleesMatch(D.Callees, Info.Callees))
+    return Fail(BodyInfo::CalleeMismatch);
+  return Info;
+}
+
+//===----------------------------------------------------------------------===//
+// Checks on a block's place: can its function call a master there?
+//===----------------------------------------------------------------------===//
+
+namespace {
+enum class Site {
+  OK,
+  ABI,
+  RedZone,
+  ReturnsTwice,
+  NotReplaceable,
+  StackArgs,
+};
+} // namespace
+
+// Blocks holding CFI, labels, frame setup or teardown, or an EH pad keep their
+// body: erasing it would break the function's unwind info or EH tables.
+static bool isReplaceable(const MachineBasicBlock &MBB) {
+  if (MBB.isEHPad() || MBB.isEHScopeEntry() || MBB.isEHFuncletEntry())
+    return false;
+  for (const MachineInstr &MI : MBB)
+    if (MI.isCFIInstruction() || MI.isLabel() ||
+        MI.getFlag(MachineInstr::FrameSetup) ||
+        MI.getFlag(MachineInstr::FrameDestroy) ||
+        MI.getOpcode() == TargetOpcode::RELOC_NONE ||
+        MI.getOpcode() == TargetOpcode::JUMP_TABLE_DEBUG_INFO)
+      return false;
+  return true;
+}
+
+// The checks on \p MF that apply to every stub in it, before the block's own
+// (checkSite) or the range's (foldRanges).
+static Site checkFunction(const MachineFunction &MF,
+                          const TargetInstrInfo &TII) {
+  if (!TII.supportsDeduBBCallReturn(MF))
+    return Site::ABI;
+  // The stub's call writes its return address below %rsp.
+  if (TII.hasDeduBBRedZone(MF))
+    return Site::RedZone;
+  if (MF.exposesReturnsTwice())
+    return Site::ReturnsTwice;
+  return Site::OK;
+}
+
+// The checks on \p MF for a stub whose master makes calls, and whether such a
+// stub needs CFI (\p EmitCFI).
+static Site checkCalls(const MachineFunction &MF, bool WithCalls,
+                       bool &EmitCFI) {
+  EmitCFI = false;
+  if (!WithCalls)
+    return Site::OK; // %rsp is back where it was when the master returns.
+  const MachineFrameInfo &MFI = MF.getFrameInfo();
+  // Arguments stored at the bottom of the frame would be 16 bytes away from
+  // where the master's callee looks for them, and the stub's return address
+  // would sit on the first of them.
+  if (MFI.getMaxCallFrameSize() > 0)
+    return Site::StackArgs;
+  // Without a frame pointer the CFA is %rsp-based in every block, and CFI
+  // must describe the padding. With one it is %rbp-based wherever a call is
+  // made: the prologue, shrink-wrapped or not, comes before every call and
+  // the epilogues after, and a block holding either keeps its body
+  // (isReplaceable).
+  EmitCFI = MF.needsFrameMoves() &&
+            !MF.getSubtarget().getFrameLowering()->hasFP(MF);
+  return Site::OK;
+}
+
+// Decides whether \p MBB may call its master, and whether a stub for a body
+// with calls needs CFI (\p EmitCFI).
+static Site checkSite(const MachineBasicBlock &MBB, bool WithCalls,
+                      const TargetInstrInfo &TII, bool &EmitCFI) {
+  const MachineFunction &MF = *MBB.getParent();
+  EmitCFI = false;
+  if (Site S = checkFunction(MF, TII); S != Site::OK)
+    return S;
+  if (!isReplaceable(MBB))
+    return Site::NotReplaceable;
+  return checkCalls(MF, WithCalls, EmitCFI);
+}
+
+// Replaces the instructions from \p Begin up to \p End of \p MBB (a body or a
+// range) with a call to \p Sym, which goes before \p End. The call takes over
+// their register effects, so that liveness stays exact: implicit uses of the
+// registers they read before writing them, implicit defs of the ones they
+// write, and, if they make calls, the register mask those share.
+static void replaceWithStub(MachineBasicBlock &MBB,
+                            MachineBasicBlock::iterator Begin,
+                            MachineBasicBlock::iterator End, StringRef Sym,
+                            bool WithCalls, bool EmitCFI,
+                            const TargetInstrInfo &TII,
+                            const TargetRegisterInfo &TRI) {
+  MachineFunction &MF = *MBB.getParent();
+  const MachineRegisterInfo &MRI = MF.getRegInfo();
+  const auto Body = make_range(Begin, End);
+
+  // As the MachineOutliner does for an outlined call (MachineOutliner.cpp).
+  SmallSetVector<Register, 16> Uses, Defs;
+  for (const MachineInstr &MI : reverse(Body)) {
+    if (MI.isDebugInstr())
+      continue;
+    SmallSet<Register, 4> InstrUses;
+    for (const MachineOperand &MO : MI.operands()) {
+      if (!MO.isReg() || !MO.getReg() || MRI.isReserved(MO.getReg()))
+        continue;
+      if (MO.isDef()) {
+        Defs.insert(MO.getReg());
+        if (!InstrUses.count(MO.getReg()))
+          Uses.remove(MO.getReg());
+      } else if (!MO.isUndef()) {
+        Uses.insert(MO.getReg());
+        InstrUses.insert(MO.getReg());
+      }
+    }
+  }
+  uint32_t *Mask = nullptr;
+  const unsigned MaskSize = MachineOperand::getRegMaskSize(TRI.getNumRegs());
+  for (const MachineInstr &MI : Body)
+    for (const MachineOperand &MO : MI.operands())
+      if (MO.isRegMask()) {
+        if (!Mask) {
+          Mask = MF.allocateRegMask();
+          std::fill_n(Mask, MaskSize, ~0u);
+        }
+        for (unsigned I = 0; I != MaskSize; ++I)
+          Mask[I] &= MO.getRegMask()[I];
+      }
+
+  for (MachineInstr &MI : make_early_inc_range(Body)) {
+    if (MI.shouldUpdateAdditionalCallInfo())
+      MF.eraseAdditionalCallInfo(&MI);
+    MI.eraseFromParent();
+  }
+  MachineInstr *Call =
+      TII.insertDeduBBCallReturnStub(MBB, End, Sym, WithCalls, EmitCFI);
+  if (Mask)
+    Call->addOperand(MachineOperand::CreateRegMask(Mask));
+  for (Register Reg : Defs)
+    Call->addOperand(MachineOperand::CreateReg(Reg, /*isDef=*/true,
+                                               /*isImp=*/true));
+  for (Register Reg : Uses)
+    Call->addOperand(MachineOperand::CreateReg(Reg, /*isDef=*/false,
+                                               /*isImp=*/true));
+}
+
+static std::string getMasterSymbol(const DeduBBDirectives::Directive &D);
+
+//===----------------------------------------------------------------------===//
+// Ranges: directives with `at=`.
+//===----------------------------------------------------------------------===//
+
+// Collects the instructions of \p MBB that emit code, in order, which is how
+// `at=` and `block_insts=` count. Returns false if one of them may not emit
+// exactly one machine instruction (isDeduBBSingleInstruction), so that the
+// count could be off: a bundle, inline asm, or a pseudo that is lowered into
+// code of its own, such as a thread-local access or a check.
+static bool collectInstructions(MachineBasicBlock &MBB,
+                                SmallVectorImpl<MachineInstr *> &Insts,
+                                const TargetInstrInfo &TII) {
+  for (MachineInstr &MI : MBB) {
+    if (MI.isBundle() || MI.isBundled())
+      return false;
+    if (MI.isMetaInstruction())
+      continue;
+    if (MI.isInlineAsm() || !TII.isDeduBBSingleInstruction(MI))
+      return false;
+    Insts.push_back(&MI);
+  }
+  return true;
+}
+
+namespace {
+// A run that passed its checks.
+struct RunFold {
+  const DeduBBDirectives::Directive *D;
+  MachineInstr *First; // Its first and last instructions that emit code.
+  MachineInstr *Last;
+  bool SaveJump; // A Save-and-Jump run, else a Call-Return one.
+  bool WithCalls;
+  bool EmitCFI;
+};
+} // namespace
+
+static bool isSaveJump(const DeduBBDirectives::Directive &D) {
+  return D.K == DeduBBDirectives::MasterSaveJump ||
+         D.K == DeduBBDirectives::FoldSaveJump;
+}
+
+// Decides whether a Save-and-Jump master can run \p MI, an instruction that
+// emits code. The master runs it at another address but in the block's own
+// frame, between the stub's `lea 1f(%rip), Link; jmp` and its own
+// `jmp *Link`. So \p MI must be emitted as one plain instruction with no
+// operand the linker fills in, must not call or branch, and must not touch the
+// link register \p Link or a register of getDeduBBCallReturnForbiddenRegs,
+// except that it may read the stack pointer \p SP: the stack is where it was.
+static bool isSaveJumpMovable(const MachineInstr &MI,
+                              const TargetInstrInfo &TII,
+                              const TargetRegisterInfo &TRI, MCRegister Link,
+                              Register SP) {
+  if (MI.isCall() || MI.isBranch() || MI.isIndirectBranch() || MI.isReturn() ||
+      MI.isTerminator() || MI.isInlineAsm() || MI.getPreInstrSymbol() ||
+      MI.getPostInstrSymbol() || !TII.isDeduBBSingleInstruction(MI))
+    return false;
+  const ArrayRef<MCPhysReg> Forbidden = TII.getDeduBBCallReturnForbiddenRegs();
+  // Whether \p MI may not read (or with \p Def, write) \p Reg.
+  const auto Banned = [&](Register Reg, bool Def) {
+    if (TRI.regsOverlap(Reg, Link))
+      return true;
+    for (MCPhysReg F : Forbidden)
+      if (TRI.regsOverlap(Reg, F) && (Def || !TRI.regsOverlap(F, SP)))
+        return true;
+    return false;
+  };
+  for (const MachineOperand &MO : MI.operands()) {
+    switch (MO.getType()) {
+    case MachineOperand::MO_Register:
+      if (!MO.getReg())
+        break;
+      if (!MO.getReg().isPhysical() || Banned(MO.getReg(), MO.isDef()))
+        return false;
+      break;
+    case MachineOperand::MO_Immediate:
+    case MachineOperand::MO_CImmediate:
+    case MachineOperand::MO_FPImmediate:
+      break;
+    default:
+      // A symbol, block, constant pool, jump table or register mask.
+      return false;
+    }
+  }
+  // Instructions built without their implicit operands.
+  const MCInstrDesc &Desc = MI.getDesc();
+  return none_of(Desc.implicit_uses(),
+                 [&](MCPhysReg R) { return Banned(R, /*Def=*/false); }) &&
+         none_of(Desc.implicit_defs(),
+                 [&](MCPhysReg R) { return Banned(R, /*Def=*/true); });
+}
+
+// The checks on \p MF for Save-and-Jump ranges: a link register, the
+// conditions of a Call-Return stub's call (supportsDeduBBCallReturn), and no
+// indirect branch tracking, since the master returns with an indirect jump.
+static bool supportsSaveJumpRanges(const MachineFunction &MF,
+                                   const TargetInstrInfo &TII) {
+  return TII.getDeduBBLinkRegister().isValid() &&
+         TII.supportsDeduBBCallReturn(MF) &&
+         !DeduBBDirectives::hasIndirectBranchTracking(
+             *MF.getFunction().getParent());
+}
+
+// Finds the ending of \p MBB that tail-call range \p D covers, its last
+// `block_insts - at` instructions that emit code, and checks that they are
+// what Step 1 compared: each is emitted as one machine instruction, nothing
+// among them is a label or inline asm, none but the last is a call (unwinding
+// through a call in a shared ending would use the rules of the master's
+// function for the frame of the block that jumped there), and they reference
+// no symbol but the target of a final tail call, which \p D lists, and
+// link-time constants (isDeduBBLinkTimeConstant). The block must end there,
+// with no successor, and must not be an EH pad. If every instruction of the
+// block can be counted, there must be `block_insts` of them. Returns the
+// first instruction of the ending, or null and why in \p Why.
+static MachineInstr *findTailEnding(MachineBasicBlock &MBB,
+                                    const DeduBBDirectives::Directive &D,
+                                    const TargetInstrInfo &TII,
+                                    std::string *Why = nullptr) {
+  const auto Fail = [Why](const Twine &Reason) -> MachineInstr * {
+    if (Why)
+      *Why = Reason.str();
+    return nullptr;
+  };
+  if (MBB.isEHPad())
+    return Fail("it is an EH pad");
+  if (!MBB.succ_empty())
+    return Fail("it has successors");
+  const unsigned N = D.BlockInsts - D.At;
+  SmallVector<MachineInstr *, 8> Ending;
+  for (auto It = MBB.rbegin(); It != MBB.rend() && Ending.size() < N; ++It) {
+    MachineInstr &MI = *It;
+    if (MI.isBundle() || MI.isBundled() || MI.isInlineAsm() || MI.isLabel())
+      return Fail("they hold a label, a bundle or inline asm");
+    if (MI.isMetaInstruction())
+      continue;
+    if (!TII.isDeduBBSingleInstruction(MI))
+      return Fail("they hold " + TII.getName(MI.getOpcode()) +
+                  ", which is not one machine instruction");
+    Ending.push_back(&MI);
+  }
+  if (Ending.size() != N)
+    return Fail("it has only " + Twine(Ending.size()) + " instructions");
+  SmallVector<MachineInstr *, 32> Insts;
+  if (collectInstructions(MBB, Insts, TII) && Insts.size() != D.BlockInsts)
+    return Fail("it has " + Twine(Insts.size()) + " instructions, not " +
+                Twine(D.BlockInsts));
+  SmallVector<std::string, 4> Callees;
+  for (const MachineInstr *MI : reverse(Ending)) {
+    if (MI->isCall() && MI != Ending.front())
+      return Fail("they hold a call, " + TII.getName(MI->getOpcode()));
+    for (const MachineOperand &MO : MI->operands()) {
+      if (MO.isCPI() || MO.isJTI() || MO.isBlockAddress() ||
+          MO.isTargetIndex() || MO.isMBB())
+        return Fail(TII.getName(MI->getOpcode()) +
+                    " references a block, constant or jump table");
+      if (MO.isGlobal() || MO.isSymbol() || MO.isMCSymbol()) {
+        if (MI->isCall() && MO.getOffset() == 0)
+          Callees.push_back(DeduBBDirectives::getCalleeName(MO));
+        else if (MI->isCall() || !TII.isDeduBBLinkTimeConstant(MO))
+          return Fail(TII.getName(MI->getOpcode()) +
+                      " references a symbol that is not its callee");
+      }
+    }
+  }
+  if (!DeduBBDirectives::calleesMatch(D.Callees, Callees))
+    return Fail("they call other functions");
+  return Ending.back();
+}
+
+// Checks the runs \p Runs of \p MBB, its Call-Return and Save-and-Jump range
+// directives, and adds those that pass to \p Folds, in order. A run must end
+// before instruction \p End, where an ending that a tail-call directive keeps
+// or folds starts.
+static void checkRuns(MachineBasicBlock &MBB,
+                      SmallVectorImpl<const DeduBBDirectives::Directive *> &Runs,
+                      unsigned End, const TargetInstrInfo &TII,
+                      const TargetRegisterInfo &TRI,
+                      SmallVectorImpl<RunFold> &Folds) {
+  const MachineFunction &MF = *MBB.getParent();
+  if (MBB.isEHPad() || MBB.isEHScopeEntry() || MBB.isEHFuncletEntry() ||
+      TII.getDeduBBCallReturnForbiddenRegs().empty()) {
+    NumCRSkipNotReplaceable += Runs.size();
+    return;
+  }
+  SmallVector<MachineInstr *, 32> Insts;
+  if (!collectInstructions(MBB, Insts, TII)) {
+    NumCRSkipBlockCount += Runs.size();
+    return;
+  }
+  // The position of each instruction in the block, meta instructions included,
+  // and that of the last frame setup instruction: a run starts after it.
+  DenseMap<const MachineInstr *, unsigned> Position;
+  unsigned LastSetup = 0;
+  bool HasSetup = false;
+  for (const MachineInstr &MI : MBB) {
+    const unsigned P = Position.size();
+    Position[&MI] = P;
+    if (MI.getFlag(MachineInstr::FrameSetup)) {
+      LastSetup = P;
+      HasSetup = true;
+    }
+  }
+  // A Save-and-Jump run needs a function that allows them, a block whose
+  // successors can all move to the run's return point (no landing pad), and
+  // the link register free where the run starts.
+  const MCRegister Link = TII.getDeduBBLinkRegister();
+  const bool SaveJumpSite =
+      supportsSaveJumpRanges(MF, TII) &&
+      none_of(MBB.successors(),
+              [](const MachineBasicBlock *S) { return S->isEHPad(); });
+  SmallPtrSet<const MachineInstr *, 8> LinkLiveBefore;
+  if (SaveJumpSite && any_of(Runs, [](const DeduBBDirectives::Directive *D) {
+        return isSaveJump(*D);
+      })) {
+    LivePhysRegs Live(TRI);
+    Live.addLiveOuts(MBB);
+    for (const MachineInstr &MI : reverse(MBB)) {
+      if (MI.isDebugInstr())
+        continue;
+      Live.stepBackward(MI);
+      if (!Live.available(MF.getRegInfo(), Link))
+        LinkLiveBefore.insert(&MI);
+    }
+  }
+  const Register SP =
+      MF.getSubtarget().getTargetLowering()->getStackPointerRegisterToSaveRestore();
+
+  llvm::sort(Runs, [](const DeduBBDirectives::Directive *A,
+                      const DeduBBDirectives::Directive *B) {
+    return A->At < B->At;
+  });
+  unsigned FreeFrom = 0; // The first instruction after the last run kept.
+  for (const DeduBBDirectives::Directive *D : Runs) {
+    const bool SaveJump = isSaveJump(*D);
+    if (Insts.size() != D->BlockInsts) {
+      ++(SaveJump ? NumSJRangeSkipBlockCount : NumCRSkipBlockCount);
+      continue;
+    }
+    if (D->NumInsts == 0 || D->At < FreeFrom ||
+        uint64_t(D->At) + D->NumInsts > std::min<uint64_t>(End, Insts.size())) {
+      ++(SaveJump ? NumSJRangeSkipConflict : NumCRSkipConflict);
+      continue;
+    }
+    MachineInstr *First = Insts[D->At];
+    MachineInstr *Last = Insts[D->At + D->NumInsts - 1];
+    // Between the instructions a master runs, nothing whose place matters:
+    // CFI, labels, frame setup or teardown.
+    bool Replaceable = !(HasSetup && LastSetup >= Position[First]);
+    for (MachineInstr &MI :
+         make_range(First->getIterator(), std::next(Last->getIterator())))
+      if (MI.isCFIInstruction() || MI.isLabel() ||
+          MI.getFlag(MachineInstr::FrameSetup) ||
+          MI.getFlag(MachineInstr::FrameDestroy) ||
+          MI.getOpcode() == TargetOpcode::RELOC_NONE ||
+          MI.getOpcode() == TargetOpcode::JUMP_TABLE_DEBUG_INFO)
+        Replaceable = false;
+    if (!Replaceable) {
+      ++(SaveJump ? NumSJRangeSkipNotReplaceable : NumCRSkipNotReplaceable);
+      continue;
+    }
+
+    if (SaveJump) {
+      if (!SaveJumpSite) {
+        ++NumSJRangeSkipSite;
+        continue;
+      }
+      if (!all_of(make_range(First->getIterator(),
+                             std::next(Last->getIterator())),
+                  [&](const MachineInstr &MI) {
+                    return MI.isMetaInstruction() ||
+                           isSaveJumpMovable(MI, TII, TRI, Link, SP);
+                  })) {
+        ++NumSJRangeSkipIneligible;
+        continue;
+      }
+      if (LinkLiveBefore.contains(First)) {
+        ++NumSJRangeSkipLinkRegLive;
+        continue;
+      }
+      Folds.push_back({D, First, Last, /*SaveJump=*/true, false, false});
+      FreeFrom = D->At + D->NumInsts;
+      continue;
+    }
+
+    // The instructions a Call-Return master runs, as for a body (checkBody).
+    bool Movable = true;
+    SmallVector<std::string, 4> Callees;
+    for (MachineInstr &MI :
+         make_range(First->getIterator(), std::next(Last->getIterator()))) {
+      if (MI.isMetaInstruction())
+        continue;
+      if (!isMovable(MI, TII, TRI, Callees)) {
+        Movable = false;
+        break;
+      }
+    }
+    if (!Movable) {
+      ++NumCRSkipIneligible;
+      continue;
+    }
+    if (!DeduBBDirectives::calleesMatch(D->Callees, Callees)) {
+      ++NumCRSkipCalleeMismatch;
+      continue;
+    }
+    const bool WithCalls = !Callees.empty();
+    bool EmitCFI = false;
+    Site S = checkFunction(MF, TII);
+    if (S == Site::OK)
+      S = checkCalls(MF, WithCalls, EmitCFI);
+    switch (S) {
+    case Site::OK:
+      Folds.push_back({D, First, Last, /*SaveJump=*/false, WithCalls, EmitCFI});
+      FreeFrom = D->At + D->NumInsts;
+      break;
+    case Site::ABI:
+      ++NumCRSkipABI;
+      break;
+    case Site::RedZone:
+      ++NumCRSkipRedZone;
+      break;
+    case Site::ReturnsTwice:
+      ++NumCRSkipReturnsTwice;
+      break;
+    case Site::NotReplaceable:
+      ++NumCRSkipNotReplaceable;
+      break;
+    case Site::StackArgs:
+      ++NumCRSkipStackArgs;
+      break;
+    }
+  }
+}
+
+// Replaces Save-and-Jump run \p F of \p MBB with its stub. The block is split
+// after the run, and its successors move to the second half, which the stub
+// passes to the master as the return address:
+//
+//   MBB:  <before the run>        Tail:  <after the run>
+//         lea Tail(%rip), Link
+//         jmp DeduBB.master.sj.K
+static void applySaveJumpRun(MachineBasicBlock &MBB, const RunFold &F,
+                             const TargetInstrInfo &TII) {
+  MachineFunction &MF = *MBB.getParent();
+  MachineBasicBlock *Tail = MF.CreateMachineBasicBlock();
+  MF.insert(std::next(MBB.getIterator()), Tail);
+  Tail->splice(Tail->end(), &MBB, std::next(F.Last->getIterator()), MBB.end());
+  Tail->transferSuccessors(&MBB);
+  MBB.addSuccessor(Tail); // Reached again through the master.
+  MBB.erase(F.First->getIterator(), MBB.end());
+  TII.insertDeduBBLoadReturnAddress(MBB, *Tail, TII.getDeduBBLinkRegister());
+  TII.insertDeduBBTailBranch(MBB, getMasterSymbol(*F.D));
+  Tail->setLabelMustBeEmitted();
+  LivePhysRegs LiveRegs;
+  computeAndAddLiveIns(LiveRegs, *Tail);
+  ++NumSJRangeFolds;
+}
+
+// Applies the range directives \p Ds of \p MBB: the labels of the tail-call
+// endings it keeps for other blocks, the fold of its own ending, and its
+// runs, those that pass their checks. Blocks elsewhere jump into a master's
+// ending, so it must be found; anything else that does not check out is left
+// as is.
+static void applyRanges(MachineBasicBlock &MBB,
+                        ArrayRef<const DeduBBDirectives::Directive *> Ds,
+                        const TargetInstrInfo &TII,
+                        const TargetRegisterInfo &TRI) {
+  MachineFunction &MF = *MBB.getParent();
+  SmallVector<std::pair<MachineInstr *, const DeduBBDirectives::Directive *>,
+              2>
+      Labels;
+  const DeduBBDirectives::Directive *TailFold = nullptr;
+  SmallVector<const DeduBBDirectives::Directive *, 4> Runs;
+  unsigned End = std::numeric_limits<unsigned>::max();
+  for (const DeduBBDirectives::Directive *D : Ds) {
+    if (D->K == DeduBBDirectives::Master) {
+      std::string Why;
+      MachineInstr *First = findTailEnding(MBB, *D, TII, &Why);
+      if (!First)
+        report_fatal_error(
+            "DeduBB: block " + Twine(MBB.getBBID()->BaseID) + " of " +
+                MF.getName() + " does not end in the " +
+                Twine(D->BlockInsts - D->At) +
+                " instructions that tail-call master " + getMasterSymbol(*D) +
+                " shares (" + Why +
+                "); the directives must come from a build of the same "
+                "sources with the same compiler and flags",
+            /*gen_crash_diag=*/false);
+      Labels.push_back({First, D});
+      End = std::min(End, D->At);
+    } else if (D->K == DeduBBDirectives::Fold) {
+      if (TailFold)
+        ++NumTCRangeSkipConflict;
+      else
+        TailFold = D;
+    } else {
+      Runs.push_back(D);
+    }
+  }
+  MachineInstr *FoldFirst = nullptr;
+  if (TailFold) {
+    SmallVector<MachineInstr *, 32> Insts;
+    if (!Labels.empty()) {
+      ++NumTCRangeSkipConflict; // A master keeps its ending.
+    } else if (!collectInstructions(MBB, Insts, TII) ||
+               !(FoldFirst = findTailEnding(MBB, *TailFold, TII))) {
+      ++NumTCRangeSkipMismatch;
+    } else {
+      End = TailFold->At;
+    }
+  }
+  SmallVector<RunFold, 4> Folds;
+  if (!Runs.empty())
+    checkRuns(MBB, Runs, End, TII, TRI, Folds);
+
+  // The block's ending first, then its runs from the last: each change leaves
+  // the instructions before it where they are.
+  for (auto [First, D] : Labels) {
+    // The AsmPrinter makes `DeduBB.master.*` labels global and hidden.
+    BuildMI(MBB, First->getIterator(), DebugLoc(),
+            TII.get(TargetOpcode::ANNOTATION_LABEL))
+        .addSym(MF.getContext().getOrCreateSymbol(getMasterSymbol(*D)));
+    ++NumTCRangeMasters;
+  }
+  if (FoldFirst) {
+    for (MachineInstr &MI : make_early_inc_range(
+             make_range(MachineBasicBlock::iterator(FoldFirst), MBB.end()))) {
+      if (MI.shouldUpdateAdditionalCallInfo())
+        MF.eraseAdditionalCallInfo(&MI);
+      MI.eraseFromParent();
+    }
+    TII.insertDeduBBTailBranch(MBB, getMasterSymbol(*TailFold));
+    ++NumTCRangeFolds;
+  }
+  for (const RunFold &F : reverse(Folds)) {
+    if (F.SaveJump) {
+      applySaveJumpRun(MBB, F, TII);
+      continue;
+    }
+    replaceWithStub(MBB, F.First->getIterator(),
+                    std::next(F.Last->getIterator()), getMasterSymbol(*F.D),
+                    F.WithCalls, F.EmitCFI, TII, TRI);
+    ++NumCRRangeFolds;
+    if (F.WithCalls)
+      ++NumCR1Folds;
+    else
+      ++NumCR0Folds;
+  }
+}
+
+//===----------------------------------------------------------------------===//
+// The pass.
+//===----------------------------------------------------------------------===//
+
+namespace {
+class DeduBBCallReturn : public ModulePass {
+public:
+  static char ID;
+  DeduBBCallReturn() : ModulePass(ID) {
+    initializeDeduBBCallReturnPass(*PassRegistry::getPassRegistry());
+  }
+  StringRef getPassName() const override {
+    return "DeduBB ranges and Call-Return folds";
+  }
+  void getAnalysisUsage(AnalysisUsage &AU) const override {
+    AU.addRequired<MachineModuleInfoWrapperPass>();
+    AU.addPreserved<MachineModuleInfoWrapperPass>();
+    AU.setPreservesAll();
+    ModulePass::getAnalysisUsage(AU);
+  }
+  bool runOnModule(Module &M) override;
+
+private:
+  MachineFunction &getMasters(Module &M, const MachineFunction &Parent,
+                              bool SaveJump);
+  void emitMaster(Module &M, MachineFunction &Masters,
+                  const DeduBBDirectives::Directive &D);
+  void emitSaveJumpMaster(MachineFunction &Masters,
+                          const DeduBBDirectives::Directive &D);
+
+  // The functions holding the masters, by kind (Save-and-Jump or not) and
+  // target attributes.
+  std::map<std::tuple<bool, std::string, std::string, std::string, bool>,
+           MachineFunction *>
+      MastersByAttrs;
+};
+} // namespace
+
+char DeduBBCallReturn::ID = 0;
+INITIALIZE_PASS_BEGIN(DeduBBCallReturn, "dedubb-call-return",
+                      "DeduBB ranges and Call-Return folds", false, false)
+INITIALIZE_PASS_DEPENDENCY(MachineModuleInfoWrapperPass)
+INITIALIZE_PASS_END(DeduBBCallReturn, "dedubb-call-return",
+                    "DeduBB ranges and Call-Return folds", false, false)
+
+ModulePass *llvm::createDeduBBCallReturnPass() {
+  return new DeduBBCallReturn();
+}
+
+static std::string getMasterSymbol(const DeduBBDirectives::Directive &D) {
+  StringRef Prefix = "DeduBB.master.cr.";
+  if (D.K == DeduBBDirectives::Master || D.K == DeduBBDirectives::Fold)
+    Prefix = "DeduBB.master.";
+  else if (isSaveJump(D))
+    Prefix = "DeduBB.master.sj.";
+  return (Prefix + Twine(D.MasterID)).str();
+}
+
+// Returns the function that holds the masters taken from \p Parent, created
+// the way the MachineOutliner creates outlined functions. It takes \p Parent's
+// target attributes, so that it is compiled for the same subtarget.
+// Call-Return masters (`DeduBB.cr.masters`) get unwind info: exceptions thrown
+// by their calls unwind through them, with %rsp 8 bytes below the return
+// address as in any function. Save-and-Jump masters (`DeduBB.sj.masters`) run
+// in the frames of the blocks they were taken from, which no rule of their
+// own describes, and make no call, so they get none.
+MachineFunction &DeduBBCallReturn::getMasters(Module &M,
+                                              const MachineFunction &Parent,
+                                              bool SaveJump) {
+  const Function &PF = Parent.getFunction();
+  const TargetInstrInfo &TII = *Parent.getSubtarget().getInstrInfo();
+  const auto Attr = [&PF](StringRef Kind) {
+    return PF.getFnAttribute(Kind).getValueAsString().str();
+  };
+  const std::string CPU = Attr("target-cpu"), TuneCPU = Attr("tune-cpu");
+  const std::string Features = TII.getDeduBBCallReturnMasterFeatures(
+      PF.getFnAttribute("target-features").getValueAsString());
+  // X86ReturnThunks turns the Call-Return masters' returns into jumps to the
+  // thunk, like every other return of such a function.
+  const bool RetThunk =
+      !SaveJump && PF.hasFnAttribute(Attribute::FnRetThunkExtern);
+
+  MachineFunction *&MF = MastersByAttrs[std::make_tuple(
+      SaveJump, CPU, Features, TuneCPU, RetThunk)];
+  if (!MF) {
+    LLVMContext &C = M.getContext();
+    Function *F = Function::Create(
+        FunctionType::get(Type::getVoidTy(C), false),
+        GlobalValue::InternalLinkage,
+        SaveJump ? "DeduBB.sj.masters" : "DeduBB.cr.masters", M);
+    F->setUnnamedAddr(GlobalValue::UnnamedAddr::Global);
+    // In `.text.dedubb.`, which `ld.lld -z keep-text-section-prefix` gathers
+    // into an output section of its own, apart from the functions.
+    (void)F->setSectionPrefix("dedubb");
+    // No padding between the masters, or in front of them.
+    F->addFnAttr(Attribute::OptimizeForSize);
+    F->addFnAttr(Attribute::MinSize);
+    F->addFnAttr(Attribute::NoInline);
+    if (!CPU.empty())
+      F->addFnAttr("target-cpu", CPU);
+    if (!Features.empty())
+      F->addFnAttr("target-features", Features);
+    if (!TuneCPU.empty())
+      F->addFnAttr("tune-cpu", TuneCPU);
+    if (RetThunk)
+      F->addFnAttr(Attribute::FnRetThunkExtern);
+    // A Call-Return master unwinds as any function; it needs no personality.
+    if (SaveJump)
+      F->addFnAttr(Attribute::NoUnwind);
+    ReturnInst::Create(C, BasicBlock::Create(C, "entry", F));
+
+    MachineModuleInfo &MMI =
+        getAnalysis<MachineModuleInfoWrapperPass>().getMMI();
+    MF = &MMI.getOrCreateMachineFunction(*F);
+    MF->setAlignment(Align(1));
+    MF->getProperties().resetIsSSA();
+    MF->getProperties().setNoPHIs();
+    MF->getProperties().setNoVRegs();
+    MF->getProperties().setTracksLiveness();
+    MF->getRegInfo().freezeReservedRegs();
+  }
+  Function &F = MF->getFunction();
+  if (!SaveJump && PF.getUWTableKind() > F.getUWTableKind())
+    F.setUWTableKind(PF.getUWTableKind());
+  return *MF;
+}
+
+// Appends raw machine code, \p Hex, to \p MBB.
+static void emitBytes(MachineBasicBlock &MBB, StringRef Hex,
+                      const TargetInstrInfo &TII) {
+  std::string Asm = ".byte ";
+  for (size_t I = 0; I < Hex.size(); I += 2) {
+    if (I != 0)
+      Asm += ',';
+    Asm += "0x";
+    Asm += Hex.substr(I, 2);
+  }
+  MachineFunction &MF = *MBB.getParent();
+  BuildMI(MBB, MBB.end(), DebugLoc(), TII.get(TargetOpcode::INLINEASM))
+      .addExternalSymbol(MF.createExternalSymbolName(Asm))
+      .addImm(InlineAsm::Extra_HasSideEffects);
+}
+
+// Returns the function, alias or ifunc that \p M calls \p Name, or null.
+// With \p Local, only one of the module's own local ones; otherwise only one
+// with a name of its own in the program.
+static const GlobalValue *findCallee(const Module &M, StringRef Name,
+                                     bool Local) {
+  for (const std::string &IRName : {Name.str(), "\1" + Name.str()}) {
+    const GlobalValue *G = M.getNamedValue(IRName);
+    if (G && G->hasLocalLinkage() == Local &&
+        (isa<Function>(G) || isa<GlobalAlias>(G) || isa<GlobalIFunc>(G)))
+      return G;
+  }
+  return nullptr;
+}
+
+// Appends the master of \p D to \p Masters: its body's bytes, with a call to
+// each direct callee where the body has one, then a return. A callee is called
+// as the module's own calls reach it, by the first of its names that the
+// module knows: one that names it throughout the program if there is one,
+// since a local function of the module may only share the callee's name (Step
+// 1 refuses names that other symbols in the binary have, but cannot see the
+// functions the linker dropped); else one of the module's local functions. A
+// callee the module does not know (a runtime function the code generator
+// calls) is called by a name the module does not use.
+void DeduBBCallReturn::emitMaster(Module &M, MachineFunction &Masters,
+                                  const DeduBBDirectives::Directive &D) {
+  const TargetInstrInfo &TII = *Masters.getSubtarget().getInstrInfo();
+  MachineBasicBlock *MBB = Masters.CreateMachineBasicBlock();
+  Masters.push_back(MBB);
+  // The AsmPrinter makes `DeduBB.master.*` labels global and hidden.
+  BuildMI(*MBB, MBB->end(), DebugLoc(),
+          TII.get(TargetOpcode::ANNOTATION_LABEL))
+      .addSym(Masters.getContext().getOrCreateSymbol(getMasterSymbol(D)));
+
+  SmallVector<StringRef, 4> Calls, Pieces;
+  if (!D.Callees.empty())
+    StringRef(D.Callees).split(Calls, ',');
+  StringRef(D.Body).split(Pieces, '.');
+  const auto *Call = Calls.begin();
+  for (auto [I, Piece] : enumerate(Pieces)) {
+    if (!Piece.empty())
+      emitBytes(*MBB, Piece, TII);
+    if (I + 1 == Pieces.size())
+      break;
+    // The next direct call (the parser checked that there is one).
+    while (*Call == "*")
+      ++Call;
+    SmallVector<StringRef, 4> Names;
+    (Call++)->split(Names, '|');
+    const GlobalValue *GV = nullptr;
+    for (bool Local : {false, true}) {
+      for (StringRef Name : Names)
+        if ((GV = findCallee(M, Name, Local)))
+          break;
+      if (GV)
+        break;
+    }
+    StringRef Name = Names.front();
+    if (!GV) {
+      // By name: one the module gives nothing else, which would take the
+      // call.
+      const auto *Free = find_if(Names, [&M](StringRef N) {
+        return !M.getNamedValue(N) && !M.getNamedValue(("\1" + N).str());
+      });
+      if (Free == Names.end())
+        report_fatal_error("DeduBB: master " + Twine(getMasterSymbol(D)) +
+                               " cannot call '" + Names.front() +
+                               "': the module holds something else of that "
+                               "name",
+                           /*gen_crash_diag=*/false);
+      Name = *Free;
+    }
+    TII.insertDeduBBCallReturnMasterCall(*MBB, GV, Name);
+  }
+  TII.insertDeduBBCallReturnRet(*MBB);
+  if (!Calls.empty()) {
+    Masters.getFrameInfo().setHasCalls(true);
+    Masters.getFrameInfo().setAdjustsStack(true);
+  }
+  ++NumCRMasters;
+}
+
+// Appends the Save-and-Jump master of \p D to \p Masters: the run's bytes,
+// then a return through the link register.
+void DeduBBCallReturn::emitSaveJumpMaster(
+    MachineFunction &Masters, const DeduBBDirectives::Directive &D) {
+  const TargetInstrInfo &TII = *Masters.getSubtarget().getInstrInfo();
+  const MCRegister Link = TII.getDeduBBLinkRegister();
+  MachineBasicBlock *MBB = Masters.CreateMachineBasicBlock();
+  Masters.push_back(MBB);
+  BuildMI(*MBB, MBB->end(), DebugLoc(),
+          TII.get(TargetOpcode::ANNOTATION_LABEL))
+      .addSym(Masters.getContext().getOrCreateSymbol(getMasterSymbol(D)));
+  emitBytes(*MBB, D.Body, TII);
+  TII.insertDeduBBSaveAndJumpReturn(*MBB, Link);
+  MBB->addLiveIn(Link);
+  ++NumSJRangeMasters;
+}
+
+bool DeduBBCallReturn::runOnModule(Module &M) {
+  const DeduBBDirectives &Directives = DeduBBDirectives::get();
+  if (!Directives.hasRanges())
+    return false;
+  MachineModuleInfo &MMI = getAnalysis<MachineModuleInfoWrapperPass>().getMMI();
+  MastersByAttrs.clear();
+
+  // Collect the work first: the masters' functions are added to the module on
+  // the way.
+  struct Master {
+    MachineFunction *MF;
+    unsigned BBID;
+    const DeduBBDirectives::Directive *D;
+  };
+  struct Item {
+    MachineBasicBlock *MBB;
+    const SmallVector<DeduBBDirectives::Directive, 1> *Ds;
+  };
+  SmallVector<Master, 16> Masters;
+  SmallVector<Item, 16> Items;
+  for (Function &F : M) {
+    MachineFunction *MF = MMI.getMachineFunction(F);
+    if (!MF)
+      continue;
+    const DenseMap<unsigned, SmallVector<DeduBBDirectives::Directive, 1>> *FD =
+        Directives.getRanges(F);
+    if (!FD)
+      continue;
+    // A Call-Return or Save-and-Jump master is emitted wherever its function
+    // is, in block id order, then in range order. (A tail-call master stays
+    // in its block.)
+    size_t First = Masters.size();
+    for (const auto &[BBID, Ds] : *FD)
+      for (const DeduBBDirectives::Directive &D : Ds)
+        if (D.K == DeduBBDirectives::MasterCallReturn ||
+            (D.K == DeduBBDirectives::MasterSaveJump && D.IsRange))
+          Masters.push_back({MF, BBID, &D});
+    std::sort(Masters.begin() + First, Masters.end(),
+              [](const Master &A, const Master &B) {
+                return std::tie(A.BBID, A.D->At) < std::tie(B.BBID, B.D->At);
+              });
+    for (MachineBasicBlock &MBB : *MF) {
+      std::optional<UniqueBBID> ID = MBB.getBBID();
+      // Only original (non-cloned) blocks carry directives.
+      if (!ID || ID->CloneID != 0)
+        continue;
+      auto It = FD->find(ID->BaseID);
+      if (It != FD->end())
+        Items.push_back({&MBB, &It->second});
+    }
+  }
+
+  for (const Master &Mst : Masters) {
+    if (!isSaveJump(*Mst.D)) {
+      emitMaster(M, getMasters(M, *Mst.MF, /*SaveJump=*/false), *Mst.D);
+      continue;
+    }
+    // Emitted whenever the target can: the folds of other modules may need
+    // one that this module's own blocks cannot use.
+    if (Mst.MF->getSubtarget().getInstrInfo()->getDeduBBLinkRegister().isValid())
+      emitSaveJumpMaster(getMasters(M, *Mst.MF, /*SaveJump=*/true), *Mst.D);
+  }
+
+  for (const Item &I : Items) {
+    MachineBasicBlock &MBB = *I.MBB;
+    MachineFunction &MF = *MBB.getParent();
+    const TargetInstrInfo &TII = *MF.getSubtarget().getInstrInfo();
+    const TargetRegisterInfo &TRI = *MF.getSubtarget().getRegisterInfo();
+    const SmallVector<DeduBBDirectives::Directive, 1> &Ds = *I.Ds;
+    SmallVector<const DeduBBDirectives::Directive *, 4> Ranges, TailMasters;
+    for (const DeduBBDirectives::Directive &D : Ds) {
+      if (D.IsRange)
+        Ranges.push_back(&D);
+      if (D.K == DeduBBDirectives::Master)
+        TailMasters.push_back(&D);
+    }
+    // A block with a whole-block tail-call or Save-and-Jump directive keeps its
+    // code for that fold, and a block holds ranges or one Call-Return body,
+    // never both. Step 1 writes neither; a tail-call master's labels are still
+    // placed, since other blocks jump to them.
+    if (Directives.lookup(MF.getFunction(), MBB.getBBID()->BaseID) ||
+        (Ranges.size() != Ds.size() && !Ranges.empty())) {
+      NumCRSkipConflict += Ds.size() - TailMasters.size();
+      if (!TailMasters.empty())
+        applyRanges(MBB, TailMasters, TII, TRI);
+      continue;
+    }
+    if (!Ranges.empty()) {
+      applyRanges(MBB, Ranges, TII, TRI);
+      continue;
+    }
+    if (Ds.size() != 1) {
+      NumCRSkipConflict += Ds.size();
+      continue;
+    }
+    const DeduBBDirectives::Directive &D = Ds.front();
+    const BodyInfo Body = checkBody(MBB, D, TII, TRI);
+    switch (Body.Result) {
+    case BodyInfo::OK:
+      break;
+    case BodyInfo::Ineligible:
+      ++NumCRSkipIneligible;
+      continue;
+    case BodyInfo::Mismatch:
+      ++NumCRSkipMismatch;
+      continue;
+    case BodyInfo::CalleeMismatch:
+      ++NumCRSkipCalleeMismatch;
+      continue;
+    }
+    const bool WithCalls = !Body.Callees.empty();
+    bool EmitCFI = false;
+    switch (checkSite(MBB, WithCalls, TII, EmitCFI)) {
+    case Site::OK:
+      replaceWithStub(MBB, MBB.begin(), MBB.getFirstTerminator(),
+                      getMasterSymbol(D), WithCalls, EmitCFI, TII, TRI);
+      if (WithCalls)
+        ++NumCR1Folds;
+      else
+        ++NumCR0Folds;
+      break;
+    case Site::ABI:
+      ++NumCRSkipABI;
+      break;
+    case Site::RedZone:
+      ++NumCRSkipRedZone;
+      break;
+    case Site::ReturnsTwice:
+      ++NumCRSkipReturnsTwice;
+      break;
+    case Site::NotReplaceable:
+      ++NumCRSkipNotReplaceable;
+      break;
+    case Site::StackArgs:
+      ++NumCRSkipStackArgs;
+      break;
+    }
+  }
+  return !Masters.empty() || !Items.empty();
+}
