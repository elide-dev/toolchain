diff --git a/llvm/lib/DebugInfo/DWARF/DWARFVerifier.cpp b/llvm/lib/DebugInfo/DWARF/DWARFVerifier.cpp
index 2f4d058..a11f0ab 100644
--- a/llvm/lib/DebugInfo/DWARF/DWARFVerifier.cpp
+++ b/llvm/lib/DebugInfo/DWARF/DWARFVerifier.cpp
@@ -2346,9 +2346,9 @@ bool DWARFVerifier::verifyDebugStrOffsets(
          ++Index) {
       uint64_t OffOff = C.tell();
       uint64_t StrOff = DA.getAddress(C);
-      // check StrOff refers to the start of a string
-      if (StrOff == 0)
-        continue;
+      // Strings can be suffix-merged by the linker (e.g. "int" within
+      // "unsigned int"). An offset need not follow a null character, but
+      // must be in bounds and refer to a null-terminated string.
       if (StrData.size() <= StrOff) {
         ErrorCategory.Report(
             "String offset out of bounds of string section", [&]() {
@@ -2359,16 +2359,16 @@ bool DWARFVerifier::verifyDebugStrOffsets(
                   SectionName, StartOffset, Index, OffOff, StrOff,
                   StrData.size());
             });
+        Success = false;
         continue;
       }
-      if (StrData[StrOff - 1] == '\0')
+      if (StrData.find('\0', StrOff) != StringRef::npos)
         continue;
       ErrorCategory.Report(
-          "Section contribution contains invalid string offset", [&]() {
+          "Section contribution contains unterminated string", [&]() {
             error() << formatv(
                 "{0}: contribution {1:X}: index {2:X}: invalid string "
-                "offset *{3:X} == {4:X}, is neither zero nor "
-                "immediately following a null character\n",
+                "offset *{3:X} == {4:X}, string is not null-terminated\n",
                 SectionName, StartOffset, Index, OffOff, StrOff);
           });
       Success = false;
