diff --git a/llvm/test/tools/llvm-dwarfdump/X86/verify_tail_merged_str_offsets.yaml b/llvm/test/tools/llvm-dwarfdump/X86/verify_tail_merged_str_offsets.yaml
new file mode 100644
index 0000000..bd28ca4
--- /dev/null
+++ b/llvm/test/tools/llvm-dwarfdump/X86/verify_tail_merged_str_offsets.yaml
@@ -0,0 +1,50 @@
+# RUN: rm -rf %t && split-file %s %t
+# RUN: yaml2obj %t/v5.yaml -o %t/v5.o
+# RUN: llvm-dwarfdump --verify %t/v5.o | FileCheck %s
+# RUN: yaml2obj %t/v4.yaml -o %t/v4.o
+# RUN: llvm-dwarfdump --verify %t/v4.o | FileCheck %s
+# CHECK: No errors.
+# String references into a suffix are valid. Include an empty-string reference,
+# the complete string, and "int" in "unsigned int", for both DWARF32/64 tables
+# and the headerless GNU split DWARF4 table.
+
+#--- v5.yaml
+--- !ELF
+FileHeader:
+  Class: ELFCLASS64
+  Data: ELFDATA2LSB
+  Type: ET_EXEC
+DWARF:
+  debug_str: ["unsigned int"]
+  debug_str_offsets:
+    - Offsets: [0, 9, 12]
+    - Format: DWARF64
+      Offsets: [0, 9, 12]
+
+Sections:
+  - Name: .debug_abbrev
+    Type: SHT_PROGBITS
+    Content: "011100000000"
+  - Name: .debug_info
+    Type: SHT_PROGBITS
+    Content: "09000000050001080000000001"
+
+#--- v4.yaml
+--- !ELF
+FileHeader:
+  Class: ELFCLASS64
+  Data: ELFDATA2LSB
+  Type: ET_EXEC
+Sections:
+  - Name: .debug_info.dwo
+    Type: SHT_PROGBITS
+    Content: "080000000400000000000401"
+  - Name: .debug_abbrev.dwo
+    Type: SHT_PROGBITS
+    Content: "011100000000"
+  - Name: .debug_str_offsets.dwo
+    Type: SHT_PROGBITS
+    Content: "00000000090000000C000000"
+  - Name: .debug_str.dwo
+    Type: SHT_PROGBITS
+    Content: "756E7369676E656420696E7400"
