@@ -92,11 +92,28 @@ static std::vector<Desc> getOpDescriptions() {
   Descriptions[DW_OP_addrx] = Desc(Op::Dwarf5, Op::SizeLEB);
   Descriptions[DW_OP_constx] = Desc(Op::Dwarf5, Op::SizeLEB);
   Descriptions[DW_OP_entry_value] = Desc(Op::Dwarf5, Op::SizeLEB);
+  Descriptions[DW_OP_const_type] =
+      Desc(Op::Dwarf5, Op::BaseTypeRef, Op::Size1, Op::SizeBlock);
+  Descriptions[DW_OP_deref_type] = Desc(Op::Dwarf5, Op::Size1, Op::BaseTypeRef);
+  Descriptions[DW_OP_xderef_type] =
+      Desc(Op::Dwarf5, Op::Size1, Op::BaseTypeRef);
+  Descriptions[DW_OP_reinterpret] = Desc(Op::Dwarf5, Op::BaseTypeRef);
   Descriptions[DW_OP_convert] = Desc(Op::Dwarf5, Op::BaseTypeRef);
   Descriptions[DW_OP_regval_type] =
       Desc(Op::Dwarf5, Op::SizeLEB, Op::BaseTypeRef);
   Descriptions[DW_OP_WASM_location] =
       Desc(Op::Dwarf4, Op::SizeLEB, Op::WasmLocationArg);
+  // GNU_uninit shares 0xf0 with APPLE_uninit and takes no operands.
+  Descriptions[DW_OP_APPLE_uninit] = Desc(Op::Dwarf4);
+  Descriptions[DW_OP_GNU_const_type] =
+      Desc(Op::Dwarf4, Op::BaseTypeRef, Op::Size1, Op::SizeBlock);
+  Descriptions[DW_OP_GNU_regval_type] =
+      Desc(Op::Dwarf4, Op::SizeLEB, Op::BaseTypeRef);
+  Descriptions[DW_OP_GNU_deref_type] =
+      Desc(Op::Dwarf4, Op::Size1, Op::BaseTypeRef);
+  Descriptions[DW_OP_GNU_convert] = Desc(Op::Dwarf4, Op::BaseTypeRef);
+  Descriptions[DW_OP_GNU_reinterpret] = Desc(Op::Dwarf4, Op::BaseTypeRef);
+  Descriptions[DW_OP_GNU_parameter_ref] = Desc(Op::Dwarf4, Op::Size4);
   Descriptions[DW_OP_GNU_push_tls_address] = Desc(Op::Dwarf3);
   Descriptions[DW_OP_GNU_addr_index] = Desc(Op::Dwarf4, Op::SizeLEB);
   Descriptions[DW_OP_GNU_const_index] = Desc(Op::Dwarf4, Op::SizeLEB);
