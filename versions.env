# <<< component pins

# Consumer requirements: sqlite-jdbc 3.54.1.0, aws-lc-sys 0.47.0, and an ACCP adapter
# rebuilt against AWS-LC 5.12.0. Elide migration is separate; see
# docs/notes/2026-11-dependency-migration.md and the holds in scripts/bump-submodules.sh.
# libsqlite3elide (component sqlite3elide): SQLite above plus the sqlite-jni shim
# (elide-tools/sqlite-jni jni/sqlite3jni.{c,h}, ISC-style zentus/xerial license) compiled into the
# amalgamation, against the JNI headers of a pinned JDK (GPLv2 + Classpath Exception).
SQLITE_JNI_REV=035e2f5312f93da26b6d919b703f79bd84edb8cc
SQLITE_JNI_C_SHA256=b82ad2b8b14218db430d89f5d8c1b067f164e94198c19033747753eeaafcfba8
