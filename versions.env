LZ4_REV=ebb370ca83af193212df4dcbadcc5d87bc0de2f0
LZ4_VERSION=1.10.0
MIMALLOC_REV=f8401befa675adb13b98decababd7fdc59572477
MIMALLOC_VERSION=3.5.4
MUSL_REV=36e61302bbf50619cd21a2603cc1075ce10e6d14
MUSL_REF=elide-v1.2.5
OPENSSL_REV=af1775b60dfa141a4ad762585052cabeb9f37e9e
OPENSSL_VERSION=4.0.3
SNAPPY_REV=9c28114a38866f6deeaa826db918293bc28ae410
SNAPPY_VERSION=1.3.1
SQLCIPHER_REV=c4b275a47932888216bade83aff2bbc73df0ff85
SQLCIPHER_VERSION=4.19.0
# SQLite release matching the sqlite-jdbc jar Elide ships (org.xerial:sqlite-jdbc 3.53.4.0).
SQLITE_REV=b09c88c14082339b66c7b7158d609a771e64ca69
SQLITE_REF=version-3.53.4
SQLITE_VERSION=3.53.4
# libsqlite3elide (component sqlite3elide): SQLite above plus the sqlite-jni shim
# (elide-tools/sqlite-jni jni/sqlite3jni.{c,h}, ISC-style zentus/xerial license) compiled into the
# amalgamation, against the JNI headers of a pinned JDK (GPLv2 + Classpath Exception).
SQLITE_JNI_REV=f485f7ff3e978995cccf6bdfcce0b33cfacbb6bf
SQLITE_JNI_C_SHA256=17dc894aa3d9072c1b8b7adcb5b51f35df63860fc415b74cc564e992bb31010d
SQLITE_JNI_H_SHA256=37e21f4e786f430fe5082fc5b5fd59526e413b4a667bb26b062d9ecdcb34ac35
JNI_HEADERS_TAG=jdk-25-ga
JNI_H_SHA256=1e03bd83d1662ac00647f7a06c11d32333767ee537803ec1d153e89888414520
JNI_MD_H_SHA256=8232a5a68d36060aaa426fbfdb4537983ecfdfc5fe07a43230005ddd1a4b986a
ZLIB_REV=3944b7d59cf50aa144d8bba69809edea072161d4
