# shellcheck shell=bash disable=SC2034
# Single source of truth for toolchain versions, pins and floors. Sourced by build.sh,
# read by scripts/gen-manifest.py. Component pins are generated by scripts/bump-submodules.sh.

TOOLCHAIN_NAME=elide-toolchain
TOOLCHAIN_VERSION=2026.10.0

# Floors
GLIBC_FLOOR=2.34
GLIBC_BRANCH=release/2.34/master
GLIBC_ENABLE_KERNEL=4.18
MACOS_MIN=12.0

# Code generation (Linux; darwin uses the cflags profile's own -march/-mcpu)
MARCH_AMD64=x86-64-v3
MTUNE_AMD64=znver3
MARCH_ARM64=armv8.2-a+crypto+crc+dotprod
MTUNE_ARM64=generic

# LLVM projects (lldb intentionally excluded; bolt is ELF-only)
LLVM_PROJECTS_LINUX="clang;lld;bolt;polly"
LLVM_PROJECTS_DARWIN="clang;lld;polly"

# Sanitizers (docs/superpowers/specs/2026-10-05-sanitizer-variants-design.md §3). Short names;
# runtimes ship in the main bundle, SANITIZER_VARIANTS get per-sanitizer add-on archives (gnu).
SANITIZERS_LINUX_GNU="asan lsan tsan msan ubsan"
SANITIZERS_LINUX_GNU_AARCH64="hwasan"
SANITIZERS_LINUX_MUSL="ubsan"
SANITIZERS_DARWIN="asan tsan ubsan"
SANITIZER_VARIANTS="asan tsan msan"
LIBFUZZER_LIBCS="gnu darwin"

# Official LLVM release used as the Linux stage-1 (bootstrap) compiler when STAGE1_SOURCE=prebuilt
# (the default where a pin exists). Must be the release of LLVM_VERSION; SHA256 = GitHub's
# published asset digest. Re-pin on every LLVM bump.
LLVM_PREBUILT_LINUX_AMD64_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.2/LLVM-23.1.2-Linux-X64.tar.xz
LLVM_PREBUILT_LINUX_AMD64_SHA256=b5ed9675149cc837c282e9b6962c276c9fa62863d5b2f91537b60848552995b7
LLVM_PREBUILT_LINUX_ARM64_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.2/LLVM-23.1.2-Linux-ARM64.tar.xz
LLVM_PREBUILT_LINUX_ARM64_SHA256=075da47cb832273717d4c7bad4b6b4848d7c154262e9ba0dcc0025426d4073f0
# Both releases' lld are linked against Ubuntu 22.04's ICU 70 (RUNPATH $ORIGIN/../lib). Hosts
# without libicu*.so.70 get these libraries from the pinned jammy package, unpacked into stage1/lib.
LLVM_PREBUILT_LINUX_AMD64_ICU_URL=https://archive.ubuntu.com/ubuntu/pool/main/i/icu/libicu70_70.1-2_amd64.deb
LLVM_PREBUILT_LINUX_AMD64_ICU_SHA256=58a154f6307289813da2276f900498ef536ae7c0522d2cf31a3c3c5cf62dfd9a
LLVM_PREBUILT_LINUX_ARM64_ICU_URL=https://ports.ubuntu.com/ubuntu-ports/pool/main/i/icu/libicu70_70.1-2_arm64.deb
LLVM_PREBUILT_LINUX_ARM64_ICU_SHA256=ac68372cf4a976e6a206858fd9b28c68e49d37d650b9b8653270038a6e7bc174

# libc
MUSL_VERSION=1.2.5

# Linux UAPI headers installed into Linux sysroots (latest longterm at pin time)
LINUX_HEADERS_VERSION=6.18.55
LINUX_HEADERS_SHA256=f410638061a165c12f42ab871d2f3fcd525515359b5faeee80969cff84524df9

# llvm-propeller third-party deps (versions from the pinned propeller's CMake/*; fetched by
# stage 00 into out/cache/propeller-deps, consumed offline by stage 45). Re-read on every
# propeller bump.
PROPELLER_ABSL_VERSION=20260107.1
PROPELLER_ABSL_SHA256=05597c3c532197690a31ebad50a7c9c3fb682d3c5a681b20eb03655ffb4e9483
PROPELLER_PROTOBUF_VERSION=33.4
PROPELLER_PROTOBUF_SHA256=bc670a4e34992c175137ddda24e76562bb928f849d712a0e3c2fb2e19249bea1
PROPELLER_GTEST_VERSION=1.17.0
PROPELLER_GTEST_SHA256=40d4ec942217dcc84a9ebe2a68584ada7d4a33a8ee958755763278ea1c5e18ff
PROPELLER_QUIPPER_REV=f9eb05fcce80189c311a01341bb535a382d5d740
PROPELLER_QUIPPER_SHA256=5c747832c94d358847c3b29c5f837271e40b980f7629a95c618eba3817c77679

# >>> component pins (generated by scripts/bump-submodules.sh)
AWS_LC_REV=fa9bc8d6f7cfb2cf849b247fb06bbbfc41ecc9d6
AWS_LC_VERSION=5.11.0
BROTLI_REV=028fb5a23661f123017c060daa546b55cf4bde29
